diff --git a/tests/conformance/director-unity.test.ts b/tests/conformance/director-unity.test.ts
new file mode 100644
index 0000000..21ece16
--- /dev/null
+++ b/tests/conformance/director-unity.test.ts
@@ -0,0 +1,295 @@
+/**
+ * A director's night on Unity (Unity in the studio, plan §8.1) — through the real core and the
+ * real harness child, against the fakes every lane codes to (contract §3.6): a fake `unity` CLI
+ * (lane A), a fake editor process with a fake Pipeline server (lane C), and the grey-box
+ * fixture project (lane B). No Unity is installed on this Mac and none is needed.
+ *
+ * Three nights: one that proves a build, judges a still and lands; three loop workers on one
+ * queue slot, whose editors never overlap and whose waits are holds, not losses; and a fork
+ * that does not compile, refused by name with no judge call spent.
+ *
+ * The helpers are loaded at run time by name: this file is lane E's, and when a lane's helper
+ * is not in the tree yet each case fails with the sentence naming it, rather than the whole
+ * file failing to load.
+ */
+import assert from "node:assert/strict";
+import { mkdir, readdir, realpath, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { after, before, describe, it } from "node:test";
+import type { CompleteRequest, DelegateRequest, DelegateResult, LiveToolResult } from "../../src/substrate/engines/types.ts";
+import { customEvents, startRig, waitForLog, type Rig } from "../helpers/studio-rig.ts";
+import { tmpDir } from "../helpers/tmp.ts";
+
+const rigs: Rig[] = [];
+after(async () => {
+  await Promise.all(rigs.map((rig) => rig.stop().catch(() => {})));
+});
+
+const text = (result: LiveToolResult): string => (typeof result === "string" ? result : result.text);
+const json = (result: LiveToolResult): Record<string, any> => JSON.parse(text(result));
+
+/** The helpers other lanes ship, by name, so a missing one is a sentence and not a load error. */
+interface Fakes {
+  fakeUnityCli: (dir: string, options?: Record<string, unknown>) => Promise<{ binary: string; calls: () => Promise<string[][]> }>;
+  fakeUnityProbe: (binary: string, options?: Record<string, unknown>) => (binary: string, args: string[]) => Promise<string | null>;
+  fakeUnityEditorBinary: (binary: string) => Promise<string>;
+  fakeEditorInvocations: (projectRoot: string) => Promise<Array<{ start: number; end: number | null; argv: string[]; pid: number }>>;
+  fixture: string;
+}
+let fakes: Fakes | null = null;
+let blocked = "";
+
+before(async () => {
+  const missing: string[] = [];
+  const load = async (rel: string): Promise<Record<string, any> | null> => {
+    try {
+      // A variable specifier: the type checker does not resolve it, and a missing file is a
+      // runtime sentence naming the lane, not a compile error in this lane's file.
+      const specifier = rel;
+      return (await import(specifier)) as Record<string, any>;
+    } catch (err) {
+      missing.push(`${rel} (${String((err as Error)?.message ?? err).split("\n")[0]})`);
+      return null;
+    }
+  };
+  const cli = await load("../helpers/fake-unity-cli.ts");
+  const editor = await load("../helpers/fake-unity-editor.ts");
+  const fixture = path.resolve(import.meta.dirname, "..", "fixtures", "unity", "grey-box");
+  const fixtureThere = await stat(fixture).then((s) => s.isDirectory()).catch(() => false);
+  if (!fixtureThere) missing.push(`tests/fixtures/unity/grey-box (lane B's fixture project)`);
+  if (missing.length) {
+    blocked = `written, blocked on the other lanes' helpers: ${missing.join("; ")}`;
+    return;
+  }
+  fakes = {
+    fakeUnityCli: cli!.fakeUnityCli,
+    fakeUnityProbe: cli!.fakeUnityProbe,
+    fakeUnityEditorBinary: editor!.fakeUnityEditorBinary,
+    fakeEditorInvocations: editor!.fakeEditorInvocations,
+    fixture,
+  };
+});
+
+/** What the fake CLI is told about this Mac: one Unity 6 editor (the fake binary), signed in, licensed. */
+async function unityRig(options: { queueSlots?: number } = {}): Promise<{ rig: Rig; editorBinary: string }> {
+  const f = fakes!;
+  const dir = await tmpDir("unity-night-");
+  const editorBinary = await f.fakeUnityEditorBinary(path.join(dir, "Unity"));
+  const cliOptions = { version: "1.0.0", editors: [{ version: "6000.0.50f1", path: editorBinary }], signedIn: { name: "Fixture", email: "fixture@example.com" }, licence: { kind: "personal", active: true } };
+  const cli = await f.fakeUnityCli(path.join(dir, "cli"), cliOptions);
+  // The fake probe answers for the fake CLI's own path and nothing else, and detection only
+  // ever asks the studio's copy, PATH and Unity Hub's places — so the fake's folder is the PATH.
+  // Detection realpaths the binary it found before asking it anything else, so the fake is
+  // told the realpath (on this Mac /var/folders is /private/var/folders).
+  const real = await realpath(cli.binary);
+  const rig = await startRig({ replies: [] }, { unity: { probe: f.fakeUnityProbe(real, cliOptions), pathEnv: path.dirname(real) } } as never);
+  rigs.push(rig);
+  await rig.core.unityStatus(true);
+  if (options.queueSlots) await rig.core.updateSettings({ unityQueueSlots: options.queueSlots } as never);
+  return { rig, editorBinary };
+}
+
+/** A Unity project in the rig's library: the grey-box fixture, adopted by its own name. */
+async function unityProject(rig: Rig, name: string): Promise<{ name: string; dir: string }> {
+  const project = await rig.core.games.scaffold(name, { title: name, kind: "unity-project" } as never);
+  // The fixture's tree over the scaffold: scenes, the bridge, the spawn registry.
+  const copy = async (from: string, to: string): Promise<void> => {
+    for (const entry of await readdir(from, { withFileTypes: true })) {
+      const src = path.join(from, entry.name);
+      const dst = path.join(to, entry.name);
+      if (entry.isDirectory()) {
+        await mkdir(dst, { recursive: true });
+        await copy(src, dst);
+      } else {
+        const { readFile } = await import("node:fs/promises");
+        await writeFile(dst, await readFile(src));
+      }
+    }
+  };
+  await copy(fakes!.fixture, project.dir);
+  return { name: project.name, dir: project.dir };
+}
+
+/** One fake engine that is the director, its workers and its judge, counting what reached it. */
+function fakeEngine(rig: Rig, delegate: (request: DelegateRequest) => Promise<DelegateResult>) {
+  const completes: CompleteRequest[] = [];
+  rig.core.engines.register({
+    id: "codex",
+    label: "codex",
+    kind: "delegated",
+    status: async () => ({ code: "ready", detail: "" }),
+    models: async () => [],
+    complete: async (request: CompleteRequest) => {
+      completes.push(request);
+      return { message: { role: "assistant", content: '{"answer":"yes","confidence":0.9,"pass":true}' }, usage: {}, model: "fixture", engine: "codex", stopReason: "stop" };
+    },
+    delegate,
+  } as never);
+  return completes;
+}
+
+const planFor = (...ids: string[]): Record<string, unknown> => ({
+  summary: "Tonight: a grey box with a ramp and a collectible.",
+  workers: JSON.stringify(ids.map((id) => ({ id, title: id, seam: `Assets/${id}`, owns: `Assets/${id}/`, done: [`the ${id} is there to see`], minutes: 10 }))),
+  base: "the grey box as it stands",
+  risks: "one editor at a time",
+});
+
+/** A worker that adds a script under its seam — a compile the fake editor accepts. */
+async function workerWrites(request: DelegateRequest, area: string): Promise<void> {
+  await mkdir(path.join(request.cwd, "Assets", area), { recursive: true });
+  await writeFile(path.join(request.cwd, "Assets", area, `${area}.cs`), `using UnityEngine;\npublic class ${area.replace(/[^A-Za-z0-9]/g, "")} : MonoBehaviour { void Start() { } }\n`);
+}
+
+describe("a director's night on Unity", () => {
+  it("proves a build in the editor, judges a still, and lands — never touching the browser pool", async () => {
+    assert.ok(fakes, blocked);
+    const { rig, editorBinary } = await unityRig();
+    const project = await unityProject(rig, "unity-night");
+    const results: Record<string, any> = {};
+    const completes = fakeEngine(rig, async (request) => {
+      if (request.director) {
+        const call = (name: string, args: Record<string, unknown>) => request.onLiveTool!(name, args);
+        results.tools = (request.liveTools ?? []).map((t) => t.name);
+        results.status0 = json(await call("run_status", {}));
+        results.planned = text(await call("plan", planFor("ramp")));
+        results.validated = json(await call("validate", { target: "integration" }));
+        results.started = json(await call("worker_start", { id: "ramp", title: "Ramp", brief: "add a ramp under Assets/ramp", mode: "single", minutes: "5", owns: "Assets/ramp/" }));
+        for (let i = 0; i < 40; i++) {
+          results.waited = json(await call("wait", { seconds: "5", worker: "ramp" }));
+          if (results.waited.status.workers[0]?.state !== "running") break;
+        }
+        results.integrated = json(await call("integrate", { worker: "ramp" }));
+        results.judged = json(await call("judge", { target: "integration", against: "none", question: "is there a ramp?" }));
+        results.finished = text(await call("finish", { summary: "a ramp in the grey box", land: "yes", victory: "yes" }));
+        return { ok: true, engine: "codex", turns: 8, usage: {}, sessionId: "director-unity", summary: "night done" };
+      }
+      results.workerGrant = request.unity ?? null;
+      results.workerPrompt = request.prompt;
+      await workerWrites(request, "ramp");
+      return { ok: true, engine: "codex", turns: 2, usage: {}, sessionId: "worker-unity", summary: "added the ramp" };
+    });
+
+    const runId = rig.core.newRunId();
+    await rig.core.dispatchRun({ runId, goal: "a ramp and a collectible", project: project.name, mode: "autopilot", engine: "codex", reference: { name: "grey box", shots: [] }, budgets: { wallClockMs: 15 * 60_000 } });
+    const events = await waitForLog(rig.core, (log) => customEvents(log, "run_finished").some((e) => e.runId === runId), 240_000, "the Unity night to close");
+
+    const started = customEvents(events, "run_started").find((e) => e.runId === runId)!;
+    assert.equal((started.unity as { editorVersion: string }).editorVersion, "6000.0.50f1", "run_started carries the editor the night opened");
+    assert.equal(rig.preview.loads.length, 0, "preview.load on the browser pool was never called");
+    assert.ok(results.tools.includes("validate"), `the director has validate: ${results.tools.join(", ")}`);
+    assert.ok(results.status0.capacity.validationQueue, JSON.stringify(results.status0.capacity));
+    assert.equal(results.validated.rule, "compiles", JSON.stringify(results.validated));
+    assert.equal(results.started.started, "ramp", JSON.stringify(results.started));
+    assert.ok(results.workerGrant && path.resolve(results.workerGrant.root) === path.resolve(results.started.worktree), "the worker's Unity grant names its own worktree");
+    assert.equal(results.workerGrant.role, "builder");
+    assert.match(results.workerPrompt, /YOU HAVE UNITY — COMPILE, PLAY AND SEE IT/);
+    assert.equal(results.integrated.merged, true, JSON.stringify(results.integrated));
+    assert.equal(results.integrated.health.unity?.compile?.ok, true, JSON.stringify(results.integrated.health));
+    assert.equal(results.judged.ok, true, JSON.stringify(results.judged));
+    assert.ok(results.judged.shots.length >= 1, "the judge photographed a still");
