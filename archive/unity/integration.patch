+      }
+      if (!response.ok || body?.ok === false) {
+        // Measured 2026-09-11: the editor's reason rides in `errorDetails` ("Parameter Validation
+        // Failed" + "No camera found to capture.") — the sentence the stage shows needs both.
+        const details = typeof body?.errorDetails === "string" && body.errorDetails.trim() && body.errorDetails !== body.error ? `: ${body.errorDetails.trim()}` : "";
