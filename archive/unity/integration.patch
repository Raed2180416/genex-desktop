+/**
+ * Ownership on a Unity tree — plan §3.6 and §3.7 (lane D of the Unity work packages).
+ *
+ * The rule exists twice on purpose (`substrate/ownership.ts` for the Edit hook and the Codex
+ * locks, `harness-seed/loop/review.mjs` for the reviewer), so every Unity case here is driven
+ * through both bodies — the discipline `harness-incidents.test.ts` keeps for the three.js cases.
+ * The second half proves what a fork of a Unity project receives: `Library/` as a copy, never a
+ * link, and only where git ignores it.
+ */
+import assert from "node:assert/strict";
+import { execFile } from "node:child_process";
+import { lstat, mkdir, readFile, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { describe, it } from "node:test";
+import { promisify } from "node:util";
+import { allowedFile as reviewAllowedFile, mechanicalReview, reviewDiffArm, reviewSurface } from "../../src/harness-seed/loop/review.mjs";
+import { lockUnowned, neverLocked, releaseLocks } from "../../src/substrate/engines/ownership-locks.ts";
+import { allowedFile as hookAllowedFile, isUnityPath, ownershipReason } from "../../src/substrate/ownership.ts";
+import { SnapshotEngine, cloneDir, git } from "../../src/substrate/snapshots.ts";
+import { tmpDir } from "../helpers/tmp.ts";
+
+const execFileAsync = promisify(execFile);
+
+/** The entry a Unity project names (contract §3.1), and one worker's seam in the two worlds it may build in. */
+const MAIN = "Assets/Studio/StudioSpawn.cs";
+const lighting = { id: "lighting", owns: ["Assets/Lighting/**"], main: MAIN };
+const brought = { ...lighting, template: false };
+const noSeam = { id: "solo", owns: [], main: MAIN, template: false };
+
+/** The paths that belong to whoever owns the entry, beside the entry itself. */
+const ENTRY_OWNED = [
+  "Assets/Scenes/Main.unity",
+  "Assets/Scenes/Levels/One.unity",
+  "ProjectSettings/ProjectSettings.asset",
+  "ProjectSettings/InputManager.asset",
+  "Packages/manifest.json",
+  "Packages/packages-lock.json",
+];
+
+/** Both bodies, one answer — a rule that drifts between them is a worker refused at write time and cleared at review time. */
+function agree(file: string, spec: Record<string, unknown>, ownsMain: boolean, expected: boolean, why: string): void {
+  assert.equal(hookAllowedFile(file, spec as never, ownsMain), expected, `hook: ${file} ownsMain=${ownsMain} — ${why}`);
+  assert.equal(reviewAllowedFile(file, spec as never, ownsMain), expected, `reviewer: ${file} ownsMain=${ownsMain} — ${why}`);
+}
+
+async function writeTree(root: string, files: Record<string, string>): Promise<void> {
+  for (const [rel, text] of Object.entries(files)) {
+    await mkdir(path.dirname(path.join(root, rel)), { recursive: true });
+    await writeFile(path.join(root, rel), text);
+  }
+}
+
+const isWritable = async (file: string): Promise<boolean> => ((await stat(file)).mode & 0o200) !== 0;
+
+describe("the .meta shadow rule", () => {
+  it("a .meta goes wherever the file it shadows goes — the seam, the notes, the entry, and the folder's own", () => {
+    agree("Assets/Lighting/Sun.cs", brought, false, true, "its seam");
+    agree("Assets/Lighting/Sun.cs.meta", brought, false, true, "the seam's .meta");
+    agree("Assets/Lighting/Probes/Volume.asset.meta", brought, false, true, "deep in the seam");
+    agree("Assets/Lighting.meta", brought, false, true, "the seam folder's own .meta");
+    agree("Assets/Sky/Sky.cs.meta", brought, false, false, "another worker's .meta");
+    agree("Assets/Sky.meta", brought, false, false, "another worker's folder");
+    agree("docs/notes/NOTES.lighting.md.meta", brought, false, true, "its notes");
+    agree("docs/notes/NOTES.sky.md.meta", brought, false, false, "somebody else's notes");
+    agree(`${MAIN}.meta`, brought, true, true, "the entry's .meta, for the entry's owner");
+    agree(`${MAIN}.meta`, brought, false, false, "not for a worker in a project the user brought");
+    agree(`${MAIN}.meta`, lighting, false, true, "on the template the wiring pass-through covers the entry's .meta too");
+    agree("Assets/Scenes/Main.unity.meta", brought, true, true, "the scene's .meta goes with the scene");
+    agree("Assets/Scenes/Main.unity.meta", brought, false, false, "and stays with it");
+    // A seam of files, not a folder, does not own the folder's .meta — only what it names.
+    const filesOnly = { ...brought, owns: ["Assets/Lighting/**/*.cs"] };
+    agree("Assets/Lighting/Sun.cs.meta", filesOnly, false, true, "a named file's .meta");
+    agree("Assets/Lighting.meta", filesOnly, false, false, "not the folder's");
+    // The three.js rule is untouched: a .meta on a browser game reads exactly as its sibling.
+    const water = { id: "water", owns: ["src/water.js"] };
+    agree("src/water.js.meta", water, false, true, "as src/water.js");
+    agree("src/sky.js.meta", water, false, false, "as src/sky.js");
+  });
+});
+
+describe("entry-owned Unity paths", () => {
+  it("the scene, the settings and the manifest belong to whoever owns the entry — and to nobody else", () => {
+    for (const file of ENTRY_OWNED) {
+      agree(file, brought, true, true, "the entry's owner, in a brought project");
+      agree(file, brought, false, false, "a worker with a seam, in a brought project");
+      agree(file, lighting, true, true, "the entry's owner, on the template");
+      agree(file, lighting, false, false, "a worker with a seam, on the template");
+      agree(file, noSeam, true, true, "the entry's owner, with no seam");
+      agree(file, noSeam, false, false, "not even a worker with no seam, who gets everything else");
+    }
+    // Everything else stays as the rule always read it.
+    agree("Assets/Lighting/Lighting.unity", brought, false, true, "an additive scene under its own seam is its own");
+    agree("Assets/Sky/Sky.cs", noSeam, false, true, "a worker with no seam has the rest of the tree");
+    agree("Packages/com.aigamestudio.bridge/Runtime/StudioProbes.cs", noSeam, false, true, "an embedded package is not the manifest");
+    agree("Assets/Sky/Sky.cs", brought, false, false, "a worker with a seam has only its seam");
+  });
+
+  it("both bodies agree on a table of Unity paths", () => {
+    const paths = [
+      ...ENTRY_OWNED,
+      ...ENTRY_OWNED.map((file) => `${file}.meta`),
+      MAIN,
+      `${MAIN}.meta`,
+      "Assets/Studio/StudioProbes.cs",
+      "Assets/Studio.meta",
+      "Assets/Lighting/Sun.cs",
+      "Assets/Lighting/Sun.cs.meta",
+      "Assets/Lighting.meta",
+      "Assets/Lighting/Lighting.unity",
+      "Assets/Core/Player.prefab",
+      "Assets/Core/Player.prefab.meta",
+      "Assets/Sky/Sky.cs",
+      "Assets.meta",
+      "Packages/com.aigamestudio.bridge/package.json",
+      "Library/ArtifactDB",
+      "Temp/UnityLockfile",
+      "Assembly-CSharp.csproj",
+      "docs/notes/NOTES.lighting.md",
+      "NOTES.md",
+      ".studio/BRIEF.md",
+      "index.html",
+    ];
+    const specs: Array<{ id: string; owns: string[]; main: string; template?: boolean }> = [
+      lighting,
+      brought,
+      noSeam,
+      { id: "core", owns: ["Assets/Core/**", "Assets/Studio/StudioProbes.cs"], main: MAIN, template: false },
+      { id: "core", owns: ["Assets/Core/**", "Assets/Studio/StudioProbes.cs"], main: MAIN },
+    ];
+    let cases = 0;
+    for (const file of paths) {
+      for (const spec of specs) {
+        for (const ownsMain of [true, false]) {
+          assert.equal(hookAllowedFile(file, spec as never, ownsMain), reviewAllowedFile(file, spec as never, ownsMain), `${file} for ${spec.id} (template ${spec.template !== false}) ownsMain=${ownsMain}`);
+          cases++;
+        }
+      }
+    }
+    assert.ok(cases > 300, `${cases} cases`);
+  });
+
+  it("the reviewer's mechanical half reads the same rule over a Unity diff", () => {
+    const spec = { id: "lighting", owns: ["Assets/Lighting/**"], checks: [] };
+    const options = { ownsMain: false, template: false, main: MAIN };
+    const scene = ["+++ b/Assets/Scenes/Main.unity", "@@ -1,0 +1,1 @@", "+--- !u!1 &1234"].join("\n");
+    assert.deepEqual(mechanicalReview(scene, spec, options).map((v) => v.category), ["ownership"], "the main scene is the entry owner's");
+    const seam = ["+++ b/Assets/Lighting/Sun.cs.meta", "@@ -1,0 +1,1 @@", "+guid: abc", "+++ b/Assets/Lighting.meta", "@@ -1,0 +1,1 @@", "+folderAsset: yes"].join("\n");
+    assert.deepEqual(mechanicalReview(seam, spec, options), [], "a .meta in the seam is the seam's");
+  });
+});
+
+describe("the refusal a worker reads", () => {
+  it("says the Unity seam rule under Assets/, ProjectSettings/ and Packages/, and nothing of it elsewhere", () => {
+    const worker = { facetId: "lighting", owns: ["Assets/Lighting/**"], ownsMain: false, template: false, main: MAIN };
+    for (const file of ["Assets/Scenes/Main.unity", "Assets/Sky/Sky.cs.meta", "ProjectSettings/InputManager.asset", "Packages/manifest.json"]) {
+      const reason = ownershipReason(file, worker);
+      assert.match(reason, /outside worker "lighting"'s seam/, file);
+      assert.match(reason, /scene, the project settings and the package manifest belong to whoever owns the entry/, file);
+      assert.match(reason, /wired in by StudioSpawn, never by editing the scene/, file);
+      assert.match(reason, /a \.meta goes wherever its file goes/, file);
+      assert.ok(isUnityPath(file), file);
+    }
+    // The template wording carries the same sentence on a Unity path.
+    assert.match(ownershipReason("Assets/Scenes/Main.unity", { facetId: "lighting", owns: ["Assets/Lighting/**"], ownsMain: false, main: MAIN }), /StudioSpawn/);
+    // A browser game's refusal is byte for byte what it was.
+    const three = ownershipReason("src/sky.js", { facetId: "water", owns: ["src/water.js"], ownsMain: false });
+    assert.equal(three, 'src/sky.js is outside facet "water"\'s ownership — keep this facet\'s work in src/water.js (and docs/notes/NOTES.water.md); src/main.js only for the FACET WIRING line; src/studio.js and index.html belong to the main owner.');
+    assert.ok(!isUnityPath("src/sky.js"));
+    assert.ok(!isUnityPath("packages/game/out/bundle.js"), "a monorepo's packages/ is not Unity's Packages/");
+  });
+});
+
+describe("the locks on a Unity tree", () => {
+  it("never walk or lock Library/, Temp/, obj/, Logs/, UserSettings/, *.csproj or *.sln — and lock the rest as the rule says", async () => {
+    const cwd = await tmpDir("studio-unity-locks-");
+    const untouchable = {
+      "Library/ArtifactDB": "the import cache",
+      "Library/Pipeline/.unity-pipeline-port": '{"port":1}',
+      "Temp/UnityLockfile": "",
+      "obj/Debug/Assembly-CSharp.dll": "",
+      "Logs/AssetImportWorker0.log": "",
+      "UserSettings/EditorUserSettings.asset": "",
+      "Assembly-CSharp.csproj": "<Project/>",
+      "Game.sln": "Microsoft Visual Studio Solution File",
+      "brought/Library/ArtifactDB": "a project the user brought, one folder down",
+    };
+    const owned = {
+      "Assets/Lighting/Sun.cs": "// mine",
+      "Assets/Lighting/Sun.cs.meta": "guid: a",
+      "Assets/Lighting.meta": "folderAsset: yes",
+    };
+    const locked = {
+      "Assets/Sky/Sky.cs": "// somebody else's",
+      "Assets/Sky/Sky.cs.meta": "guid: b",
+      "Assets/Sky.meta": "folderAsset: yes",
+      "Assets/Scenes/Main.unity": "--- !u!1",
+      "Assets/Scenes/Main.unity.meta": "guid: c",
+      "Assets/Studio/StudioSpawn.cs": "// the entry",
+      "ProjectSettings/ProjectVersion.txt": "m_EditorVersion: 6000.0.50f1",
+      "Packages/manifest.json": "{}",
+    };
+    await writeTree(cwd, { ...untouchable, ...owned, ...locked });
+    const before = new Map<string, number>();
+    for (const rel of Object.keys(untouchable)) before.set(rel, (await stat(path.join(cwd, rel))).mode);
+
+    const record = await lockUnowned(cwd, { facetId: "lighting", owns: ["Assets/Lighting/**"], ownsMain: false, template: false, main: MAIN });
+    assert.deepEqual(record.files.map((entry) => entry.file).sort(), Object.keys(locked).sort(), JSON.stringify(record.files));
+    for (const rel of Object.keys(untouchable)) {
+      assert.equal((await stat(path.join(cwd, rel))).mode, before.get(rel), `${rel}: its mode is untouched`);
+      assert.equal(await isWritable(path.join(cwd, rel)), true, `${rel}: a read-only Library reads as a broken machine`);
+    }
+    for (const rel of Object.keys(owned)) assert.equal(await isWritable(path.join(cwd, rel)), true, `${rel}: the seam stays writable`);
+    for (const rel of Object.keys(locked)) assert.equal(await isWritable(path.join(cwd, rel)), false, `${rel}: locked`);
+    await releaseLocks(cwd, record);
+    for (const rel of Object.keys(locked)) assert.equal(await isWritable(path.join(cwd, rel)), true, `${rel}: given back`);
+
+    // The same set by name, for a path handed in without a walk.
+    for (const rel of ["Library/ArtifactDB", "brought/Library/x", "Temp/x", "Logs/x", "obj/x", "UserSettings/x", "Assembly-CSharp.csproj", "Sub/Game.sln"]) {
+      assert.equal(neverLocked(rel), true, rel);
+    }
+    for (const rel of ["Assets/Sky/Sky.cs", "Assets/Scenes/Main.unity", "Packages/manifest.json", "LibraryCard.cs", "objects/a.cs"]) {
+      assert.equal(neverLocked(rel), false, rel);
+    }
+  });
+});
+
+/** A Unity project the studio versions: Unity's standard ignore set, a scene, the settings. */
+async function unityRepo(options: { ignoreLibrary?: boolean } = {}): Promise<{ engine: SnapshotEngine; dir: string }> {
+  const dir = path.join(await tmpDir("studio-unity-repo-"), "grey-box");
+  await writeTree(dir, {
+    ".gitignore": `${options.ignoreLibrary === false ? "" : "[Ll]ibrary/\n[Oo]bj/\n"}[Tt]emp/\n.studio/\n`,
+    "Assets/Scenes/Main.unity": "--- !u!1 &1\n",
+    "ProjectSettings/ProjectVersion.txt": "m_EditorVersion: 6000.0.50f1\n",
+    "Packages/manifest.json": "{}\n",
+  });
+  const engine = new SnapshotEngine([{ name: "grey", dir }]);
+  await engine.init();
+  return { engine, dir };
+}
+
+describe("a fork of a Unity project", () => {
+  it("gets Library/ and obj/ as a copy — never a link — where git ignores them", async () => {
+    const { engine, dir } = await unityRepo();
+    await writeTree(dir, {
+      "Library/ArtifactDB": "artifacts v1",
+      "Library/Pipeline/.unity-pipeline-port": '{"port":1}',
+      "obj/Debug/a.o": "object code",
+    });
+    const base = await engine.snapshot({ scope: "game", reason: "before the night", gameWorkspace: "grey" });
+    const fork = path.join(await tmpDir("studio-unity-fork-"), "worker-a");
+    await engine.worktreeAt("grey", base.git.game!, fork);
+
+    for (const rel of ["Library", "obj"]) {
+      const info = await lstat(path.join(fork, rel));
+      assert.equal(info.isSymbolicLink(), false, `${rel} is not a link — two editors cannot share one Library`);
+      assert.equal(info.isDirectory(), true, `${rel} is a folder of its own`);
+    }
+    assert.equal(await readFile(path.join(fork, "Library", "ArtifactDB"), "utf8"), "artifacts v1");
+    assert.equal(await readFile(path.join(fork, "Library", "Pipeline", ".unity-pipeline-port"), "utf8"), '{"port":1}');
+    assert.equal(await readFile(path.join(fork, "obj", "Debug", "a.o"), "utf8"), "object code");
+    const received = engine.heavyClones.get(fork) ?? [];
+    assert.deepEqual(received.map((r) => r.rel), ["Library", "obj"]);
+    for (const r of received) assert.ok(r.via === "clone" || r.via === "copy", `${r.rel} via ${r.via}: cp -c, or the plain copy it falls back to`);
+
+    // A copy, so the worker's own import never reaches the live folder or another fork.
+    await writeFile(path.join(fork, "Library", "ArtifactDB"), "the worker's import");
+    assert.equal(await readFile(path.join(dir, "Library", "ArtifactDB"), "utf8"), "artifacts v1");
+    // And git still ignores it in the fork: nothing for `git add -A` to sweep in.
+    assert.equal((await git(fork, ["status", "--porcelain"])).trim(), "");
+    await engine.removeWorktree("grey", fork);
+    assert.equal(engine.heavyClones.has(fork), false, "the record goes with the worktree");
+  });
+
+  it("copies nothing that git does not ignore, and nothing at all when asked not to", async () => {
+    // A Library/ the project does not ignore is the project's own business — git carries what
+    // it tracks, and an untracked one would be swept into the next commit by `git add -A`.
+    const tracked = await unityRepo({ ignoreLibrary: false });
+    const base = await tracked.engine.snapshot({ scope: "game", reason: "before", gameWorkspace: "grey" });
+    await writeTree(tracked.dir, { "Library/ArtifactDB": "appeared after the snapshot, un-ignored" });
+    const fork = path.join(await tmpDir("studio-unity-fork-"), "worker-b");
+    await tracked.engine.worktreeAt("grey", base.git.game!, fork);
+    assert.equal(await stat(path.join(fork, "Library")).then(() => true, () => false), false, "not copied");
+    assert.equal(tracked.engine.heavyClones.get(fork), undefined);
+
+    const ignored = await unityRepo();
+    await writeTree(ignored.dir, { "Library/ArtifactDB": "artifacts" });
+    const snap = await ignored.engine.snapshot({ scope: "game", reason: "before", gameWorkspace: "grey" });
+    const plain = path.join(await tmpDir("studio-unity-fork-"), "worker-c");
+    await ignored.engine.worktreeAt("grey", snap.git.game!, plain, { cloneHeavy: false });
+    assert.equal(await stat(path.join(plain, "Library")).then(() => true, () => false), false, "cloneHeavy: false");
+    assert.equal(ignored.engine.heavyClones.get(plain), undefined);
+    assert.equal(await readFile(path.join(plain, "Assets", "Scenes", "Main.unity"), "utf8"), "--- !u!1 &1\n", "the fork itself is whole");
