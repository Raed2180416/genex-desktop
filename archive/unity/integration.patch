+
+/** A baseline JPEG's dimensions from its first SOF marker, or null when the file is not a JPEG. */
+async function jpegSize(file: string): Promise<{ width: number; height: number } | null> {
+  const data = await readFile(file).catch(() => null);
+  if (!data || data.length < 4 || data[0] !== 0xff || data[1] !== 0xd8) return null;
+  let at = 2;
+  while (at + 9 < data.length) {
+    if (data[at] !== 0xff) return null;
+    const marker = data[at + 1]!;
+    if (marker === 0xd8 || (marker >= 0xd0 && marker <= 0xd7)) { at += 2; continue; }
+    const length = data.readUInt16BE(at + 2);
+    if ((marker >= 0xc0 && marker <= 0xc3) || (marker >= 0xc5 && marker <= 0xc7) || (marker >= 0xc9 && marker <= 0xcb) || (marker >= 0xcd && marker <= 0xcf)) {
+      return { height: data.readUInt16BE(at + 5), width: data.readUInt16BE(at + 7) };
+    }
+    at += 2 + length;
+  }
+  return null;
+}
