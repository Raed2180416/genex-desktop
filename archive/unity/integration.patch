diff --git a/src/unity-bridge/Runtime/StudioRuntimeCommands.cs b/src/unity-bridge/Runtime/StudioRuntimeCommands.cs
new file mode 100644
index 0000000..b2797d4
--- /dev/null
+++ b/src/unity-bridge/Runtime/StudioRuntimeCommands.cs
@@ -0,0 +1,110 @@
+// The studio_* commands that need a running game: state, the stepped clock, demos. They are
+// `RuntimeOnly` — the editor server executes them in Play mode without advertising them in
+// Edit mode, and the runtime server lists them in a Player. Each is a static method under
+// `[CliCommand]` from Unity's Pipeline package; without that package they are plain methods.
+using AIGameStudio.Bridge;
+#if STUDIO_PIPELINE
+using Unity.Pipeline.Commands;
+#endif
+
+namespace AIGameStudio.Bridge
+{
+    public static class StudioRuntimeCommands
+    {
+#if STUDIO_PIPELINE
+        [CliCommand("studio_state", "The game's state the judge reads: registered probes, player, action counts, tags, render counters, frame and time.", RuntimeOnly = true)]
+#endif
+        public static object StudioState()
+        {
+            return StudioBridge.State();
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_seed", "Reseed the game deterministically, fix the step at 1/60 s and pause, so two builds can be compared on one seed.", RuntimeOnly = true)]
+#endif
+        public static object StudioSeed(
+#if STUDIO_PIPELINE
+            [CliArg("seed", "The seed", Required = true)]
+#endif
+            int seed)
+        {
+            return StudioBridge.Seed(seed);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_pause", "Freeze the game's clock; studio_step advances it by hand.", RuntimeOnly = true)]
+#endif
+        public static object StudioPause()
+        {
+            return StudioBridge.Pause();
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_step", "Advance the paused game by a number of fixed frames.", RuntimeOnly = true)]
+#endif
+        public static object StudioStep(
+#if STUDIO_PIPELINE
+            [CliArg("frames", "How many frames (default 1)")]
+#endif
+            int frames = 1)
+        {
+            return StudioBridge.Step(frames);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_start", "Resume live play and run the game's own start action when it has one (a title screen).", RuntimeOnly = true)]
+#endif
+        public static object StudioStart()
+        {
+            return StudioBridge.Start();
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_demos", "The scripted demonstrations this game registered.", RuntimeOnly = true)]
+#endif
+        public static object StudioDemos()
+        {
+            return StudioBridge.Demos();
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_demo", "Run a registered demonstration to its end state; studio_state's demo.done says when.", RuntimeOnly = true)]
+#endif
+        public static object StudioDemo(
+#if STUDIO_PIPELINE
+            [CliArg("name", "The demo's name", Required = true)]
+#endif
+            string name)
+        {
+            return StudioBridge.Demo(name);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_look", "Mouse-look by a delta in pixels: queued on the mouse device so a <Mouse>/delta binding reads it on the next frame.", RuntimeOnly = true)]
+#endif
+        public static object StudioLook(
+#if STUDIO_PIPELINE
+            [CliArg("dx", "Horizontal delta in pixels", Required = true)]
+#endif
+            float dx,
+#if STUDIO_PIPELINE
+            [CliArg("dy", "Vertical delta in pixels (up is positive)", Required = true)]
+#endif
+            float dy)
+        {
+            return StudioInput.Look(dx, dy);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_action", "Trigger a registered action by name.", RuntimeOnly = true)]
+#endif
+        public static object StudioAction(
+#if STUDIO_PIPELINE
+            [CliArg("name", "The action's name", Required = true)]
+#endif
+            string name)
+        {
+            return StudioBridge.TriggerAction(name);
+        }
+    }
+}
