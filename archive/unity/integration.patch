diff --git a/tests/e2e/run-unity-e2e.mjs b/tests/e2e/run-unity-e2e.mjs
new file mode 100644
index 0000000..2b1f34b
--- /dev/null
+++ b/tests/e2e/run-unity-e2e.mjs
@@ -0,0 +1,130 @@
+/**
+ * The Unity runner, opt-in (plan §8.4): `npm run test:unity:e2e`.
+ *
+ * Not part of `npm run verify` — it needs a Unity 6 editor, the `unity` CLI and a signed-in
+ * account, which only the owner's Mac has. So it looks FIRST, with the studio's real detection
+ * (`detectUnity`, no seams, from a temp userData that holds no CLI of its own): a machine
+ * without Unity writes `{ skipped: true, reason, code }` to `summary.json`, says
+ * `unity e2e skipped: <reason>` and exits 0. That is the only path a machine without Unity can
+ * take, and it must be green there.
+ *
+ * With Unity ready it bundles the Electron program exactly as the shapes runner does, runs it in
+ * the pinned Electron, and refuses to pass unless the summary it wrote carries every entry that
+ * was asked for with `ok: true`. Flags and env as the shapes runner: `--only <id>[,<id>]`,
+ * `--engine fixture|codex|claude|all`, `--out <dir>` (default `.claude/plans/unity/evidence`,
+ * gitignored), `--keep` (leave the temp copies and print where they are).
+ *
+ * No model of any kind is started, and no `--ollama-host` is passed.
+ */
+import { build } from "esbuild";
+import { spawn } from "node:child_process";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { detectUnity } from "../../src/substrate/unity.ts";
+
+const repo = fileURLToPath(new URL("../..", import.meta.url));
+/** The fixtures §8.4 names; `kart` is the owner's download and is skipped by name when absent. */
+const FIXTURES = ["grey-box", "kart"];
+const TRANSPORTS = ["fixture", "codex", "claude"];
+
+function flag(name, fallback = null) {
+  const index = process.argv.indexOf(`--${name}`);
+  if (index === -1) return fallback;
+  const next = process.argv[index + 1];
+  return next && !next.startsWith("--") ? next : "true";
+}
+
+const only = (flag("only") ?? "").split(",").map((id) => id.trim()).filter(Boolean);
+const asked = only.length ? only : FIXTURES;
+for (const id of asked) if (!FIXTURES.includes(id)) throw new Error(`no fixture called "${id}" — one of ${FIXTURES.join(", ")}`);
+const engineFlag = flag("engine", "all");
+const transports = engineFlag === "all" ? TRANSPORTS : engineFlag.split(",").map((name) => name.trim()).filter(Boolean);
+for (const name of transports) if (!TRANSPORTS.includes(name)) throw new Error(`no transport called "${name}" — one of ${TRANSPORTS.join(", ")}`);
+
+const output = path.resolve(flag("out") ?? process.env.STUDIO_UNITY_OUT ?? path.join(repo, ".claude/plans/unity/evidence"));
+await mkdir(output, { recursive: true });
+await rm(path.join(output, "summary.json"), { force: true });
+
+// ── first: is Unity here? The real probe, the real candidates, a userData with nothing in it ──
+const detectHome = await mkdtemp(path.join(os.tmpdir(), "studio-unity-detect-"));
+let status;
+try {
+  status = await detectUnity(detectHome, true);
+} finally {
+  await rm(detectHome, { recursive: true, force: true }).catch(() => {});
+}
+if (status.code !== "ready") {
+  const skipped = { skipped: true, reason: status.detail, code: status.code, ...(status.remedy ? { remedy: status.remedy } : {}) };
+  await writeFile(path.join(output, "summary.json"), JSON.stringify(skipped, null, 2));
+  console.log(`unity e2e skipped: ${status.detail}`);
+  process.exit(0);
+}
+console.log(`unity e2e: ${status.detail} — cli ${status.cli?.version ?? "?"} (${status.cli?.source ?? "?"}), editors ${status.editors.map((editor) => editor.version).join(", ")}`);
+
+// ── then: the program, bundled exactly like the shapes runner ──
+const entry = path.join(output, "unity-electron.mjs");
+await build({
+  entryPoints: [path.join(repo, "tests/e2e/unity-electron.ts")],
+  outfile: entry,
+  bundle: true,
+  platform: "node",
+  target: "node22",
+  format: "esm",
+  // The studio's own modules are bundled; everything from node_modules is resolved by Electron
+  // at run time, because a CJS dependency that requires "crypto" dynamically cannot be bundled.
+  packages: "external",
+  external: ["electron"],
+});
+
+const electron = path.join(repo, "node_modules/electron/dist/Electron.app/Contents/MacOS/Electron");
+const child = spawn(electron, [entry], {
+  cwd: repo,
+  stdio: "inherit",
+  env: {
+    ...process.env,
+    STUDIO_UNITY_REPO: repo,
+    STUDIO_UNITY_OUT: output,
+    // Empty means every fixture.
+    STUDIO_UNITY_ONLY: only.join(","),
+    STUDIO_UNITY_ENGINES: transports.join(","),
+    ...(flag("keep") ? { STUDIO_UNITY_KEEP: "1" } : {}),
+  },
+});
+// spike S5: a cold Library import can take minutes per editor and the program opens up to five
+// (the live one, two queued, one per scripted transport); the ceiling is generous until measured.
+const CEILING_MIN = 45;
+const timeout = setTimeout(() => {
+  console.error(`Unity E2E exceeded ${CEILING_MIN} minutes`);
+  child.kill("SIGTERM");
+}, CEILING_MIN * 60_000);
+process.once("SIGINT", () => child.kill("SIGTERM"));
+const code = await new Promise((resolve) => {
+  child.once("exit", resolve);
+  child.once("error", (err) => {
+    console.error(err);
+    resolve(1);
+  });
+});
+clearTimeout(timeout);
+
+// ── last: the summary says so, for every entry that was asked ──
+const summary = await readFile(path.join(output, "summary.json"), "utf8").then(JSON.parse).catch(() => null);
+const expected = asked.flatMap((id) => transports.map((transport) => `${id}/${transport}`));
+const byKey = new Map((summary?.entries ?? []).map((entry) => [`${entry.id}/${entry.transport}`, entry]));
+const missing = expected.filter((key) => !byKey.has(key));
+const failed = expected.filter((key) => byKey.has(key) && byKey.get(key).ok !== true);
+if (missing.length) console.error(`unity summary is missing ${missing.length} entr${missing.length === 1 ? "y" : "ies"}: ${missing.join(", ")}`);
+for (const key of expected) {
+  const entry = byKey.get(key);
+  if (entry?.skipped) console.log(`${key}: skipped — ${entry.skipped}`);
+}
+for (const key of failed) {
+  const rows = (byKey.get(key).checks ?? []).filter((row) => row.ok !== true);
+  console.error(`${key} failed ${rows.length} row(s):`);
+  for (const row of rows) console.error(`  ${row.id}: ${row.detail}`);
+}
+if (summary?.error) console.error(`unity program error: ${summary.error}`);
+if (summary?.unverified?.length) for (const note of summary.unverified) console.warn(`unverified: ${note}`);
+process.exitCode = code === 0 && summary?.passed === true && missing.length === 0 && failed.length === 0 ? 0 : 1;
