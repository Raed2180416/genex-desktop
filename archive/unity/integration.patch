+    const h = Math.max(a.height, b.height);
+    const gap = 8;
+    const width = a.width + gap + b.width;
+    const bgra = Buffer.alloc(width * h * 4);
+    for (let y = 0; y < h; y++) {
+      if (y < a.height) a.bgra.copy(bgra, y * width * 4, y * a.width * 4, (y + 1) * a.width * 4);
+      if (y < b.height) b.bgra.copy(bgra, (y * width + a.width + gap) * 4, y * b.width * 4, (y + 1) * b.width * 4);
