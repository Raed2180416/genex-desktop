diff --git a/src/unity-bridge/Runtime/StudioBridgeRunner.cs b/src/unity-bridge/Runtime/StudioBridgeRunner.cs
new file mode 100644
index 0000000..4b98c0c
--- /dev/null
+++ b/src/unity-bridge/Runtime/StudioBridgeRunner.cs
@@ -0,0 +1,142 @@
+// The bridge's one MonoBehaviour: created on first use, hidden, never saved into a scene. It
+// ticks the stepped clock, counts exceptions and input actions, keeps the render counters and
+// runs demos as coroutines. Nothing in the game needs to reference it.
+using System.Collections;
+using System.Collections.Generic;
+using Unity.Profiling;
+using UnityEngine;
+#if STUDIO_INPUT_SYSTEM
+using UnityEngine.InputSystem;
+#endif
+
+namespace AIGameStudio.Bridge
+{
+    [AddComponentMenu("")]
+    [DefaultExecutionOrder(-1000)]
+    internal sealed class StudioBridgeRunner : MonoBehaviour
+    {
+        static StudioBridgeRunner instance;
+        static int exceptions;
+        static float startedAt = -1f;
+        static float firstFrameAt = -1f;
+        static ProfilerRecorder drawCalls;
+        static ProfilerRecorder triangles;
+        static string runningDemo;
+        static bool demoDone;
+#if STUDIO_INPUT_SYSTEM
+        static readonly HashSet<InputAction> hooked = new HashSet<InputAction>();
+        static readonly List<InputAction> enabledActions = new List<InputAction>();
+#endif
+
+        /// The runner, made on demand; harmless to call every command.
+        internal static StudioBridgeRunner Ensure()
+        {
+            if (instance != null) return instance;
+            var holder = new GameObject("StudioBridge") { hideFlags = HideFlags.HideAndDontSave };
+            instance = holder.AddComponent<StudioBridgeRunner>();
+            DontDestroyOnLoad(holder);
+            return instance;
+        }
+
+        void OnEnable()
+        {
+            Application.logMessageReceived += OnLog;
+            if (startedAt < 0f) startedAt = Time.realtimeSinceStartup;
+            if (!drawCalls.Valid) drawCalls = ProfilerRecorder.StartNew(ProfilerCategory.Render, "Draw Calls Count");
+            if (!triangles.Valid) triangles = ProfilerRecorder.StartNew(ProfilerCategory.Render, "Triangles Count");
+        }
+
+        void OnDisable()
+        {
+            Application.logMessageReceived -= OnLog;
+        }
+
+        void OnDestroy()
+        {
+            if (drawCalls.Valid) drawCalls.Dispose();
+            if (triangles.Valid) triangles.Dispose();
+            if (instance == this) instance = null;
+        }
+
+        static void OnLog(string condition, string stackTrace, LogType type)
+        {
+            if (type == LogType.Exception) exceptions++;
+        }
+
+        void Update()
+        {
+            if (firstFrameAt < 0f) firstFrameAt = Time.realtimeSinceStartup;
+            // The runner runs first in the frame (DefaultExecutionOrder), so a held look delta
+            // is on the mouse before the game's own Update reads it.
+            StudioInput.Flush();
+            StudioBridge.Tick();
+            HookInputActions();
+        }
+
+        /// Every enabled Input System action is counted as `actions.<name>` — no registration needed.
+        static void HookInputActions()
+        {
+#if STUDIO_INPUT_SYSTEM
+            if (Time.frameCount % 30 != 0) return;
+            enabledActions.Clear();
+            InputSystem.ListEnabledActions(enabledActions);
+            foreach (var action in enabledActions)
+            {
+                if (action == null || hooked.Contains(action)) continue;
+                var name = action.name.ToLowerInvariant();
+                action.performed += _ => StudioBridge.CountAction(name);
+                hooked.Add(action);
+            }
+#endif
+        }
+
+        internal void RunDemo(string name, System.Func<IEnumerator> run)
+        {
+            StopAllCoroutines();
+            runningDemo = name;
+            demoDone = false;
+            StartCoroutine(Demo(run));
+        }
+
+        IEnumerator Demo(System.Func<IEnumerator> run)
+        {
+            IEnumerator steps = null;
+            try { steps = run(); }
+            catch (System.Exception e) { Debug.LogException(e); }
+            if (steps != null) yield return StartCoroutine(steps);
+            demoDone = true;
+        }
+
+        internal static object DemoState()
+        {
+            return new Dictionary<string, object> { ["running"] = runningDemo, ["done"] = runningDemo != null && demoDone };
+        }
+
+        /// What the judge's ceiling checks read; unavailable (nulls) where the profiler does not count.
+        internal static object RenderStats()
+        {
+            var available = drawCalls.Valid && triangles.Valid;
+            return new Dictionary<string, object>
+            {
+                ["available"] = available,
+                ["drawCalls"] = available ? drawCalls.LastValue : (object)null,
+                ["triangles"] = available ? triangles.LastValue : (object)null,
+            };
+        }
+
+        /// `{ playing, frame, exceptions, firstFrameMs }` — the readiness the studio waits on after play.
+        internal static object Ready(bool playing)
+        {
+            var firstFrameMs = firstFrameAt < 0f || startedAt < 0f ? -1 : Mathf.RoundToInt((firstFrameAt - startedAt) * 1000f);
+            return new Dictionary<string, object>
+            {
+                ["playing"] = playing,
+                ["frame"] = StudioBridge.Frame,
+                ["paused"] = StudioBridge.Paused,
+                ["stepping"] = StudioBridge.Stepping,
+                ["exceptions"] = exceptions,
+                ["firstFrameMs"] = firstFrameMs,
+            };
+        }
+    }
+}
