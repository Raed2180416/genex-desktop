+/**
+ * The Unity tools, the grant and the RPCs through the real core (Unity in the studio, plan
+ * §3.4, work packages §3.3–3.4): a rig with the fake `unity` CLI and the fake editor process.
+ * A delegation with a unity grant gets the pinned tool list for its role; every tool
+ * round-trips through the fake Pipeline; `unity_command command=eval` never reaches it; the
+ * picture comes back as an image block on Claude Code and as a path on Codex; `unity_action`
+ * events land on the thread; the transient lease is released in the delegation's finally; the
+ * descriptor is a denyRead; a `unity:` handle never touches the browser pool.
+ */
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdir, readFile, readdir, realpath, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { after, describe, it } from "node:test";
+import { decodePng } from "../../src/main/unity-image.ts";
+import { pipelineDenyReads } from "../../src/main/unity-editor.ts";
+import { ClaudeCodeEngine } from "../../src/substrate/engines/claude-code.ts";
+import { CodexEngine } from "../../src/substrate/engines/codex.ts";
+import type { DelegateRequest, DelegateResult, LiveToolResult } from "../../src/substrate/engines/types.ts";
+import { UNITY_TOOL_NAMES, UNITY_TOOLS_BY_ROLE, type UnityRole } from "../../src/substrate/unity-types.ts";
+import { fakeUnityCli, fakeUnityProbe, type FakeUnityCliOptions } from "../helpers/fake-unity-cli.ts";
+import { fakeEditorCalls, fakeEditorInvocations, fakeUnityEditorBinary } from "../helpers/fake-unity-editor.ts";
+import { scriptedClaude } from "../helpers/scripted-claude.ts";
+import { scriptedCodex } from "../helpers/scripted-codex.ts";
+import { customEvents, startRig, type Rig } from "../helpers/studio-rig.ts";
+import { tmpDir } from "../helpers/tmp.ts";
+
+const rigs: Rig[] = [];
+const roots: string[] = [];
+
+function pgrep(needle: string): string[] {
+  try {
+    return execFileSync("pgrep", ["-f", needle]).toString().trim().split("\n").filter(Boolean);
+  } catch {
+    return [];
+  }
+}
+
+after(async () => {
+  // `close()` releases every editor of every run: the last test leaves one leased on purpose.
+  for (const rig of rigs) await rig.stop().catch(() => {});
+  for (const root of roots) assert.deepEqual(pgrep(root), [], `fake editors still alive on ${root}`);
+});
+
+const text = (result: LiveToolResult): string => (typeof result === "string" ? result : result.text);
+
+async function unityTree(root: string, extras: Record<string, string> = {}): Promise<string> {
+  await mkdir(path.join(root, "ProjectSettings"), { recursive: true });
+  await mkdir(path.join(root, "Assets", "Scenes"), { recursive: true });
+  await mkdir(path.join(root, "Packages"), { recursive: true });
+  await writeFile(path.join(root, "ProjectSettings", "ProjectVersion.txt"), "m_EditorVersion: 6000.0.50f1\n");
+  await writeFile(path.join(root, "Packages", "manifest.json"), JSON.stringify({ dependencies: { "com.unity.pipeline": "0.6.0-exp.1" } }));
+  await writeFile(path.join(root, "Assets", "Scenes", "Main.unity"), "%YAML 1.1\n");
+  for (const [file, body] of Object.entries(extras)) await writeFile(path.join(root, "Assets", file), body);
+  roots.push(root);
+  return root;
+}
+
+interface Stage {
+  rig: Rig;
+  api: Record<string, (p: unknown) => Promise<unknown>>;
+  threadId: string;
+  live: string;
+  worktree: string;
+  home: string;
+  requests: DelegateRequest[];
+  /** What the fake contractor does with its tools during the next delegation. */
+  script: { run: ((request: DelegateRequest) => Promise<void>) | null };
+  delegate: (extra: Record<string, unknown>) => Promise<unknown>;
+}
+
+async function stage(): Promise<Stage> {
+  // Canonical paths: detection realpaths the CLI, and the probe answers only for the path it was given.
+  const home = await realpath(await tmpDir("studio-unity-home-"));
+  const binary = await fakeUnityEditorBinary(path.join(home, "editors", "Unity"));
+  const cliOptions: FakeUnityCliOptions = { editors: [{ version: "6000.0.50f1", path: binary }], signedIn: { name: "Sim", email: "sim@example.com" }, licence: { kind: "personal", active: true } };
+  const cli = await fakeUnityCli(path.join(home, ".unity", "bin"), cliOptions);
+  // Blender declared absent: this Mac may have one, and a sixth tool must not appear in the pinned lists.
+  const rig = await startRig({ replies: [] }, { blender: { probe: async () => null }, unity: { home, probe: fakeUnityProbe(cli.binary, cliOptions), settleMs: 20_000, pollMs: 50, watchMs: 500, waitMs: 5_000, killGraceMs: 2_000 } });
+  rigs.push(rig);
+  const status = await rig.core.unityStatus(true);
+  assert.equal(status.code, "ready", status.detail);
+  assert.equal(status.editors[0]?.binary, binary);
+  const project = await rig.core.games.scaffold("unityworld", { title: "Unity World" });
+  const live = await unityTree(project.dir);
+  const worktree = await unityTree(path.join(rig.core.layout.scratch, "worktrees", "unityworld-lighting"));
+  const threadId = await rig.core.createGameThread("unityworld");
+  const api = rig.core.api() as unknown as Record<string, (p: unknown) => Promise<unknown>>;
+  const requests: DelegateRequest[] = [];
+  const script: Stage["script"] = { run: null };
+  rig.core.engines.register({
+    id: "fake-delegate",
+    label: "Fake contractor",
+    kind: "delegated",
+    status: async () => ({ code: "ready", detail: "" }),
+    models: async () => [],
+    complete: async () => ({ message: { role: "assistant", content: "ok" }, usage: {}, stopReason: "stop", model: "fake", engine: "fake-delegate" }),
+    delegate: async (request: DelegateRequest): Promise<DelegateResult> => {
+      requests.push(request);
+      if (script.run) await script.run(request);
+      return { ok: true, summary: "ok", usage: {}, turns: 1, engine: "fake-delegate" };
+    },
+  } as never);
+  const delegate = (extra: Record<string, unknown>) => api["engine.delegate"]!({ engine: "fake-delegate", prompt: "build", project: "unityworld", threadId, ...extra });
+  return { rig, api, threadId, live, worktree, home, requests, script, delegate };
+}
