diff --git a/tests/e2e/unity-electron.ts b/tests/e2e/unity-electron.ts
new file mode 100644
index 0000000..94ffa7d
--- /dev/null
+++ b/tests/e2e/unity-electron.ts
@@ -0,0 +1,902 @@
+/**
+ * The Unity runner's program (plan §8.4): a Unity project the studio did not write, opened for
+ * real in a Unity 6 editor on the owner's Mac, adopted, compiled, played, photographed and judged
+ * by the same evidence pass a night runs — then the same project handed to the real Codex bridge
+ * and the real Claude MCP surface with a Unity grant, so the `unity_*` tool list is observed on
+ * both engines rather than assumed.
+ *
+ * Everything below the two scripted engine seams is the studio itself: a real `StudioCore`, real
+ * Unity detection (`unity: {}` — no probe seam; the runner that starts this program has already
+ * found an editor), the real editor pool, the real port, the real evidence pass out of the
+ * harness seed, the real bridge and MCP server. `ctx` is `core.api()` with the substrate pipe
+ * removed, exactly what the harness host dispatches against.
+ *
+ * Mirrors `shapes-electron.ts`, with one difference of temperament: an editor is minutes of
+ * machine and a first run is measurement, so a row that throws is a FAILED ROW with the error as
+ * its detail, never a crash of the program — and the teardown releases every editor and kills
+ * whatever survived, whatever happened above it. Rows the plan defers to M3 (`capture-4k`,
+ * `headless-no-window`) are recorded as skipped unless the headless setting is on.
+ *
+ * `// spike S<n>:` marks a claim plan §7 M0 has not measured yet; the row's detail carries the
+ * number so the first real run fills the table.
+ */
+import { app, BrowserWindow } from "electron";
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdtempSync } from "node:fs";
+import { cp, mkdir, readFile, readdir, rm, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { promisify } from "node:util";
+import { GamePreview, registerGameScheme } from "../../src/main/preview.ts";
+import { StudioCore } from "../../src/main/studio-core.ts";
+import { installPipelineIntoProject } from "../../src/main/unity-setup.ts";
+import { detectProjectShape } from "../../src/substrate/game-workspace.ts";
+import { CodexEngine } from "../../src/substrate/engines/codex.ts";
+import { ClaudeCodeEngine } from "../../src/substrate/engines/claude-code.ts";
+import { UNITY_PIN } from "../../src/substrate/unity.ts";
+import { UNITY_TOOLS_BY_ROLE, type UnityStatus } from "../../src/substrate/unity-types.ts";
+import { gatherEvidence } from "../../src/harness-seed/loop/gauntlet.mjs";
+import { GAME_KINDS, inputProbesFor, gameLine, normalizeGameTraits } from "../../src/harness-seed/loop/kinds.mjs";
+import { unityGrantFor, unityRunFacts } from "../../src/harness-seed/loop/unity.mjs";
+import { scriptedCodex, type ScriptedCodex } from "../helpers/scripted-codex.ts";
+import { scriptedClaude, type ScriptedClaude } from "../helpers/scripted-claude.ts";
+import { undeclaredWarnings } from "./warning-policy.ts";
+
+const repo = process.env.STUDIO_UNITY_REPO!;
+const output = process.env.STUDIO_UNITY_OUT!;
+const only = (process.env.STUDIO_UNITY_ONLY ?? "").split(",").filter(Boolean);
+const transports = (process.env.STUDIO_UNITY_ENGINES ?? "fixture,codex,claude").split(",").filter(Boolean);
+const keep = process.env.STUDIO_UNITY_KEEP === "1";
+
+const execFileAsync = promisify(execFile);
+
+/** The fixtures §8.4 names, in order; `kart` is the owner's download and may be absent. */
+const FIXTURES = ["grey-box", "kart"];
+const VIEW = { width: 960, height: 600 };
+/** Two frames of one picture, the threshold the optimization pixel critic already uses. */
+const SAME_APPEARANCE = 0.01;
+/** How long the first transient lease is held while the second waits behind it. */
+const QUEUE_HOLD_MS = 4_000;
+const fixturesDir = path.join(repo, "tests/fixtures/unity");
+const resources = path.join(repo, "dist/resources");
+
+/**
+ * The folders and files the editor itself writes on a project (Library, Temp, the IDE files,
+ * the lock file) — Unity's own bookkeeping, never a fact about the build. `build-untouched`
+ * looks past them, and the tree hashes never walk them.
+ */
+const EDITOR_DIRS = new Set(["Library", "Temp", "Logs", "obj", "UserSettings", ".git", ".studio", ".vs", ".idea", "node_modules"]);
+const EDITOR_FILES = [/\.csproj$/, /\.sln$/, /^Packages\/packages-lock\.json$/, /\.DS_Store$/];
+
+/**
+ * Warnings the Unity surface earns in v1, not the game: the seed says "audio not measured on
+ * Unity" on every pass (plan §5.6), so a fixture whose manifest names no warning is still
+ * telling the truth. Anything else the pass collects has to be named by the fixture.
+ */
+const SURFACE_WARNINGS: readonly string[] = ["audio not measured on Unity"];
+
+/** Lane B's fixture manifest (plan §8.4, version 1). */
+interface Manifest {
+  version: number;
+  id: string;
+  title: string;
+  proves: string[];
+  shape: Record<string, unknown> & { entry?: string; unity?: { editorVersion?: string } };
+  unity: { editorVersion: string; inputSystem: boolean; renderPipeline: string };
+  adopts: { addsAtLeast: string[]; neverAdded: string[] };
+  game: Record<string, unknown>;
+  setup: Record<string, unknown> | null;
+  cameras: string[];
+  delta: Array<{ path: string; min: number }>;
+  /** Warnings this game must produce. Anything else it produces has to be in `allowWarnings`. */
+  expectWarnings: string[];
+  /** Warnings this game may produce and need not. */
+  allowWarnings?: string[];
+  deterministic: boolean;
+  readyBudgetMs: number;
+  queueSlots: number;
+}
+
+interface Row {
+  id: string;
+  ok: boolean;
+  detail: string;
+  skipped?: string;
+}
+
+interface Entry {
+  id: string;
+  transport: string;
+  ok: boolean;
+  skipped?: string;
+  checks: Row[];
+  [fact: string]: unknown;
+}
+
+const summary: {
+  passed: boolean;
+  fixture: string;
+  unity: Record<string, unknown> | null;
+  entries: Entry[];
+  unverified: string[];
+  error?: string;
+} = {
+  passed: false,
+  fixture: "Unity projects with no studio contract, opened in a real Unity 6 editor; real core, pool, port, evidence pass, bridge and MCP server; only the CLI and the model are scripted",
+  unity: null,
+  entries: [],
+  unverified: [],
+};
+
+// ── small tools ────────────────────────────────────────────────────────────────────────────
+
+const message = (err: unknown): string => String((err as Error)?.message ?? err);
+const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+/** Every file under `dir`, project-relative, with the editor's own bookkeeping left out. */
+async function walkFiles(dir: string, rel = ""): Promise<string[]> {
+  const entries = await readdir(path.join(dir, rel), { withFileTypes: true }).catch(() => []);
+  const found: string[] = [];
+  for (const entry of entries) {
+    if (EDITOR_DIRS.has(entry.name)) continue;
+    const relative = rel ? `${rel}/${entry.name}` : entry.name;
+    if (entry.isDirectory()) found.push(...(await walkFiles(dir, relative)));
+    else if (!EDITOR_FILES.some((pattern) => pattern.test(relative))) found.push(relative);
+  }
+  return found.sort();
+}
+
+async function hashTree(dir: string): Promise<Map<string, string>> {
+  const out = new Map<string, string>();
+  for (const rel of await walkFiles(dir)) {
+    const body = await readFile(path.join(dir, rel)).catch(() => Buffer.alloc(0));
+    out.set(rel, createHash("sha256").update(body).digest("hex"));
+  }
+  return out;
+}
+
+function treeDiff(before: Map<string, string>, after: Map<string, string>): string[] {
+  const changed = new Set<string>();
+  for (const [rel, hash] of after) if (before.get(rel) !== hash) changed.add(rel);
+  for (const rel of before.keys()) if (!after.has(rel)) changed.add(rel);
+  return [...changed].sort();
+}
+
+/** The bridge's own telemetry, which is a fact about the editor and never about the game. */
+const BRIDGE_STATE_KEYS = new Set(["frame", "time", "simulatedMs", "running", "playing", "paused", "fps", "pointerLock", "render", "__render", "__attached", "drawCalls", "triangles", "scene", "editorVersion"]);
+
+function gameOwnState(state: unknown): Record<string, unknown> {
+  if (!state || typeof state !== "object") return {};
+  const out: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(state as Record<string, unknown>)) if (!BRIDGE_STATE_KEYS.has(key) && !key.startsWith("__")) out[key] = value;
