+/**
+ * The stage in Unity mode (Unity in the studio, 2026-09-11; plan §4.3 and M2).
+ *
+ * The game does not run in a native view here: the run's live editor is a process of its own,
+ * and the stage shows it as a still stream — one `unityFrame` at a time, two a second — with
+ * the transport under it, a scene picker, and "Open in Unity" for the human who wants the
+ * editor itself. It is one component with two sources (choice 11): windowed, headless and the
+ * human's own input change what is behind the stream, never this panel.
+ *
+ * Input (M2): a click gives the picture focus; while it has it, keys and the mouse are gathered
+ * and sent once per animation frame through `unityInput` — never more than sixty batches a
+ * second, one on the wire at a time so the editor sees them in order — the chip says the
+ * keyboard is the game's, and Esc gives it back. The reply's measured latency stands beside
+ * the status line. Until lane C's `unityInput` is real the path is inert: the reply says nothing
+ * was applied, and the chip still tells the truth about where the keyboard is.
+ */
+import type { JSX, KeyboardEvent as ReactKeyboardEvent, MouseEvent as ReactMouseEvent, WheelEvent as ReactWheelEvent } from "react";
+import { useCallback, useEffect, useRef, useState } from "react";
+import type { StudioApi } from "../../shared/studio-api.ts";
+import type { UnityFrameView, UnityStageInput, UnityTransportAction } from "../../substrate/unity-types.ts";
+import { problemWords, UNITY_WORDS } from "../words.ts";
+import { Button } from "../ui/Button.tsx";
+
+/** One row of `unityHandles()` — a live editor the stage can show. */
+export type UnityHandleRow = Awaited<ReturnType<StudioApi["unityHandles"]>>[number];
+
+/** Two stills a second, one on the wire at a time (M1; M3 aims higher behind the same stream). */
+const FRAME_TICK_MS = 500;
+/** The long edge the stage asks for — the panel is never wider, and the JPEG stays small. */
+const FRAME_MAX_PX = 1280;
+
+interface Props {
+  handle: string;
+  project: string;
+  /** The user's own editor (started from the stage), which the stage may close; a run's is the run's. */
+  own?: boolean;
+  onNotice: (text: string, tone?: "ok" | "err" | "info") => void;
+}
+
+interface Picture {
+  src: string;
+  width: number;
+  height: number;
+}
+
+interface SceneList {
+  open: string[];
+  build: string[];
+  current: string | null;
+}
+
+/** `Assets/Scenes/Main.unity` → `Main`, for the picker; the value stays the path. */
+function sceneName(path: string): string {
+  return path.replace(/^.*\//, "").replace(/\.unity$/, "");
+}
+
+export function UnityStage({ handle, project, own = false, onNotice }: Props): JSX.Element {
+  const [frame, setFrame] = useState<UnityFrameView | null>(null);
+  /** The last picture the editor had to show: a frame without one (settling, compiling) keeps it. */
+  const [picture, setPicture] = useState<Picture | null>(null);
+  const [scenes, setScenes] = useState<SceneList>({ open: [], build: [], current: null });
+  /** The scene Play opens, when the user chose one other than the editor's own. */
+  const [scene, setScene] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [focused, setFocused] = useState(false);
+  const [latencyMs, setLatencyMs] = useState<number | null>(null);
+  const stage = useRef<HTMLDivElement>(null);
+  const image = useRef<HTMLImageElement>(null);
+
+  const takeFrame = useCallback((view: UnityFrameView): void => {
+    setFrame(view);
+    if (view.jpeg) setPicture({ src: `data:image/jpeg;base64,${view.jpeg}`, width: view.width, height: view.height });
+  }, []);
+
+  // The still stream: a tick asks for one frame and skips while the last is still on its way.
+  useEffect(() => {
+    let cancelled = false;
+    let inFlight = false;
+    const tick = (): void => {
+      if (inFlight) return;
+      inFlight = true;
+      void window.studio
+        .unityFrame(handle, { maxPx: FRAME_MAX_PX })
+        .then((view) => { if (!cancelled) takeFrame(view); })
+        .catch(() => {})
+        .finally(() => { inFlight = false; });
+    };
+    tick();
+    const timer = setInterval(tick, FRAME_TICK_MS);
+    return () => { cancelled = true; clearInterval(timer); };
+  }, [handle, takeFrame]);
+
+  // The scene list, again whenever the editor reports a different scene.
+  const currentScene = frame?.scene ?? null;
+  useEffect(() => {
+    let cancelled = false;
+    void window.studio.unityScenes(handle).then((list) => { if (!cancelled) setScenes(list); }).catch(() => {});
+    return () => { cancelled = true; };
+  }, [handle, currentScene]);
+
+  const transport = useCallback((action: UnityTransportAction): void => {
+    if (busy) return;
+    setBusy(true);
+    const chosen = action === "play" && scene && scene !== currentScene ? { scene } : undefined;
+    void window.studio
+      .unityTransport(handle, action, chosen)
+      .then((view) => {
+        takeFrame(view);
+        if (action === "capture") onNotice(UNITY_WORDS.captured, "ok");
+      })
+      .catch((err) => onNotice(problemWords(err), "err"))
+      .finally(() => setBusy(false));
+  }, [busy, handle, scene, currentScene, onNotice, takeFrame]);
+
+  const closeEditor = useCallback((): void => {
+    void window.studio
+      .closeUnityStage(handle)
+      .then((result) => { if (!result.closed) onNotice(result.note ?? UNITY_WORDS.noEditor_stage, "info"); })
+      .catch((err) => onNotice(problemWords(err), "err"));
+  }, [handle, onNotice]);
+
+  const openInUnity = useCallback((): void => {
+    void window.studio
+      .openInUnity(project)
+      .then((result) => {
+        if (!result.opened) onNotice(result.note ?? UNITY_WORDS.noEditor_stage, "info");
+        else if (result.note) onNotice(result.note, "info");
+      })
+      .catch((err) => onNotice(problemWords(err), "err"));
+  }, [project, onNotice]);
+
+  // ── input (M2) ────────────────────────────────────────────────────────────────────────
+  // Gathered per animation frame and sent as one batch. Moves collapse to the last one of the
+  // frame and wheel turns add up; keys are kept as they came, without the keyboard's repeats.
+  const input = useRef<{ pending: UnityStageInput[]; raf: number | null; sending: boolean; held: Set<string> }>({ pending: [], raf: null, sending: false, held: new Set() });
+  const flush = useCallback((): void => {
+    const state = input.current;
+    state.raf = null;
+    if (state.sending || state.pending.length === 0) return;
+    const batch = state.pending;
+    state.pending = [];
+    state.sending = true;
+    void window.studio
+      .unityInput(handle, batch)
+      .then((reply) => { if (typeof reply.latencyMs === "number") setLatencyMs(reply.latencyMs); })
+      .catch(() => {})
+      .finally(() => {
+        state.sending = false;
+        if (state.pending.length && state.raf === null) state.raf = requestAnimationFrame(flush);
+      });
+  }, [handle]);
+  const queue = useCallback((next: UnityStageInput): void => {
+    const state = input.current;
+    const last = state.pending[state.pending.length - 1];
+    if (next.type === "pointer" && next.action === "move" && last?.type === "pointer" && last.action === "move") state.pending[state.pending.length - 1] = next;
+    else if (next.type === "wheel" && last?.type === "wheel") state.pending[state.pending.length - 1] = { ...last, x: next.x, y: next.y, dx: last.dx + next.dx, dy: last.dy + next.dy };
+    else state.pending.push(next);
+    if (state.raf === null) state.raf = requestAnimationFrame(flush);
+  }, [flush]);
+  useEffect(() => {
+    const state = input.current;
+    return () => {
+      if (state.raf !== null) cancelAnimationFrame(state.raf);
+      state.pending = [];
+      state.held.clear();
+    };
+  }, []);
+
+  /** Where a mouse event lands in the frame's own pixels — the picture is letterboxed inside the img box. */
+  const framePoint = (event: { clientX: number; clientY: number }): { x: number; y: number } | null => {
+    const img = image.current;
+    if (!img || !picture || picture.width === 0 || picture.height === 0) return null;
+    const box = img.getBoundingClientRect();
+    if (box.width === 0 || box.height === 0) return null;
+    const scale = Math.min(box.width / picture.width, box.height / picture.height);
+    const left = box.left + (box.width - picture.width * scale) / 2;
+    const top = box.top + (box.height - picture.height * scale) / 2;
+    return {
+      x: Math.max(0, Math.min(picture.width, Math.round((event.clientX - left) / scale))),
+      y: Math.max(0, Math.min(picture.height, Math.round((event.clientY - top) / scale))),
+    };
+  };
+
+  const onKeyDown = (event: ReactKeyboardEvent<HTMLDivElement>): void => {
+    if (!focused) return;
+    if (event.key === "Escape") {
+      event.preventDefault();
+      stage.current?.blur();
+      return;
+    }
+    event.preventDefault();
+    if (event.repeat) return;
+    input.current.held.add(event.key);
+    queue({ type: "key", key: event.key, action: "down" });
+  };
+  const onKeyUp = (event: ReactKeyboardEvent<HTMLDivElement>): void => {
+    if (!focused || event.key === "Escape") return;
+    event.preventDefault();
+    input.current.held.delete(event.key);
+    queue({ type: "key", key: event.key, action: "up" });
+  };
+  const onBlur = (): void => {
+    // A key still held when the keyboard comes back would drive the game until morning.
+    for (const key of input.current.held) queue({ type: "key", key, action: "up" });
+    input.current.held.clear();
+    setFocused(false);
+  };
+  const pointer = (event: ReactMouseEvent<HTMLDivElement>, action: "move" | "down" | "up"): void => {
+    if (!focused) return;
+    const at = framePoint(event);
+    if (!at) return;
+    if (action === "move") queue({ type: "pointer", ...at, action });
+    else queue({ type: "pointer", ...at, action, button: event.button === 2 ? "right" : event.button === 1 ? "middle" : "left" });
+  };
+  const onWheel = (event: ReactWheelEvent<HTMLDivElement>): void => {
+    if (!focused) return;
+    const at = framePoint(event);
+    if (at) queue({ type: "wheel", ...at, dx: event.deltaX, dy: event.deltaY });
+  };
+
+  const state = frame?.state ?? null;
+  const playing = state === "playing";
+  const status = frame?.status ?? UNITY_WORDS.frameWaiting;
+  const latency = latencyMs !== null ? UNITY_WORDS.latency.replace("{ms}", String(Math.round(latencyMs))) : null;
+  const sceneChoices = Array.from(new Set([...scenes.build, ...scenes.open, ...(currentScene ? [currentScene] : [])]));
+  const sceneValue = scene ?? currentScene ?? "";
+
+  return (
+    <div data-unity-stage={handle} data-unity-state={state ?? undefined} className="absolute inset-0 flex flex-col">
+      <div className="flex h-9 shrink-0 items-center gap-1.5 border-b border-line bg-canvas px-2">
+        <Button variant="accent" aria-label={UNITY_WORDS.play} disabled={busy} onClick={() => transport("play")}>{UNITY_WORDS.play}</Button>
+        <Button aria-label={UNITY_WORDS.pause} disabled={busy} onClick={() => transport("pause")}>{UNITY_WORDS.pause}</Button>
+        <Button aria-label={UNITY_WORDS.stop} disabled={busy} onClick={() => transport("stop")}>{UNITY_WORDS.stop}</Button>
