+/**
+ * An in-process fake of Unity's Pipeline HTTP server (Unity in the studio, work packages
+ * §3.6), in the shape of `fake-ollama.ts`: a real `node:http` server on loopback, bearer auth,
+ * the 503 settle gate, the descriptor file the studio discovers, a runtime server that appears
+ * on `editor_play`, and scripted answers for every command the studio's port and tools send.
+ *
+ * It is not a stub of our code: the editor manager does real HTTP, real descriptor polling and
+ * real retry against it. What it cannot tell us is whether a real Unity answers the same way —
+ * the wire shapes here are the ones the plan relies on (Appendix A), and a drift in the
+ * package fails a test here, not a night.
+ */
+import { appendFile, chmod, mkdir, rm, writeFile } from "node:fs/promises";
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import type { AddressInfo } from "node:net";
+import { randomBytes } from "node:crypto";
+import path from "node:path";
+import { encodePng, paintBitmap } from "../../src/main/unity-image.ts";
+
+export interface FakePipelineOptions {
+  root: string;
+  mode?: "editor" | "batchmode";
+  /** `POST /api/exec` answers 503 `{ busyReason: "settling" }` for this long after start. */
+  settleMs?: number;
+  compileErrors?: string[];
+  playThrows?: string | null;
+  state?: Record<string, unknown>;
+  cameras?: string[];
+  consoleErrors?: string[];
+  testResult?: { passed: number; failed: number; failures: string[] };
+  /** The pid the descriptor claims; the studio refuses any that is not its own child's. */
+  pid?: number;
+  unityVersion?: string;
+  token?: string;
+  /** Rewrite the descriptor's heartbeat every so often; null leaves it to the caller. */
+  heartbeatMs?: number | null;
+  /** Append every exec as a JSON line here, for a test on the other side of a process boundary. */
+  callLog?: string | null;
+}
+
+export interface FakePipelineCall {
+  command: string;
+  parameters: Record<string, unknown>;
+  at: number;
+  server: "editor" | "runtime";
+}
+
+export interface FakePipeline {
+  port: number;
+  runtimePort: number;
+  token: string;
+  descriptorPath: string;
+  runtimeDescriptorPath: string;
+  writeDescriptor(): Promise<void>;
+  heartbeat(): Promise<void>;
+  /** A new token in a fresh descriptor — what a restarted editor does; the old one gets 401. */
+  rotateToken(): Promise<void>;
+  close(): Promise<void>;
+  calls: FakePipelineCall[];
+  playing: () => boolean;
+  setCompileErrors(errors: string[]): void;
+  /** A modal in front of the editor: exec answers 503 `blocked_by_dialog` until it is cleared. */
+  setDialog(dialog: { title: string; message?: string } | null): void;
+  /** Stop heartbeating (the editor hung) without closing the server. */
+  freeze(): void;
+}
+
+/** Commands the fake will not run without `confirm: true` (or `dry_run`): what the gate must inject. */
+export const FAKE_PIPELINE_DESTRUCTIVE = [
+  "save_all",
+  "save_scene",
+  "create_gameobject",
+  "set_transform",
+  "add_component",
+  "set_component_properties",
+  "delete_gameobject",
+  "remove_component",
+  "delete_asset",
+  "move_asset",
+  "rename_asset",
+] as const;
+
+const CATALOGUE: Array<{ name: string; description: string }> = [
+  ["editor_play", "Enter Play mode."],
+  ["editor_stop", "Leave Play mode."],
+  ["editor_pause", "Toggle pause in Play mode."],
+  ["editor_status", "The editor's mode, scene and dirty flag."],
+  ["editor_focus", "Bring the editor window forward."],
+  ["set_autotick", "Keep the editor ticking without focus."],
+  ["capture_game_view", "A PNG of the Game view (source camera|screen)."],
+  ["capture_scene_view", "A PNG of the Scene view."],
+  ["screenshot", "Older capture form."],
+  ["get_console_logs", "Console entries by severity."],
+  ["clear_console", "Clear the console."],
+  ["recompile", "Recompile scripts."],
+  ["recompile_status", "Compile state and errors."],
+  ["run_tests", "Run tests (mode editor|playmode|all)."],
+  ["test_status", "The last test run."],
+  ["list_tests", "Every test."],
+  ["list_open_scenes", "Open scenes and the build list."],
+  ["open_scene", "Open a scene in Edit mode."],
+  ["save_scene", "Save the active scene."],
+  ["save_all", "Save every dirty scene and asset."],
+  ["get_scene_hierarchy", "Objects in the scene."],
+  ["create_gameobject", "Create a GameObject."],
+  ["find_gameobjects", "Find objects by name or tag."],
+  ["set_transform", "Move, rotate or scale an object."],
+  ["add_component", "Add a component."],
+  ["set_component_properties", "Set component fields."],
+  ["studio_state", "The bridge's state numbers."],
+  ["studio_seed", "Seed the game's random and fix the clock."],
+  ["studio_pause", "Pause the game's clock."],
+  ["studio_step", "Advance n fixed frames while paused."],
+  ["studio_look", "Mouse-look by a delta in pixels."],
+  ["studio_start", "Skip the title screen."],
+  ["studio_cameras", "Registered cameras."],
+  ["studio_camera", "Switch the capture camera."],
+  ["studio_ready", "Play-mode readiness."],
+  ["studio_demos", "Registered demos."],
+  ["studio_demo", "Run a demo."],
+  ["studio_render_stats", "Draw calls, triangles, frame time."],
+  ["simulate_key", "Simulate a key (runtime)."],
+  ["simulate_pointer", "Simulate the pointer (runtime)."],
+  ["set_timescale", "Time.timeScale (runtime)."],
+  ["eval", "Evaluate C# on the main thread."],
+  ["eval_file", "Evaluate a C# file."],
+  ["menu", "Run a menu item."],
+  ["build", "Build the player."],
+  ["quit", "Quit the editor."],
+  ["set_authoring_root", "Change the authoring root."],
+  ["add_scene_to_build", "Add a scene to the build list."],
+  ["remove_scene_from_build", "Remove a scene from the build list."],
+].map(([name, description]) => ({ name: name!, description: description! }));
+
+function readBody(req: IncomingMessage): Promise<string> {
+  return new Promise((resolve) => {
+    const chunks: Buffer[] = [];
+    req.on("data", (chunk: Buffer) => chunks.push(chunk));
+    req.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
+  });
+}
+
+function colourFor(...parts: string[]): [number, number, number] {
+  let h = 2166136261;
+  for (const ch of parts.join("|")) h = (h ^ ch.charCodeAt(0)) * 16777619;
+  h >>>= 0;
+  return [60 + (h & 0x7f), 60 + ((h >>> 8) & 0x7f), 60 + ((h >>> 16) & 0x7f)];
+}
+
+export async function startFakePipeline(options: FakePipelineOptions): Promise<FakePipeline> {
+  const root = path.resolve(options.root);
+  const startedAt = Date.now();
+  let token = options.token ?? randomBytes(12).toString("hex");
+  const mode = options.mode ?? "editor";
+  const pid = options.pid ?? process.pid;
+  const unityVersion = options.unityVersion ?? "6000.0.50f1";
+  const descriptorPath = path.join(root, "Library", "Pipeline", ".unity-pipeline-port");
+  // Measured 2026-09-11: the runtime server writes its descriptor at the project root.
+  const runtimeDescriptorPath = path.join(root, ".unity-pipeline-runtime-port");
+  const calls: FakePipelineCall[] = [];
+
+  // ── the editor's state ──
+  let playing = false;
+  let paused = false;
+  let playStartedAt = 0;
+  let pausedFrame = 0;
+  let stepped = 0;
+  let scene = "Assets/Scenes/Main.unity";
+  const buildScenes = ["Assets/Scenes/Main.unity"];
+  let dirty = false;
+  let compileErrors = [...(options.compileErrors ?? [])];
+  let compile: { status: string; errors: string[]; since: number } = { status: "up_to_date", errors: [], since: 0 };
+  let tests: { status: string; passed: number; failed: number; failures: string[]; since: number } = { status: "idle", passed: 0, failed: 0, failures: [], since: 0 };
+  const consoleLog: Array<{ at: number; level: string; message: string }> = (options.consoleErrors ?? []).map((message, i) => ({ at: startedAt - 1_000 + i, level: "error", message }));
+  const cameras = [...(options.cameras ?? ["default", "eye:here"])];
+  let camera = "default";
+  const demos = ["walk"];
+  let studioPaused = false;
+  let seed = 1;
+  let timescale = 1;
+  let autotick = true;
+  let dialog: { title: string; message?: string } | null = null;
+  const held = new Set<string>();
+  const player = { x: 0, y: 0, z: 0, yaw: 0 };
+  let objects = 2;
+  let frozen = false;
+
+  const frame = (): number => {
+    if (!playing) return 0;
+    if (paused) return pausedFrame;
+    return Math.floor(((Date.now() - playStartedAt) / 1000) * 60 * timescale) + stepped;
+  };
+  const settling = (): boolean => Date.now() - startedAt < (options.settleMs ?? 0);
+  const exceptions = (): number => (playing && options.playThrows ? 1 : 0);
+
+  const descriptor = () => ({ pid, port, projectPath: root, unityVersion, mode, evalToken: token, lastHeartbeat: new Date().toISOString(), capabilities: ["exec", "capture", "runtime"] });
+  const writeDescriptor = async (): Promise<void> => {
+    if (frozen) return;
+    await mkdir(path.dirname(descriptorPath), { recursive: true });
+    const tmp = `${descriptorPath}.tmp`;
+    await writeFile(tmp, JSON.stringify(descriptor()), { mode: 0o600 });
+    const fs = await import("node:fs/promises");
+    await fs.rename(tmp, descriptorPath);
+    await chmod(descriptorPath, 0o600).catch(() => {});
+  };
+  const writeRuntimeDescriptor = async (): Promise<void> => {
+    await mkdir(path.dirname(runtimeDescriptorPath), { recursive: true });
+    await writeFile(runtimeDescriptorPath, JSON.stringify({ pid, port: runtimePort, evalToken: token, lastHeartbeat: new Date().toISOString() }), { mode: 0o600 });
+  };
+
+  const capture = async (parameters: Record<string, unknown>, view: "game" | "scene"): Promise<{ status: number; body: unknown }> => {
+    const source = String(parameters.source ?? "camera");
+    if (view === "game" && source === "screen" && !playing) return { status: 400, body: { ok: false, error: "screen capture needs Play mode" } };
+    const width = Math.max(16, Math.min(4096, Number(parameters.width) || 1280));
+    const height = Math.max(16, Math.min(4096, Number(parameters.height) || 720));
+    const cam = String(parameters.camera ?? camera);
+    const png = encodePng(paintBitmap(width, height, colourFor(view, source, cam, playing ? "play" : "edit")));
+    let saved: string | null = null;
+    if (typeof parameters.save_path === "string" && parameters.save_path) {
+      const file = path.isAbsolute(parameters.save_path) ? path.resolve(parameters.save_path) : path.resolve(root, parameters.save_path);
+      if (!file.startsWith(root + path.sep)) return { status: 400, body: { ok: false, error: "save_path must be inside the project" } };
+      await mkdir(path.dirname(file), { recursive: true });
+      await writeFile(file, png);
+      saved = path.relative(root, file);
+    }
+    const inline = parameters.include_inline_image === true || parameters.include_inline_image === "true";
+    return { status: 200, body: { ok: true, result: { width, height, source, camera: cam, view, ...(saved ? { path: saved } : {}), ...(inline ? { image: png.toString("base64") } : {}) } } };
+  };
+
+  const ok = (result: unknown): { status: number; body: unknown } => ({ status: 200, body: { ok: true, result } });
+  const bad = (error: string, status = 400): { status: number; body: unknown } => ({ status, body: { ok: false, error } });
+
+  const handle = async (command: string, parameters: Record<string, unknown>, server: "editor" | "runtime"): Promise<{ status: number; body: unknown }> => {
+    if ((FAKE_PIPELINE_DESTRUCTIVE as readonly string[]).includes(command)) {
+      if (parameters.dry_run === true || parameters.dry_run === "true") return ok({ dryRun: true, command });
+      if (parameters.confirm !== true && parameters.confirm !== "true") return bad(`${command} needs confirm=true`);
+    }
+    switch (command) {
+      case "editor_play": {
+        if (!playing) {
+          playing = true;
+          paused = false;
+          stepped = 0;
+          playStartedAt = Date.now();
+          await writeRuntimeDescriptor();
+          if (options.playThrows) consoleLog.push({ at: Date.now(), level: "error", message: `Exception: ${options.playThrows}` });
+        }
+        return ok({ playing: true });
+      }
+      case "editor_stop": {
+        playing = false;
+        paused = false;
+        held.clear();
+        await rm(runtimeDescriptorPath, { force: true });
+        return ok({ playing: false });
+      }
+      case "editor_pause": {
+        if (!playing) return bad("not in Play mode");
+        if (!paused) pausedFrame = frame();
+        else {
+          playStartedAt = Date.now();
+          stepped = pausedFrame;
+        }
+        paused = !paused;
+        return ok({ paused, frame: frame() });
+      }
+      case "editor_status":
+        return ok({ playing, paused, compiling: compile.status === "compiling", scene, dirty, frame: frame(), mode, unityVersion });
+      case "editor_focus":
+        return ok({ focused: true });
+      case "set_autotick":
+        autotick = parameters.enabled !== false && parameters.enabled !== "false";
+        return ok({ autotick });
+      case "capture_game_view":
+      case "screenshot":
+        return capture(parameters, "game");
+      case "capture_scene_view":
+        return capture(parameters, "scene");
+      case "get_console_logs": {
+        const severity = String(parameters.severity ?? "all");
+        const since = Number(parameters.since) || 0;
+        return ok({ entries: consoleLog.filter((e) => e.at >= since && (severity === "all" || e.level === severity)) });
+      }
+      case "clear_console":
+        consoleLog.length = 0;
+        return ok({ cleared: true });
+      case "recompile":
+        compile = { status: "compiling", errors: [], since: Date.now() };
+        return ok({ status: "compiling" });
+      case "recompile_status": {
+        if (compile.status === "compiling" && Date.now() - compile.since > 60) {
+          compile = { status: compileErrors.length ? "completed" : "up_to_date", errors: [...compileErrors], since: compile.since };
+          for (const error of compileErrors) consoleLog.push({ at: Date.now(), level: "error", message: error });
+        }
+        return ok({ status: compile.status, errors: compile.errors });
+      }
+      case "run_tests":
+        tests = { status: "running", passed: 0, failed: 0, failures: [], since: Date.now() };
+        return ok({ status: "running", mode: String(parameters.mode ?? "editor"), filter: parameters.filter ?? null });
+      case "test_status": {
+        if (tests.status === "running" && Date.now() - tests.since > 80) {
+          const result = options.testResult ?? { passed: 1, failed: 0, failures: [] };
+          tests = { status: "completed", ...result, since: tests.since };
+        }
+        return ok({ status: tests.status, passed: tests.passed, failed: tests.failed, failures: tests.failures, ran: tests.passed + tests.failed });
+      }
+      case "list_tests":
+        return ok({ tests: ["StudioTests.Smoke"] });
+      case "list_open_scenes":
+        return ok({ scenes: [{ path: scene, name: path.basename(scene, ".unity"), isActive: true, isDirty: dirty }], build: buildScenes, active: scene });
+      case "open_scene": {
+        if (playing) return bad("mutations are blocked in Play mode");
+        const target = String(parameters.path ?? "");
+        if (!target.endsWith(".unity")) return bad(`not a scene: ${target}`);
+        scene = target;
+        dirty = false;
+        return ok({ scene });
+      }
+      case "save_scene":
+      case "save_all":
+        dirty = false;
+        return ok({ saved: [scene] });
+      case "get_scene_hierarchy":
+        return ok({ scene, objects: [{ name: "Main Camera" }, { name: "Player" }] });
+      case "create_gameobject":
+        if (playing) return bad("mutations are blocked in Play mode");
+        dirty = true;
+        objects++;
+        return ok({ name: String(parameters.name ?? "GameObject"), id: objects });
+      case "find_gameobjects":
+        return ok({ objects: [] });
+      case "set_transform":
+      case "add_component":
+      case "set_component_properties":
+        if (playing) return bad("mutations are blocked in Play mode");
+        dirty = true;
+        return ok({ changed: true });
+      case "studio_state":
+        return ok({
+          ...(options.state ?? {}),
+          version: 1,
+          seed,
+          frame: frame(),
+          time: frame() / 60,
+          running: playing && !studioPaused,
+          player: { ...player },
+          __render: { drawCalls: playing ? 120 : 0, triangles: playing ? 4_000 : 0 },
+        });
+      case "studio_seed":
+        seed = Number(parameters.seed) || 1;
+        player.x = player.y = player.z = player.yaw = 0;
+        return ok({ seed });
+      case "studio_pause":
+        studioPaused = !studioPaused;
+        return ok({ paused: studioPaused });
+      case "studio_step": {
+        const frames = Math.max(1, Number(parameters.frames) || 1);
+        stepped += frames;
+        if (paused) pausedFrame += frames;
+        if ([...held].some((k) => k === "w")) player.x += frames / 60;
+        return ok({ frame: frame(), stepped: frames });
+      }
+      case "studio_look":
+        player.yaw += (Number(parameters.dx) || 0) * 0.1;
+        return ok({ ok: true, dx: Number(parameters.dx) || 0, dy: Number(parameters.dy) || 0 });
+      case "studio_start":
+        return ok({ started: true });
+      case "studio_cameras":
+        return ok({ cameras: [...cameras] });
+      case "studio_camera": {
+        const name = String(parameters.name ?? "");
+        if (!cameras.includes(name)) return ok({ ok: false, reason: `camera "${name}" is not registered`, available: [...cameras] });
+        camera = name;
+        return ok({ ok: true, camera });
+      }
+      case "studio_ready":
+        // Measured shape: `paused` is "the bridge holds the clock" (true while stepping too), `stepping` the frames left to run.
+        return ok({ playing, frame: frame(), paused: studioPaused, stepping: 0, exceptions: exceptions(), ...(options.playThrows && playing ? { firstException: options.playThrows } : {}), firstFrameMs: playing ? 16 : null });
+      case "studio_demos":
+        return ok({ demos: [...demos] });
+      case "studio_demo":
+        return ok({ ok: demos.includes(String(parameters.name ?? "")) });
+      case "studio_render_stats":
+        return ok({ drawCalls: playing ? 120 : 0, triangles: playing ? 4_000 : 0, frameTime: 16.6 });
+      case "simulate_key": {
+        const key = String(parameters.key ?? "");
+        if (!key) return bad("simulate_key needs a key");
+        if (parameters.action === "down") held.add(key);
+        if (parameters.action === "up") held.delete(key);
+        if (key === "w" && parameters.action === "up") player.x += 1;
+        return ok({ key, action: parameters.action ?? "press", server });
+      }
+      case "simulate_pointer": {
+        if (parameters.action === "move" && typeof parameters.deltaX === "number") player.yaw += parameters.deltaX * 0.01;
+        return ok({ x: parameters.x, y: parameters.y, action: parameters.action ?? "click", server });
+      }
+      case "set_timescale":
+        timescale = Number(parameters.scale ?? parameters.timescale) || 1;
+        return ok({ timescale });
+      case "set_target_framerate":
+        return ok({ fps: Number(parameters.fps) || 60 });
+      case "runtime_status":
+        return ok({ playing, frame: frame() });
+      case "eval":
+      case "eval_file":
+      case "menu":
+      case "build":
+      case "quit":
+      case "set_authoring_root":
+      case "add_scene_to_build":
+      case "remove_scene_from_build":
+        // Answered as if it worked: the gate on the studio side is what has to stop these.
+        return ok({ ran: command, note: "the fake ran it — the gate must never let it here" });
+      default:
+        return bad(`unknown command: ${command}`, 404);
+    }
+  };
+
+  const serve = (server: "editor" | "runtime") => async (req: IncomingMessage, res: ServerResponse): Promise<void> => {
+    const url = req.url ?? "/";
+    const json = (status: number, value: unknown): void => {
+      res.writeHead(status, { "content-type": "application/json" });
+      res.end(JSON.stringify(value));
+    };
+    if (req.method === "GET") {
+      if (server === "editor" && url === "/api/status") return json(200, { status: settling() ? "settling" : dialog ? "blocked_by_dialog" : "ready", mode, playing, unityVersion, pid, uptimeMs: Date.now() - startedAt });
+      if (server === "editor" && url === "/api/commands") return json(200, { commands: CATALOGUE });
+      if (server === "editor" && url === "/api/dialog") return json(200, { dialog });
+      if (server === "editor" && url === "/api/progress") return json(200, { progress: null });
+      if (server === "runtime" && url === "/api/status") return json(200, { status: "ready", playing, frame: frame() });
+      return json(404, { ok: false, error: `no ${url}` });
+    }
+    if (req.method !== "POST" || url !== "/api/exec") return json(404, { ok: false, error: `no ${req.method} ${url}` });
+    const auth = String(req.headers.authorization ?? "");
+    if (auth !== `Bearer ${token}`) return json(401, { ok: false, error: "unauthorized" });
+    const raw = await readBody(req);
+    let body: { command?: unknown; parameters?: unknown } = {};
+    try {
+      body = JSON.parse(raw) as typeof body;
+    } catch {
+      return json(400, { ok: false, error: "bad json" });
+    }
+    const command = String(body.command ?? "");
+    const parameters = body.parameters && typeof body.parameters === "object" ? (body.parameters as Record<string, unknown>) : {};
+    calls.push({ command, parameters, at: Date.now(), server });
+    if (options.callLog) await appendFile(options.callLog, `${JSON.stringify({ at: Date.now(), server, command, parameters })}\n`).catch(() => {});
+    if (server === "editor" && settling()) return json(503, { ok: false, busyReason: "settling", error: "the editor is settling" });
+    if (server === "editor" && dialog) return json(503, { ok: false, busyReason: "blocked_by_dialog", error: `blocked by dialog: ${dialog.title}` });
+    if (server === "runtime" && !["simulate_key", "simulate_pointer", "set_timescale", "set_target_framerate", "runtime_status", "console"].includes(command)) {
+      return json(404, { ok: false, error: `the runtime server has no ${command}` });
+    }
+    const answer = await handle(command, parameters, server);
+    return json(answer.status, answer.body);
+  };
+
+  const editorServer: Server = createServer((req, res) => void serve("editor")(req, res));
+  const runtimeServer: Server = createServer((req, res) => void serve("runtime")(req, res));
+  await new Promise<void>((resolve) => editorServer.listen(0, "127.0.0.1", resolve));
+  await new Promise<void>((resolve) => runtimeServer.listen(0, "127.0.0.1", resolve));
+  const port = (editorServer.address() as AddressInfo).port;
+  const runtimePort = (runtimeServer.address() as AddressInfo).port;
+  await writeDescriptor();
+  let beat: NodeJS.Timeout | null = null;
+  if (options.heartbeatMs !== null && options.heartbeatMs !== undefined) {
+    beat = setInterval(() => void writeDescriptor().catch(() => {}), options.heartbeatMs);
+    beat.unref?.();
+  }
+
+  const closeServer = (server: Server): Promise<void> =>
+    new Promise((resolve) => {
+      server.closeAllConnections?.();
+      server.close(() => resolve());
+    });
+
+  return {
+    port,
+    runtimePort,
+    get token() {
+      return token;
+    },
+    descriptorPath,
+    runtimeDescriptorPath,
+    writeDescriptor,
+    heartbeat: writeDescriptor,
+    rotateToken: async () => {
+      token = randomBytes(12).toString("hex");
+      await writeDescriptor();
+    },
+    close: async () => {
+      if (beat) clearInterval(beat);
+      beat = null;
+      frozen = true;
+      await rm(descriptorPath, { force: true }).catch(() => {});
+      await rm(runtimeDescriptorPath, { force: true }).catch(() => {});
+      await Promise.all([closeServer(editorServer), closeServer(runtimeServer)]);
+    },
+    calls,
+    playing: () => playing,
+    setCompileErrors: (errors) => {
+      compileErrors = [...errors];
+    },
+    setDialog: (next) => {
+      dialog = next;
+    },
+    freeze: () => {
+      frozen = true;
+      if (beat) clearInterval(beat);
+      beat = null;
+    },
+  };
+}
diff --git a/tests/helpers/fake-unity-cli.ts b/tests/helpers/fake-unity-cli.ts
new file mode 100644
index 0000000..80cfc9b
--- /dev/null
+++ b/tests/helpers/fake-unity-cli.ts
@@ -0,0 +1,128 @@
+/**
+ * A fake `unity` CLI for the conformance suites (Unity in the studio, contract §3.6). No Unity
+ * is installed on the machine that runs these tests and none may be: a shell script stands in
+ * for the binary and answers the handful of commands the studio's own side speaks — version,
+ * installed editors, sign-in status, licence, the browser sign-in as ndjson lines, the editor
+ * install as ndjson progress (refused without `--accept-eula`), and `pipeline install`, which
+ * edits `Packages/manifest.json` in its cwd the way the real one does. Every invocation's argv
+ * is appended to `<dir>/calls.log` so a test can assert what was asked, in what order.
+ *
+ * `fakeUnityProbe` is the in-process twin for `detectUnity`'s `probe` seam: the same JSON
+ * shapes, no process.
+ */
+import { chmod, mkdir, readFile, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { UNITY_PIN } from "../../src/substrate/unity.ts";
+
+export interface FakeUnityCliOptions {
+  version?: string;
+  editors?: Array<{ version: string; path: string }>;
+  signedIn?: { name: string; email: string } | false;
+  licence?: { kind: string; active: boolean } | null;
+  installFails?: string;
+}
+
+const DEFAULT_VERSION = "1.2.0-beta.3";
+
+/** The envelope every `--json` answer of the real CLI (1.0.0-beta.8) wears. */
+function envelope(command: string, data: unknown, success = true): string {
+  return JSON.stringify({ success, command, data, errors: [], warnings: [] });
+}
+
+/**
+ * The shapes measured on the real CLI on 2026-09-11 (the handoff's §4): editors rows carry
+ * `location`, not `path`; `auth status` says `loggedIn` and exits 3 when signed out; `license
+ * status` says `active` with `licenses[{ product, type }]`. `licence: null` is a CLI that says
+ * nothing usable about the licence (an empty `data`), which is what spike S6 leaves open.
+ */
+function answers(options: FakeUnityCliOptions): { version: string; editors: string; auth: string; authExit: number; licence: string } {
+  const editors = (options.editors ?? []).map((e) => ({ version: e.version, alias: e.version.replace(/^6000\./, "6."), architecture: "arm64", location: e.path, modules: "", default: false }));
+  const auth = options.signedIn
+    ? { loggedIn: true, sessionState: "active", mode: "user", credentialSource: "keychain", account: { name: options.signedIn.name, email: options.signedIn.email } }
+    : { loggedIn: false, sessionState: "none", mode: "none", credentialSource: "none", account: null };
+  const licence = options.licence
+    ? { active: options.licence.active, signedIn: Boolean(options.signedIn), authMode: options.signedIn ? "user" : "none", licenses: [{ product: options.licence.kind, type: "ULF", organization: "", expires: "" }] }
+    : {};
+  return { version: options.version ?? DEFAULT_VERSION, editors: envelope("editors", editors), auth: envelope("auth", auth), authExit: options.signedIn ? 0 : 3, licence: envelope("license", licence) };
+}
+
+/** Single-quote a string for /bin/sh. */
+const sq = (text: string): string => `'${text.replace(/'/g, "'\\''")}'`;
+
+/**
+ * Writes an executable shell script `unity` under `dir`; answers --version, editors --installed
+ * --json, auth status --json, license --json, auth login (ndjson lines, then exit 0), install <v>
+ * --accept-eula (ndjson progress; refuses without the flag), pipeline install (adds
+ * com.unity.pipeline to Packages/manifest.json in cwd). Records every argv line to `<dir>/calls.log`.
+ */
+export async function fakeUnityCli(dir: string, options: FakeUnityCliOptions = {}): Promise<{ binary: string; calls: () => Promise<string[][]> }> {
+  await mkdir(dir, { recursive: true });
+  const binary = path.join(dir, "unity");
+  const log = path.join(dir, "calls.log");
+  const a = answers(options);
+  const name = options.signedIn ? options.signedIn.name : "nobody";
+  const pipelineJs = [
+    "const fs=require('fs');const p='Packages/manifest.json';",
+    "const m=JSON.parse(fs.readFileSync(p,'utf8'));m.dependencies=m.dependencies||{};",
+    `m.dependencies[${JSON.stringify(UNITY_PIN.pipelinePackage)}]=${JSON.stringify(UNITY_PIN.pipelineVersion)};`,
+    "fs.writeFileSync(p,JSON.stringify(m,null,2)+'\\n');",
+    `console.log(JSON.stringify({type:'done',message:'added ${UNITY_PIN.pipelinePackage}'}));`,
+  ].join("");
+  const script = [
+    "#!/bin/sh",
+    "# fake unity CLI — tests/helpers/fake-unity-cli.ts",
+    `{ for a in "$@"; do printf '%s\\t' "$a"; done; printf '\\n'; } >> ${sq(log)}`,
+    'case "$1" in',
+    `  --version) echo ${sq(a.version)}; exit 0 ;;`,
+    `  editors) echo ${sq(a.editors)}; exit 0 ;;`,
+    "  auth)",
+    `    if [ "$2" = "status" ]; then echo ${sq(a.auth)}; exit ${a.authExit}; fi`,
+    '    if [ "$2" = "login" ]; then',
+    `      echo '{"type":"url","url":"https://id.unity.com/fake-sign-in","message":"Open https://id.unity.com/fake-sign-in in your browser"}'`,
+    `      echo '{"type":"status","message":"Waiting for the browser…"}'`,
+    `      echo ${sq(JSON.stringify({ type: "done", message: `Signed in as ${name}`, user: options.signedIn || null }))}`,
+    "      exit 0",
+    "    fi ;;",
+    `  license) echo ${sq(a.licence)}; exit 0 ;;`,
+    "  install)",
+    '    ACCEPT=0; for a in "$@"; do [ "$a" = "--accept-eula" ] && ACCEPT=1; done',
+    `    if [ "$ACCEPT" = "0" ]; then echo '{"type":"error","message":"the Editor Software Terms must be accepted: pass --accept-eula"}' >&2; exit 2; fi`,
+    options.installFails ? `    echo ${sq(JSON.stringify({ type: "error", message: options.installFails }))} >&2; exit 1` : "",
+    `    echo "{\\"type\\":\\"progress\\",\\"progress\\":0,\\"message\\":\\"Downloading Unity $2\\"}"`,
+    `    echo "{\\"type\\":\\"progress\\",\\"progress\\":0.5,\\"message\\":\\"Downloading Unity $2\\"}"`,
+    `    echo "{\\"type\\":\\"progress\\",\\"progress\\":1,\\"message\\":\\"Installing Unity $2\\"}"`,
+    `    echo "{\\"type\\":\\"done\\",\\"message\\":\\"Installed Unity $2\\"}"`,
+    "    exit 0 ;;",
+    "  pipeline)",
+    `    if [ "$2" = "install" ]; then ${sq(process.execPath)} -e ${sq(pipelineJs)}; exit $?; fi ;;`,
+    "esac",
+    'echo "unknown command: $*" >&2; exit 2',
+    "",
+  ].join("\n");
+  await writeFile(binary, script);
+  await chmod(binary, 0o755);
+  return {
+    binary,
+    calls: async () => {
+      const text = await readFile(log, "utf8").catch(() => "");
+      return text
+        .split("\n")
+        .filter((line) => line.length)
+        .map((line) => line.split("\t").slice(0, -1));
+    },
+  };
+}
+
+/** An in-process probe for detectUnity tests: answers only for `binary`, null for anything else. */
+export function fakeUnityProbe(binary: string, options: FakeUnityCliOptions = {}): (binary: string, args: string[]) => Promise<string | null> {
+  const a = answers(options);
+  return async (asked, args) => {
+    if (asked !== binary) return null;
+    const line = args.join(" ");
+    if (line === "--version") return a.version;
+    if (line === "editors --installed --json") return a.editors;
+    if (line === "auth status --json") return a.auth;
+    if (line === "license status --json" || line === "license --json") return a.licence;
+    return null;
+  };
+}
diff --git a/tests/helpers/fake-unity-editor.ts b/tests/helpers/fake-unity-editor.ts
new file mode 100644
index 0000000..fd91eaa
--- /dev/null
+++ b/tests/helpers/fake-unity-editor.ts
@@ -0,0 +1,169 @@
+/**
+ * The fake Unity editor as a process (Unity in the studio, work packages §3.6): a shell
+ * wrapper the studio spawns exactly like `Unity.app/Contents/MacOS/Unity`, which `exec`s node
+ * on this module. The process starts a fake Pipeline server on the project it was given,
+ * writes `Library/Pipeline/.unity-pipeline-port` with its own pid, heartbeats it every second,
+ * logs `{ start, end, argv, pid }` to `Library/fake-unity-log.jsonl` (one line at start with
+ * `end: null`, one at exit), records every exec to `Library/fake-unity-calls.jsonl`, and
+ * deletes the descriptor on SIGTERM.
+ *
+ * Scripted behaviour comes from files in the project, so a test writes the night it wants:
+ *   Assets/.fake-compile-errors   one `error CS…` line per line
+ *   Assets/.fake-play-throws      the exception `studio_ready` reports on play
+ *   Assets/.fake-crash            exit 1 after settling, leaving a stale descriptor behind;
+ *                                 the file is consumed, so the studio's one restart succeeds
+ *   Assets/.fake-settle-ms        how long `/api/exec` answers 503 settling
+ *
+ * The module is inert when imported: it runs only when its argv carries `--fake-unity-editor`
+ * (what the wrapper passes) or `FAKE_UNITY_EDITOR=1` is in the environment.
+ */
+import { appendFile, chmod, mkdir, readFile, rm, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { startFakePipeline } from "./fake-pipeline.ts";
+
+export const FAKE_UNITY_LOG = path.join("Library", "fake-unity-log.jsonl");
+export const FAKE_UNITY_CALLS = path.join("Library", "fake-unity-calls.jsonl");
+
+export interface FakeEditorInvocation {
+  start: number;
+  end: number | null;
+  argv: string[];
+  pid: number;
+}
+
+/** Writes an executable shell wrapper at `binary` that runs this module as the editor process. */
+export async function fakeUnityEditorBinary(binary: string): Promise<string> {
+  const module = fileURLToPath(import.meta.url);
+  await mkdir(path.dirname(binary), { recursive: true });
+  const script = [
+    "#!/bin/sh",
+    "# A fake Unity editor for the studio's tests: node on tests/helpers/fake-unity-editor.ts.",
+    "export ELECTRON_RUN_AS_NODE=1",
+    `exec ${JSON.stringify(process.execPath)} ${JSON.stringify(module)} --fake-unity-editor "$@"`,
+    "",
+  ].join("\n");
+  await writeFile(binary, script);
+  await chmod(binary, 0o755);
+  return binary;
+}
+
+/** The invocation log, one row per process, with `end` from the exit line when there is one. */
+export async function fakeEditorInvocations(projectRoot: string): Promise<FakeEditorInvocation[]> {
+  const text = await readFile(path.join(projectRoot, FAKE_UNITY_LOG), "utf8").catch(() => "");
+  const rows = new Map<string, FakeEditorInvocation>();
+  for (const line of text.split("\n")) {
+    if (!line.trim()) continue;
+    try {
+      const row = JSON.parse(line) as FakeEditorInvocation;
+      const key = `${row.pid}:${row.start}`;
+      const previous = rows.get(key);
+      rows.set(key, { ...(previous ?? {}), ...row, end: row.end ?? previous?.end ?? null });
+    } catch {
+      /* a half-written line */
+    }
+  }
+  return [...rows.values()].sort((a, b) => a.start - b.start);
+}
+
+/** Every exec the fake server on this project answered, across every process that ran on it. */
+export async function fakeEditorCalls(projectRoot: string): Promise<Array<{ at: number; server: "editor" | "runtime"; command: string; parameters: Record<string, unknown> }>> {
+  const text = await readFile(path.join(projectRoot, FAKE_UNITY_CALLS), "utf8").catch(() => "");
+  const out: Array<{ at: number; server: "editor" | "runtime"; command: string; parameters: Record<string, unknown> }> = [];
+  for (const line of text.split("\n")) {
+    if (!line.trim()) continue;
+    try {
+      out.push(JSON.parse(line));
+    } catch {
+      /* a half-written line */
+    }
+  }
+  return out;
+}
+
+/** Do two invocations overlap in time? An open one (`end: null`) overlaps anything after its start. */
+export function invocationsOverlap(a: FakeEditorInvocation, b: FakeEditorInvocation): boolean {
+  const aEnd = a.end ?? Number.POSITIVE_INFINITY;
+  const bEnd = b.end ?? Number.POSITIVE_INFINITY;
+  return a.start < bEnd && b.start < aEnd;
+}
+
+async function linesOf(file: string): Promise<string[]> {
+  const text = await readFile(file, "utf8").catch(() => "");
+  return text
+    .split("\n")
+    .map((s) => s.trim())
+    .filter(Boolean);
+}
+
+async function main(): Promise<void> {
+  const argv = process.argv.slice(2).filter((a) => a !== "--fake-unity-editor");
+  const arg = (flag: string): string | undefined => {
+    const at = argv.indexOf(flag);
+    return at >= 0 ? argv[at + 1] : undefined;
+  };
+  const root = arg("-projectPath");
+  const logFile = arg("-logFile");
+  if (!root) {
+    process.stderr.write("fake unity: -projectPath is required\n");
+    process.exit(2);
+  }
+  const start = Date.now();
+  await mkdir(path.join(root, "Library"), { recursive: true });
+  const logLine = (end: number | null): Promise<void> => appendFile(path.join(root, FAKE_UNITY_LOG), `${JSON.stringify({ start, end, argv, pid: process.pid })}\n`);
+  await logLine(null);
+  if (logFile) {
+    await mkdir(path.dirname(logFile), { recursive: true });
+    await appendFile(logFile, `fake unity ${process.pid} started ${new Date(start).toISOString()}: ${argv.join(" ")}\n`);
+  }
+  const assets = path.join(root, "Assets");
+  const compileErrors = await linesOf(path.join(assets, ".fake-compile-errors"));
+  const playThrows = (await linesOf(path.join(assets, ".fake-play-throws")))[0] ?? null;
+  const crashFile = path.join(assets, ".fake-crash");
+  const crash = await stat(crashFile).then(() => true, () => false);
+  const settleMs = Number((await linesOf(path.join(assets, ".fake-settle-ms")))[0] ?? 0) || 0;
+  const pipeline = await startFakePipeline({
+    root,
+    mode: argv.includes("-batchmode") ? "batchmode" : "editor",
+    settleMs,
+    compileErrors,
+    playThrows,
+    pid: process.pid,
+    heartbeatMs: 1_000,
+    callLog: path.join(root, FAKE_UNITY_CALLS),
+    unityVersion: process.env.FAKE_UNITY_VERSION ?? "6000.0.50f1",
+  });
+  let ending = false;
+  const finish = async (code: number): Promise<void> => {
+    if (ending) return;
+    ending = true;
+    await pipeline.close().catch(() => {});
+    await logLine(Date.now()).catch(() => {});
+    if (logFile) await appendFile(logFile, `fake unity ${process.pid} exiting ${code}\n`).catch(() => {});
+    process.exit(code);
+  };
+  process.on("SIGTERM", () => void finish(0));
+  process.on("SIGINT", () => void finish(0));
+  process.on("SIGHUP", () => void finish(0));
+  if (crash) {
+    setTimeout(() => {
+      void (async () => {
+        // A crash leaves its descriptor behind, the way a killed editor does; the file is
+        // consumed so the studio's one automatic restart comes up clean.
+        await rm(crashFile, { force: true }).catch(() => {});
+        await logLine(Date.now()).catch(() => {});
+        if (logFile) await appendFile(logFile, `fake unity ${process.pid} crashing\n`).catch(() => {});
+        process.exit(1);
+      })();
+    }, settleMs + 300).unref?.();
+  }
+  // Stay alive until told otherwise.
+  setInterval(() => {}, 60_000);
+}
+
+if (process.argv.includes("--fake-unity-editor") || process.env.FAKE_UNITY_EDITOR === "1") {
+  void main().catch((err) => {
+    process.stderr.write(`fake unity failed: ${String((err as Error)?.stack ?? err)}\n`);
+    process.exit(1);
+  });
+}
