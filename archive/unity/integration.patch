+  }
+
+  /**
+   * `studio_step n` returns at once and the bridge counts the frames down in Update (measured
+   * 2026-09-11: a 58-frame step answered before 5 of them had run, so the play script's key-up
+   * landed mid-step and the player moved 0.42 m instead of 4.8). The browser shim's `step(ms)`
+   * runs its frames before answering, and the seed relies on that, so the port waits here: for
+   * the frame counter to reach the target, or for the bridge to have paused again.
+   */
+  async #step(frames: number, timeoutMs = 30_000): Promise<Record<string, unknown>> {
+    const before = (await this.frameNumber()) ?? this.#lastFrame ?? 0;
+    const kicked = await this.#exec("studio_step", { frames }, 30_000);
+    if (!kicked.ok) return { ok: false, reason: kicked.error ?? "studio_step failed" };
+    const target = before + frames;
+    const deadline = Date.now() + timeoutMs;
+    let frame = before;
+    let paused = false;
+    while (Date.now() < deadline) {
+      const ready = await this.#exec("studio_ready", {}, 5_000);
+      const r = record(ready.result);
+      frame = num(r?.frame) ?? frame;
+      paused = r?.paused === true;
+      // `paused` is "the bridge holds the clock", true while it is stepping too; `stepping` is what
+      // is left to run (measured: breaking on `paused` alone stopped 15 frames into a 48-frame step).
+      const stepping = num(r?.stepping);
+      if (frame >= target || (stepping === 0 && frame > before)) break;
