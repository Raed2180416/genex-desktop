@@ -0,0 +1,217 @@
+/**
+ * "Install the Unity CLI" (Unity in the studio, owner decision D2): the one network call the
+ * Unity page makes on its own, on the user's click, from the main process — never from a
+ * builder. Unity does not publish a versioned binary the studio could pin by checksum (spike
+ * S6 decides; until then the fallback in the plan §3.1 is what runs here): the studio fetches
+ * Unity's install script from the pinned CDN URL, runs it with the channel fixed and the
+ * install directory forced into `<userData>/tools`, checks that a `unity` binary landed
+ * there, asks it for its version and writes that down beside it. Nothing in /usr/local or
+ * /Applications changes. Cancel kills the script; every failure is one sentence the page
+ * can show.
+ *
+ * `runLines` is also the default `run` seam for the other setup steps (unity-setup.ts): one
+ * child process, both output streams split into lines, resolved on exit, killed on abort.
+ */
+import { spawn } from "node:child_process";
+import { createHash } from "node:crypto";
+import { createWriteStream } from "node:fs";
+import { chmod, mkdir, rename, rm, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { UNITY_PIN, parseCliVersion, studioUnityCli, studioUnityCliRecord, unityCliEnv } from "../substrate/unity.ts";
+import type { UnitySetupView } from "../substrate/unity-types.ts";
+import type { SetupOptions } from "./unity-setup.ts";
+
+type RunSeam = NonNullable<SetupOptions["run"]>;
+type FetchSeam = NonNullable<SetupOptions["fetch"]>;
+
+/** What the studio writes to `<userData>/tools/unity-cli.json` after an install. */
+export interface UnityCliRecord {
+  version: string;
+  channel: string;
+  /** The channel manifest the version came from. */
+  manifest: string;
+  /** The binary's URL and the sha256 the manifest promised (and the download matched). */
+  url: string;
+  sha256: string;
+  binary: string;
+  installedAt: string;
+}
+
+/** Longest line the page is asked to show. */
+const LINE_MAX = 200;
+
+/**
+ * Spawn a process and hand every line of stdout and stderr to `onLine`, in order of arrival.
+ * Resolves with the exit code; rejects when the process cannot start. An abort sends SIGTERM
+ * and, three seconds later, SIGKILL — the caller reads `signal.aborted` to say "cancelled".
+ */
+export function runLines(file: string, args: string[], opts: { cwd?: string; env?: NodeJS.ProcessEnv; signal: AbortSignal; onLine: (line: string) => void }): Promise<{ code: number }> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(file, args, { cwd: opts.cwd, env: opts.env ?? process.env, stdio: ["ignore", "pipe", "pipe"] });
+    const pending = { out: "", err: "" };
+    const feed = (key: "out" | "err", chunk: Buffer): void => {
+      pending[key] += chunk.toString("utf8");
+      let at: number;
+      while ((at = pending[key].indexOf("\n")) >= 0) {
+        const line = pending[key].slice(0, at).replace(/\r$/, "");
+        pending[key] = pending[key].slice(at + 1);
+        if (line.trim()) opts.onLine(line);
+      }
+    };
+    child.stdout?.on("data", (chunk: Buffer) => feed("out", chunk));
+    child.stderr?.on("data", (chunk: Buffer) => feed("err", chunk));
+    let killTimer: NodeJS.Timeout | null = null;
+    const onAbort = (): void => {
+      child.kill("SIGTERM");
+      killTimer = setTimeout(() => child.kill("SIGKILL"), 3_000);
+      killTimer.unref();
+    };
+    if (opts.signal.aborted) onAbort();
+    else opts.signal.addEventListener("abort", onAbort, { once: true });
+    const finish = (): void => {
+      opts.signal.removeEventListener("abort", onAbort);
+      if (killTimer) clearTimeout(killTimer);
+    };
+    child.once("error", (err) => {
+      finish();
+      reject(err);
+    });
+    child.once("close", (code) => {
+      for (const key of ["out", "err"] as const) if (pending[key].trim()) opts.onLine(pending[key].replace(/\r?\n?$/, ""));
+      finish();
+      resolve({ code: code ?? 1 });
+    });
+  });
+}
+
+/** Read a small response body to a string; the install script is a few kilobytes. */
+async function readText(body: ReadableStream<Uint8Array>, signal: AbortSignal): Promise<string> {
+  const reader = body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    if (signal.aborted) throw new Error("cancelled");
+    chunks.push(value);
+    total += value.length;
+    if (total > 4 * 1024 * 1024) throw new Error("Unity's install script is over 4 MB — not the script the studio expected");
+  }
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+/** Run `<binary> --version` through the seam and read the version off whatever it printed. */
+async function cliVersionOf(run: RunSeam, binary: string, signal: AbortSignal): Promise<string | null> {
+  const lines: string[] = [];
+  const { code } = await run(binary, ["--version"], { env: unityCliEnv(), signal, onLine: (line) => lines.push(line) }).catch(() => ({ code: 1 }));
+  if (code !== 0 && !lines.length) return null;
+  return parseCliVersion(lines.join("\n"));
+}
+
+/** `darwin-arm64` / `darwin-x64` — the key Unity's manifest uses for this Mac. */
+export function unityCliPlatform(arch: string = process.arch): string {
+  return `darwin-${arch === "arm64" ? "arm64" : "x64"}`;
+}
+
+/** The channel manifest the studio reads: `latest-beta.json` on the beta channel, `latest.json` on stable. */
+export function unityCliManifestUrl(channel: string = UNITY_PIN.cliChannel): string {
+  return `${UNITY_PIN.cliCdnBase}${channel ? `latest-${channel}.json` : "latest.json"}`;
+}
+
+interface CliManifest {
+  version: string;
+  binaries: Record<string, { filename: string; sha256: string; size?: number }>;
+}
+
+function parseManifest(text: string): CliManifest | null {
+  try {
+    const parsed = JSON.parse(text) as Partial<CliManifest>;
+    if (!parsed || typeof parsed.version !== "string" || !parsed.binaries || typeof parsed.binaries !== "object") return null;
+    return { version: parsed.version, binaries: parsed.binaries as CliManifest["binaries"] };
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Install the Unity CLI into `<installDir>/unity` (default `<userData>/tools`): read the channel
+ * manifest, download this Mac's binary, verify its sha256 against the manifest, make it
+ * executable, and ask it `--version`. Unity's own install script (read on 2026-09-11) does the
+ * same three steps and then edits the user's shell configs to put `~/.unity/bin` on PATH — the
+ * one thing the studio must never do, since `unity` on an agent's PATH would hand it the
+ * editor's token. So the studio does the download itself and runs no script.
+ */
+export async function downloadUnityCli(userData: string, onProgress: (p: UnitySetupView) => void, signal: AbortSignal, options: SetupOptions = {}): Promise<string> {
+  const run: RunSeam = options.run ?? runLines;
+  const fetch: FetchSeam = options.fetch ?? ((url, init) => globalThis.fetch(url, init) as unknown as ReturnType<FetchSeam>);
+  const installDir = options.installDir ?? path.join(userData, "tools");
+  const target = options.installDir ? path.join(options.installDir, "unity") : studioUnityCli(userData);
+  const downloads = path.join(installDir, "downloads");
+  const platform = unityCliPlatform();
+  const manifestUrl = unityCliManifestUrl();
+  const progress = (line: string, fraction: number | null = null): void => onProgress({ step: "cli", phase: "running", progress: fraction, line: line.slice(0, LINE_MAX) });
+  const cancelled = (): Error => new Error("cancelled");
+
+  await mkdir(installDir, { recursive: true });
+  await mkdir(downloads, { recursive: true });
+  const part = path.join(downloads, "unity-cli.part");
+  try {
+    progress("Reading Unity's release manifest…");
+    const answer = await fetch(manifestUrl, { signal });
+    if (!answer.ok || !answer.body) throw new Error(`Unity's CDN answered ${answer.status}`);
+    const manifest = parseManifest(await readText(answer.body, signal));
+    if (!manifest) throw new Error("what Unity's CDN sent is not a release manifest — the studio will not install from it");
+    const binary = manifest.binaries[platform];
+    if (!binary || typeof binary.filename !== "string" || !/^[0-9a-f]{64}$/i.test(String(binary.sha256 ?? ""))) throw new Error(`no Unity CLI for ${platform} in the ${manifest.version} manifest`);
+    const url = `${UNITY_PIN.cliCdnBase}${manifest.version}/${binary.filename}`;
+    const total = Number(binary.size) || UNITY_PIN.cliBytes;
+
+    progress(`Downloading Unity CLI ${manifest.version}…`, 0);
+    const response = await fetch(url, { signal });
+    if (!response.ok || !response.body) throw new Error(`Unity's CDN answered ${response.status} for ${binary.filename}`);
+    const hash = createHash("sha256");
+    const reader = response.body.getReader();
+    const out = createWriteStream(part);
+    let received = 0;
+    let lastTick = 0;
+    try {
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        if (signal.aborted) throw cancelled();
+        hash.update(value);
+        received += value.length;
+        if (!out.write(value)) await new Promise<void>((resolve) => out.once("drain", () => resolve()));
+        const now = Date.now();
+        if (now - lastTick > 150) {
+          lastTick = now;
+          progress(`Downloading Unity CLI ${manifest.version} — ${Math.round(received / 1_048_576)} of ${Math.round(total / 1_048_576)} MB`, Math.min(0.95, received / total));
+        }
+      }
+      await new Promise<void>((resolve, reject) => out.end((err?: Error | null) => (err ? reject(err) : resolve())));
+    } catch (err) {
+      if (!out.closed) await new Promise<void>((resolve) => { out.once("close", () => resolve()); out.destroy(); });
+      throw signal.aborted ? cancelled() : err;
+    }
+    progress("Verifying the checksum…", 0.96);
+    const digest = hash.digest("hex");
+    if (digest !== binary.sha256.toLowerCase()) throw new Error(`the download's checksum does not match Unity's manifest (${digest.slice(0, 12)}…) — try again`);
+
+    await rm(target, { force: true });
+    await rename(part, target);
+    await chmod(target, 0o755);
+
+    progress("Checking the installed Unity CLI…", 0.98);
+    const version = await cliVersionOf(run, target, signal);
+    if (signal.aborted) throw cancelled();
+    if (!version) throw new Error("the installed `unity` binary does not answer `--version` — the install is not usable");
+    const record: UnityCliRecord = { version, channel: UNITY_PIN.cliChannel, manifest: manifestUrl, url, sha256: digest, binary: target, installedAt: new Date().toISOString() };
+    await writeFile(options.installDir ? path.join(options.installDir, "unity-cli.json") : studioUnityCliRecord(userData), `${JSON.stringify(record, null, 2)}\n`);
+    progress(`Unity CLI ${version} installed`, 1);
+    return target;
+  } catch (err) {
+    throw signal.aborted ? cancelled() : err;
+  } finally {
+    await rm(part, { force: true }).catch(() => {});
+  }
+}
