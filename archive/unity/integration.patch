+const GUID = /^[0-9a-f]{32}$/;
+
+async function guidOf(metaFile: string): Promise<string> {
+  const text = await readFile(metaFile, "utf8");
+  const guid = /^guid: ([0-9a-f]{32})$/m.exec(text)?.[1];
+  assert.ok(guid, `${metaFile}: no guid`);
+  assert.match(text, /^fileFormatVersion: 2$/m, `${metaFile}: fileFormatVersion`);
+  return guid;
+}
+
+/** Every asset (file or folder) under `root`, with the meta it must have, checked; returns guid by project-relative path. */
+async function metasOf(root: string, prefix: string): Promise<Map<string, string>> {
+  const guids = new Map<string, string>();
+  const entries = await filesIn(root);
+  for (const entry of entries) {
+    if (entry.endsWith(".meta")) {
+      const owner = entry.slice(0, -".meta".length);
+      assert.ok(entries.includes(owner) || entries.includes(`${owner}/`), `${prefix}/${entry} has no file or folder beside it`);
+      continue;
+    }
+    const asset = entry.endsWith("/") ? entry.slice(0, -1) : entry;
+    const meta = path.join(root, `${asset}.meta`);
+    const guid = await guidOf(meta).catch(() => null);
+    assert.ok(guid, `${prefix}/${asset} has no .meta`);
+    if (entry.endsWith("/")) assert.match(await readFile(meta, "utf8"), /^folderAsset: yes$/m, `${prefix}/${asset}.meta is not a folder meta`);
+    if (asset.endsWith(".cs")) assert.match(await readFile(meta, "utf8"), /^MonoImporter:$/m, `${prefix}/${asset}.meta is not a script meta`);
+    guids.set(`${prefix}/${asset}`, guid!);
+  }
+  return guids;
+}
