+      label: this.options.label,
+      state,
+      ms: Date.now() - this.#startedAt,
+      editorVersion: this.editorVersion,
+      ...(detail ? { detail } : {}),
+    });
+  }
+
+  #startWatch(): void {
+    this.#stopWatch();
+    const every = this.options.watchMs ?? 5_000;
+    this.#watch = setInterval(() => void this.#check(), every);
+    this.#watch.unref?.();
+  }
+
+  #stopWatch(): void {
+    if (this.#watch) clearInterval(this.#watch);
+    this.#watch = null;
+  }
+
+  /**
+   * The process exited, its pid is gone, or its server has answered nothing for the whole
+   * window: the editor crashed. A descriptor rewritten by our own pid refreshes the port and
+   * the token; its heartbeat is read for nothing (measured 2026-09-11: frozen in idle Edit
+   * mode, windowed and batch), and an idle editor is a healthy editor.
+   */
+  async #check(): Promise<void> {
