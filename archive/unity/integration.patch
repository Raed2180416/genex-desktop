+// spike S5: cold Library import of a fresh copy vs a `cp -c` clone — this runner clones and
+// reports the settle time on the lease row; the number decides the worktree clone rule.
+async function cloneTree(source: string, target: string): Promise<"clone" | "copy"> {
+  await mkdir(path.dirname(target), { recursive: true });
