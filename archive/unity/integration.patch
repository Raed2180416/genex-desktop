+        onContextMenu={(event) => { if (focused) event.preventDefault(); }}
+      >
+        {picture ? (
+          <img ref={image} src={picture.src} alt="" className="absolute inset-0 h-full w-full object-contain" draggable={false} />
+        ) : (
+          <div className="hatch absolute inset-0 grid place-items-center p-6 text-center text-[12px] text-ink-3">{status}</div>
+        )}
+        {focused ? (
+          <span data-unity-chip className="absolute top-2.5 right-2.5 rounded-control bg-surface px-2 py-1 font-mono text-[10.5px] text-ink shadow-btn">{UNITY_WORDS.playingChip}</span>
+        ) : playing && picture ? (
+          <span className="absolute right-2.5 bottom-2.5 rounded-control px-2 py-1 font-mono text-[10.5px] text-ink-3" style={{ background: "var(--tooltip-bg)" }}>{UNITY_WORDS.focusHint}</span>
+        ) : null}
+      </div>
+      <div data-unity-status className="flex h-7 shrink-0 items-center gap-2 border-t border-line bg-canvas px-3 font-mono text-[10.5px] text-ink-3">
+        <span className="truncate">{status}</span>
+        {latency ? (
+          <>
+            <span className="h-3 w-px bg-line" />
+            <span data-unity-latency className="shrink-0">{latency}</span>
+          </>
+        ) : null}
+      </div>
+    </div>
+  );
+}
