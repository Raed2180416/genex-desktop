diff --git a/tests/fixtures/unity/grey-box/Assets/Studio/StudioTag.cs b/tests/fixtures/unity/grey-box/Assets/Studio/StudioTag.cs
new file mode 100644
index 0000000..72fb781
--- /dev/null
+++ b/tests/fixtures/unity/grey-box/Assets/Studio/StudioTag.cs
@@ -0,0 +1,27 @@
+// Tag what you add, so checks can find it. A StudioTag on an object counts it under its label
+// in studio_state's `tags`; a group's tag covers what the group spawns. From code:
+// `StudioTag.Tag(gameObject, "tree")`. An untagged object does not exist as far as the contract
+// is concerned.
+using AIGameStudio.Bridge;
+using UnityEngine;
+
+public sealed class StudioTag : MonoBehaviour
+{
+    [Tooltip("Short lowercase label: ground, wall, player, tree, prop, light-key …")]
+    public string label = "";
+
+    void OnEnable()
+    {
+        if (!string.IsNullOrEmpty(label)) StudioBridge.Tag(gameObject, label);
+    }
+
+    /// Tag an object from code; returns the component so a caller can keep it.
+    public static StudioTag Tag(GameObject target, string tag)
+    {
+        var component = target.GetComponent<StudioTag>();
+        if (component == null) component = target.AddComponent<StudioTag>();
+        component.label = tag;
+        StudioBridge.Tag(target, tag);
+        return component;
+    }
+}
