diff --git a/tests/fixtures/unity/grey-box/Assets/Player/PlayerController.cs b/tests/fixtures/unity/grey-box/Assets/Player/PlayerController.cs
new file mode 100644
index 0000000..04ee88e
--- /dev/null
+++ b/tests/fixtures/unity/grey-box/Assets/Player/PlayerController.cs
@@ -0,0 +1,141 @@
+// The grey box's player: a CharacterController driven by three Input System actions — Move
+// (WASD / left stick), Look (mouse delta / right stick) and Primary (left button / space /
+// south button). The actions come from Player.inputactions when the scene wires the asset,
+// and are built in code when it does not, so the player works either way. Demos drive it
+// through Drive(); the studio's simulated input drives it through the same actions a person
+// uses. Time only from Time.deltaTime, so a stepped clock moves it exactly as a live one.
+using AIGameStudio.Bridge;
+using UnityEngine;
+using UnityEngine.InputSystem;
+
+[RequireComponent(typeof(CharacterController))]
+public sealed class PlayerController : MonoBehaviour
+{
+    [SerializeField] InputActionAsset actions;
+    [SerializeField] Transform eye;
+    [SerializeField] float moveSpeed = 5f;
+    [SerializeField] float lookSpeed = 0.12f;
+    [SerializeField] float gravity = -15f;
+
+    CharacterController controller;
+    InputAction move;
+    InputAction look;
+    InputAction primary;
+    bool ownsActions;
+    Vector2 drivenMove;
+    Vector2 drivenLook;
+    Vector3 spawnPosition;
+    float yaw;
+    float pitch;
+    float verticalSpeed;
+    int primaryCount;
+
+    public float Yaw => yaw;
+    public bool Grounded => controller != null && controller.isGrounded;
+    public int PrimaryCount => primaryCount;
+
+    void Awake()
+    {
+        controller = GetComponent<CharacterController>();
+        spawnPosition = transform.position;
+        yaw = transform.eulerAngles.y;
+        Bind();
+    }
+
+    /// The three actions from the asset when it is there, else the same three built here.
+    void Bind()
+    {
+        var map = actions != null ? actions.FindActionMap("Player") : null;
+        if (map != null)
+        {
+            move = map.FindAction("Move");
+            look = map.FindAction("Look");
+            primary = map.FindAction("Primary");
+        }
+        if (move == null || look == null || primary == null)
+        {
+            ownsActions = true;
+            move = new InputAction("Move", InputActionType.Value);
+            move.AddCompositeBinding("2DVector")
+                .With("Up", "<Keyboard>/w")
+                .With("Down", "<Keyboard>/s")
+                .With("Left", "<Keyboard>/a")
+                .With("Right", "<Keyboard>/d");
+            move.AddBinding("<Gamepad>/leftStick");
+            look = new InputAction("Look", InputActionType.Value, "<Mouse>/delta");
+            look.AddBinding("<Gamepad>/rightStick");
+            primary = new InputAction("Primary", InputActionType.Button, "<Mouse>/leftButton");
+            primary.AddBinding("<Keyboard>/space");
+            primary.AddBinding("<Gamepad>/buttonSouth");
+        }
+    }
+
+    void OnEnable()
+    {
+        move.Enable();
+        look.Enable();
+        primary.Enable();
+        primary.performed += OnPrimary;
+    }
+
+    void OnDisable()
+    {
+        primary.performed -= OnPrimary;
+        if (!ownsActions) return;
+        move.Disable();
+        look.Disable();
+        primary.Disable();
+    }
+
+    void Update()
+    {
+        var dt = Time.deltaTime;
+        var moveInput = move.ReadValue<Vector2>() + drivenMove;
+        var lookInput = look.ReadValue<Vector2>() + drivenLook;
+        drivenMove = Vector2.zero;
+        drivenLook = Vector2.zero;
+
+        yaw += lookInput.x * lookSpeed;
+        pitch = Mathf.Clamp(pitch - lookInput.y * lookSpeed, -80f, 80f);
+        transform.rotation = Quaternion.Euler(0f, yaw, 0f);
+        if (eye != null) eye.localRotation = Quaternion.Euler(pitch, 0f, 0f);
+
+        var planar = Vector2.ClampMagnitude(moveInput, 1f);
+        var direction = transform.forward * planar.y + transform.right * planar.x;
+        if (controller.isGrounded && verticalSpeed < 0f) verticalSpeed = -1f;
+        verticalSpeed += gravity * dt;
+        controller.Move((direction * moveSpeed + Vector3.up * verticalSpeed) * dt);
+    }
+
+    /// One frame of scripted input, added to whatever the person or the studio is pressing.
+    public void Drive(Vector2 moveInput, Vector2 lookInput)
+    {
+        drivenMove += moveInput;
+        drivenLook += lookInput;
+    }
+
+    /// The primary action — counted for the `primary-action-registers` check; extend it with the game's own effect.
+    public void Primary()
+    {
+        primaryCount++;
+        StudioBridge.CountAction("primary");
+    }
+
+    /// studio_seed puts the player back where the scene placed it, facing the same way.
+    public void ResetTo(int seed)
+    {
+        controller.enabled = false;
+        transform.position = spawnPosition;
+        yaw = 0f;
+        pitch = 0f;
+        verticalSpeed = 0f;
+        primaryCount = 0;
+        transform.rotation = Quaternion.identity;
+        controller.enabled = true;
+    }
+
+    void OnPrimary(InputAction.CallbackContext context)
+    {
+        Primary();
+    }
+}
