diff --git a/tests/conformance/unity-editor.test.ts b/tests/conformance/unity-editor.test.ts
new file mode 100644
index 0000000..4cc7237
--- /dev/null
+++ b/tests/conformance/unity-editor.test.ts
@@ -0,0 +1,363 @@
+/**
+ * The editor process and the pool (Unity in the studio, plan §3.3, §8.1 `unity-editor.test.ts`):
+ * spawn → descriptor → settle → play → release kills the tree and the descriptor is gone; a
+ * 503 is retried and names a dialog; a 401 re-reads the descriptor once; a crash restarts the
+ * editor once and the second death ends it with `stoppedBecause`; a foreign descriptor is
+ * refused; leases renew and lapse; `queueSlots: 1` keeps two roots from ever overlapping.
+ *
+ * Two fakes: the fake editor as a real process (`fakeUnityEditorBinary`, the path a night
+ * takes) and an in-process fake behind the `spawn` seam, where a `sleep` child holds the pid
+ * and the fake Pipeline server runs in this process — so a dialog, a token rotation and a
+ * frozen heartbeat can be scripted mid-test.
+ */
+import assert from "node:assert/strict";
+import { execFileSync, spawn as nodeSpawn } from "node:child_process";
+import { mkdir, readFile, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { after, describe, it } from "node:test";
+import { UnityEditor, pipelineDescriptorPath, pipelineRuntimeDescriptorPath, type UnitySpawn } from "../../src/main/unity-editor.ts";
+import { UnityPool, editorMismatchSentence } from "../../src/main/unity-pool.ts";
+import type { UnityStatus } from "../../src/substrate/unity-types.ts";
+import { startFakePipeline, type FakePipeline, type FakePipelineOptions } from "../helpers/fake-pipeline.ts";
+import { fakeEditorCalls, fakeEditorInvocations, fakeUnityEditorBinary, invocationsOverlap } from "../helpers/fake-unity-editor.ts";
+import { tmpDir } from "../helpers/tmp.ts";
+
+const pipelines: FakePipeline[] = [];
+const editors: UnityEditor[] = [];
+const pools: UnityPool[] = [];
+const roots: string[] = [];
+
+function pgrep(needle: string): string[] {
+  try {
+    return execFileSync("pgrep", ["-f", needle]).toString().trim().split("\n").filter(Boolean);
+  } catch {
+    return [];
+  }
+}
+
+after(async () => {
+  for (const pool of pools) await pool.releaseAll().catch(() => {});
+  for (const editor of editors) await editor.release().catch(() => {});
+  for (const pipeline of pipelines) await pipeline.close().catch(() => {});
+  // Nothing of ours survives the file: no fake editor on any of its project roots.
+  for (const root of roots) assert.deepEqual(pgrep(root), [], `fake editors still alive on ${root}`);
+});
+
+const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function waitFor(condition: () => boolean, timeoutMs: number, label: string): Promise<void> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (condition()) return;
+    await sleep(25);
+  }
+  throw new Error(`timed out waiting for ${label}`);
+}
+
+async function unityProject(name: string, version = "6000.0.50f1"): Promise<string> {
+  const root = path.join(await tmpDir("studio-unity-editor-"), name);
+  await mkdir(path.join(root, "ProjectSettings"), { recursive: true });
+  await mkdir(path.join(root, "Assets", "Scenes"), { recursive: true });
+  await mkdir(path.join(root, "Packages"), { recursive: true });
+  await writeFile(path.join(root, "ProjectSettings", "ProjectVersion.txt"), `m_EditorVersion: ${version}\nm_EditorVersionWithRevision: ${version} (abc)\n`);
+  await writeFile(path.join(root, "Packages", "manifest.json"), JSON.stringify({ dependencies: { "com.unity.pipeline": "0.6.0-exp.1" } }));
+  await writeFile(path.join(root, "Assets", "Scenes", "Main.unity"), "%YAML 1.1\n");
+  roots.push(root);
+  return root;
+}
+
+/**
+ * An in-process editor behind the spawn seam: a `sleep` child holds a real pid and its own
+ * process group (so `killTree` has something to kill), and the fake Pipeline runs in this
+ * process on that pid. The pipeline closes when the child exits, as the real one's would.
+ */
+function inProcess(scripts: Partial<FakePipelineOptions> = {}, options: { pidOffset?: number; heartbeatMs?: number | null } = {}): { spawn: UnitySpawn; started: FakePipeline[] } {
+  const started: FakePipeline[] = [];
+  const spawn: UnitySpawn = (_binary, args) => {
+    const root = args[args.indexOf("-projectPath") + 1]!;
+    const child = nodeSpawn("sleep", ["600"], { detached: true, stdio: "ignore" });
+    void startFakePipeline({ root, pid: child.pid! + (options.pidOffset ?? 0), heartbeatMs: options.heartbeatMs === undefined ? 100 : options.heartbeatMs, ...scripts }).then((pipeline) => {
+      started.push(pipeline);
+      pipelines.push(pipeline);
+      if (child.exitCode !== null) void pipeline.close();
+      else child.once("exit", () => void pipeline.close());
+    });
+    return child;
+  };
+  return { spawn, started };
+}
+
+function readyStatus(binary: string, version = "6000.0.50f1"): UnityStatus {
+  return {
+    code: "ready",
+    enabled: true,
+    cli: { version: "1.2.0", path: "/fake/unity", source: "hub" },
+    editors: [{ version, path: binary, binary, source: "hub" }],
+    account: { name: "Sim", email: "sim@example.com" },
+    accountChecked: true,
+    licence: { kind: "personal", active: true },
+    detail: `Unity ${version} found`,
+    pin: { cliMinimum: "1.0.0", editorMinimum: "6000.0", editorPreferred: "6000.0.50f1" },
+  };
+}
+
+describe("the editor process (Unity in the studio, plan §3.3)", () => {
+  it("spawns the fake editor, finds its own descriptor, settles, plays, and release kills the tree and the descriptor", async () => {
+    const root = await unityProject("real");
+    const binary = await fakeUnityEditorBinary(path.join(path.dirname(root), "editor", "Unity"));
+    await writeFile(path.join(root, "Assets", ".fake-settle-ms"), "400");
+    const logFile = path.join(path.dirname(root), "logs", "real.log");
+    const events: string[] = [];
+    const editor = new UnityEditor({ binary, root, logFile, label: "real", headless: true, editorVersion: "6000.0.50f1", runId: "run_e", settleMs: 20_000, pollMs: 50, watchMs: 250, onEvent: (event) => events.push(event.state) });
+    editors.push(editor);
+    assert.deepEqual(editor.launchArgs(), ["-projectPath", root, "-logFile", logFile, "-batchmode", "-automated"]);
+    await editor.start();
+    assert.equal(editor.state, "settled");
+    assert.ok((editor.settledMs ?? 0) >= 200, `the scripted settle gate was waited out (${editor.settledMs} ms)`);
+    assert.deepEqual(events, ["starting", "settling", "settled"]);
+    const descriptor = JSON.parse(await readFile(pipelineDescriptorPath(root), "utf8")) as { pid: number; mode: string; evalToken: string };
+    assert.equal(descriptor.pid, editor.pid, "the descriptor is our child's");
+    assert.equal(descriptor.mode, "batchmode");
+    assert.equal(typeof descriptor.evalToken, "string");
+    assert.equal(editor.port, JSON.parse(await readFile(pipelineDescriptorPath(root), "utf8")).port);
+
+    const status = await editor.exec("editor_status");
+    assert.equal(status.ok, true);
+    assert.equal((status.result as { playing: boolean }).playing, false);
+    const play = await editor.exec("editor_play");
+    assert.ok(play.ok);
+    assert.equal(editor.playing, true);
+    assert.equal(editor.state, "playing");
+    await stat(pipelineRuntimeDescriptorPath(root));
+    const key = await editor.exec("simulate_key", { key: "w", action: "down" }, { server: "runtime" });
+    assert.ok(key.ok, key.error);
+    assert.equal((key.result as { server: string }).server, "runtime", "input goes to the Play-mode server");
+    assert.match(await readFile(logFile, "utf8"), /fake unity \d+ started/);
+
+    const pid = editor.pid!;
+    await editor.release();
+    assert.equal(editor.state, "stopped");
+    assert.throws(() => process.kill(pid, 0), "the editor process is gone");
+    await assert.rejects(stat(pipelineDescriptorPath(root)), "the descriptor is gone");
+    await assert.rejects(stat(pipelineRuntimeDescriptorPath(root)), "the runtime descriptor is gone");
+    const invocations = await fakeEditorInvocations(root);
+    assert.equal(invocations.length, 1);
+    assert.equal(invocations[0]!.pid, pid);
+    assert.ok(invocations[0]!.end !== null, "the exit was logged");
+    assert.ok(invocations[0]!.argv.includes("-batchmode"));
+    // Play mode was left before the kill: the studio never leaves that to the OS.
+    const calls = await fakeEditorCalls(root);
+    assert.equal(calls.at(-1)!.command, "editor_stop");
+    assert.deepEqual(pgrep(root), []);
+  });
+
+  it("retries a 503 until its budget and names the dialog, re-reads the descriptor on a 401, and answers rather than throws", async () => {
+    const root = await unityProject("seam");
+    const { spawn, started } = inProcess();
+    const editor = new UnityEditor({ binary: "/fake/Unity", root, logFile: path.join(root, "..", "seam.log"), label: "seam", headless: false, settleMs: 5_000, pollMs: 20, watchMs: 200, spawn });
+    editors.push(editor);
+    await editor.start();
+    const pipeline = started[0]!;
+    assert.equal(editor.mode, "editor");
+
+    pipeline.setDialog({ title: "Save changes?" });
+    const blocked = await editor.exec("editor_status", {}, { timeoutMs: 500 });
+    assert.equal(blocked.ok, false);
+    assert.equal(blocked.status, 503);
+    assert.equal(blocked.busyReason, "blocked_by_dialog");
+    assert.match(blocked.error ?? "", /Unity is showing a dialog: Save changes\? — dismiss it or let the studio restart the editor/);
+    setTimeout(() => pipeline.setDialog(null), 300);
+    const after503 = await editor.exec("editor_status", {}, { timeoutMs: 5_000 });
+    assert.ok(after503.ok, "the retry outlived the dialog");
+
+    const before = pipeline.calls.length;
+    await pipeline.rotateToken();
+    const reread = await editor.exec("editor_status");
+    assert.ok(reread.ok, reread.error);
+    assert.equal(pipeline.calls.length - before, 1, "the refused attempt never counted; the re-read one did, once");
+
+    const unknown = await editor.exec("no_such_command");
+    assert.equal(unknown.ok, false);
+    assert.match(unknown.error ?? "", /unknown command/);
+    const noRuntime = await editor.exec("simulate_key", { key: "w", action: "down" }, { server: "runtime" });
+    assert.equal(noRuntime.ok, false);
+    assert.match(noRuntime.error ?? "", /not in Play mode/);
+    const needsConfirm = await editor.exec("create_gameobject", { name: "Lamp" });
+    assert.equal(needsConfirm.ok, false);
+    assert.match(needsConfirm.error ?? "", /confirm=true/);
+    await editor.release();
+    assert.equal((await editor.exec("editor_status")).ok, false, "a released editor answers, never throws");
+  });
+
+  it("restarts once after a crash, and the second death ends it with stoppedBecause", async () => {
+    const root = await unityProject("crash");
+    const { spawn, started } = inProcess();
+    const events: Array<{ state: string; detail?: string }> = [];
+    const editor = new UnityEditor({
+      binary: "/fake/Unity",
+      root,
+      logFile: path.join(root, "..", "crash.log"),
+      label: "crash",
+      headless: false,
+      settleMs: 5_000,
+      pollMs: 20,
+      watchMs: 100,
+      heartbeatStaleMs: 400,
+      killGraceMs: 500,
+      spawn,
+      onEvent: (event) => events.push({ state: event.state, ...(event.detail ? { detail: event.detail } : {}) }),
+    });
+    editors.push(editor);
+    await editor.start();
+    const first = editor.pid!;
+    process.kill(first, "SIGKILL");
+    await waitFor(() => editor.state === "restarted", 6_000, "the restart");
+    assert.notEqual(editor.pid, first, "a new process");
+    assert.equal(editor.restarts, 1);
+    assert.ok(events.some((e) => e.state === "crashed" && /exited/.test(e.detail ?? "")), JSON.stringify(events));
+    assert.ok(events.some((e) => e.state === "restarted"));
+    assert.equal((await editor.exec("editor_status")).ok, true, "the new editor answers");
+    const descriptor = JSON.parse(await readFile(pipelineDescriptorPath(root), "utf8")) as { pid: number };
+    assert.equal(descriptor.pid, editor.pid, "the new descriptor is the new child's");
+    assert.equal(editor.stoppedBecause, null);
+
+    // A frozen heartbeat is not a death (measured 2026-09-11: an idle editor's heartbeat freezes,
+    // windowed and batch alike, while its server answers): three windows later it is still up.
+    started[1]!.freeze();
+    await new Promise((resolve) => setTimeout(resolve, 1_500));
+    assert.equal(editor.state, "restarted", "an idle editor is a healthy editor");
+    assert.equal(editor.stoppedBecause, null);
+    assert.equal(editor.restarts, 1);
+    assert.equal((await editor.exec("editor_status")).ok, true);
+
+    // The second death is a hang: the process lives, the server stops answering.
+    await started[1]!.close();
+    await waitFor(() => Boolean(editor.stoppedBecause), 6_000, "stoppedBecause");
+    assert.equal(editor.state, "crashed");
+    assert.match(editor.stoppedBecause ?? "", /crashed twice \(no answer from the editor for \d+ s\)/);
+    assert.equal(editor.restarts, 1, "no second restart");
+    const gone = await editor.exec("editor_status", {}, { timeoutMs: 300 });
+    assert.equal(gone.ok, false, "a hung editor answers nothing");
+    await editor.release();
+    assert.throws(() => process.kill(editor.pid!, 0));
+  });
+
+  it("refuses a descriptor that belongs to another process", async () => {
+    const root = await unityProject("foreign");
+    const { spawn } = inProcess({}, { pidOffset: 100_000 });
+    const editor = new UnityEditor({ binary: "/fake/Unity", root, logFile: path.join(root, "..", "foreign.log"), label: "foreign", headless: false, settleMs: 2_000, discoverMs: 800, pollMs: 20, spawn });
+    editors.push(editor);
+    await assert.rejects(editor.start(), /belongs to pid \d+, not the editor the studio started \(pid \d+\)/);
+    await editor.release();
+  });
+});
+
+describe("the editor pool (D4): leases, the queue, the version", () => {
+  it("a transient lease is renewed per call and lapses on its own; the hard cap ends it whatever the renewals", async () => {
+    const root = await unityProject("lease");
+    const { spawn } = inProcess();
+    const logs = path.join(root, "..", "logs");
+    const pool = new UnityPool({ status: async () => readyStatus("/fake/Unity"), queueSlots: () => 1, headless: () => false, logDir: () => logs, spawn, settleMs: 5_000, pollMs: 20, watchMs: 200, leaseMs: 400, leaseCapMs: 1_200, waitMs: 2_000 });
+    pools.push(pool);
+    const lease = await pool.lease({ runId: "run_l", project: "g", root, kind: "transient", facetId: "lighting" });
+    assert.ok(lease.handle, (lease as { error?: string }).error);
+    if (lease.handle === null) return;
+    assert.equal(lease.editorVersion, "6000.0.50f1");
+    assert.equal(lease.queued, 0);
+    assert.equal(lease.state, "settled");
+    assert.match(lease.handle, /^unity:run_l:\d+$/);
+    const entry = pool.get(lease.handle)!;
+    const pid = entry.editor.pid!;
+    assert.deepEqual(pool.handles().map((h) => ({ handle: h.handle, runId: h.runId, label: h.label, kind: h.kind, state: h.state })), [{ handle: lease.handle, runId: "run_l", label: "lighting", kind: "transient", state: "settled" }]);
+    await sleep(250);
+    assert.ok(pool.renew(lease.handle));
+    await sleep(250);
+    assert.ok(pool.get(lease.handle), "renewed within the lease: still held");
+    await sleep(700);
+    assert.equal(pool.get(lease.handle), null, "unrenewed: lapsed");
+    await waitFor(() => {
+      try {
+        process.kill(pid, 0);
+        return false;
+      } catch {
+        return true;
+      }
+    }, 2_000, "the lapsed editor's exit");
+
+    const capped = await pool.lease({ runId: "run_l", project: "g", root, kind: "transient", facetId: "lighting" });
+    assert.ok(capped.handle);
+    const keep = setInterval(() => pool.renew(capped.handle!), 50);
+    await sleep(1_700);
+    clearInterval(keep);
+    assert.equal(pool.get(capped.handle!), null, "the hard cap ended it");
+    assert.deepEqual(pool.alivePids(), []);
+  });
+
+  it("the same root while held is one handle, refcounted; a version mismatch and a non-project are refused with the remedy", async () => {
+    const root = await unityProject("refs");
+    const { spawn } = inProcess();
+    const pool = new UnityPool({ status: async () => readyStatus("/fake/Unity"), queueSlots: () => 1, headless: () => false, logDir: () => path.join(root, "..", "logs"), spawn, settleMs: 5_000, pollMs: 20, watchMs: 200, leaseMs: 10_000, waitMs: 2_000 });
+    pools.push(pool);
+    const a = await pool.lease({ runId: "run_r", project: "g", root, kind: "transient", facetId: "a" });
+    const b = await pool.lease({ runId: "run_r", project: "g", root, kind: "live", facetId: "b" });
+    assert.ok(a.handle);
+    assert.equal(b.handle, a.handle, "same root while held → same handle");
+    assert.equal(b.queued, 0);
+    assert.equal(await pool.release(a.handle!), true);
+    assert.ok(pool.get(a.handle!), "one holder left");
+    assert.equal(await pool.release(a.handle!), true);
+    assert.equal(pool.get(a.handle!), null);
+    assert.equal(await pool.release(a.handle!), false, "released twice is not held");
+
+    const old = await unityProject("old", "6000.0.47f1");
+    const refused = await pool.lease({ runId: "run_r", project: "g", root: old, kind: "transient" });
+    assert.equal(refused.handle, null);
+    if (refused.handle !== null) return;
+    assert.equal(refused.reason, "refused");
+    assert.equal(refused.error, editorMismatchSentence("6000.0.47f1", ["6000.0.50f1"]));
+    assert.equal(refused.error, "this project wants 6000.0.47f1; installed: 6000.0.50f1 — open it in Unity Hub once to upgrade, or install 6000.0.47f1");
+    const notUnity = await pool.lease({ runId: "run_r", project: "g", root: await tmpDir("studio-not-unity-"), kind: "transient" });
+    assert.equal(notUnity.handle, null);
+    assert.match((notUnity as { error: string }).error, /no ProjectSettings\/ProjectVersion\.txt/);
+    assert.deepEqual(pool.alivePids(), []);
+  });
+
+  it("queueSlots 1: two roots never run at once, the waiter is told where it stands, and a wait can run out", async () => {
+    const a = await unityProject("queue-a");
+    const b = await unityProject("queue-b");
+    const binary = await fakeUnityEditorBinary(path.join(path.dirname(a), "editor", "Unity"));
+    const pool = new UnityPool({ status: async () => readyStatus(binary), queueSlots: () => 1, headless: () => true, logDir: () => path.join(path.dirname(a), "logs"), settleMs: 20_000, pollMs: 50, watchMs: 500, leaseMs: 10_000, waitMs: 10_000 });
+    pools.push(pool);
+    const first = await pool.lease({ runId: "run_q", project: "g", root: a, kind: "transient", facetId: "a" });
+    assert.ok(first.handle, (first as { error?: string }).error);
+    const timedOut = await pool.lease({ runId: "run_q", project: "g", root: b, kind: "transient", facetId: "b", waitMs: 300 });
+    assert.equal(timedOut.handle, null);
+    if (timedOut.handle !== null) return;
+    assert.equal(timedOut.reason, "queue");
+    assert.ok(timedOut.queued >= 1);
+    assert.ok(timedOut.aheadMinutes >= 1);
+    assert.match(timedOut.error, /no editor slot came free/);
+    assert.equal(pool.queueDepth(), 0, "a timed-out waiter leaves the line");
+
+    const waiting = pool.lease({ runId: "run_q", project: "g", root: b, kind: "transient", facetId: "b", waitMs: 10_000 });
+    await sleep(400);
+    assert.equal(pool.queueDepth(), 1);
+    await pool.release(first.handle!);
+    const second = await waiting;
+    assert.ok(second.handle, (second as { error?: string }).error);
+    if (second.handle === null) return;
+    assert.ok(second.waitedMs >= 350, `waited ${second.waitedMs}`);
+    assert.equal(second.queued, 1);
+    await pool.release(second.handle);
+
+    const [ia] = await fakeEditorInvocations(a);
+    const [ib] = await fakeEditorInvocations(b);
+    assert.ok(ia && ib);
+    assert.ok(ia!.end !== null && ib!.end !== null, "both editors exited");
+    assert.equal(invocationsOverlap(ia!, ib!), false, `a ${ia!.start}–${ia!.end} overlaps b ${ib!.start}–${ib!.end}`);
+    assert.ok(ib!.start >= ia!.end!, "b started only after a had ended");
+    assert.deepEqual(pool.alivePids(), []);
+    assert.deepEqual(pgrep(a), []);
+    assert.deepEqual(pgrep(b), []);
+  });
+});
