+    this.#startWatch();
+  }
+
+  #spawn(): void {
+    const spawnFn = this.options.spawn ?? defaultUnitySpawn;
+    this.#exited = null;
+    this.#descriptor = null;
+    this.#runtime = null;
+    this.playing = false;
+    this.paused = false;
+    const child = spawnFn(this.options.binary, this.launchArgs(), { cwd: this.options.root, env: process.env, detached: true, stdio: "ignore" });
+    this.#child = child;
+    if (child.pid) this.pids.push(child.pid);
+    this.#exitPromise = new Promise<void>((resolve) => {
+      child.once("exit", (code, signal) => {
+        this.#exited = { code, signal };
+        resolve();
+      });
+    });
+    child.unref?.();
+  }
+
+  async #readDescriptor(): Promise<UnityEditorDescriptor | null> {
+    const text = await readFile(pipelineDescriptorPath(this.options.root), "utf8").catch(() => null);
+    if (!text) return null;
+    const parsed = parseJson(text);
+    if (!parsed || typeof parsed.port !== "number" || typeof parsed.evalToken !== "string") return null;
+    return parsed as unknown as UnityEditorDescriptor;
+  }
+
+  async #logTail(): Promise<string> {
+    try {
+      const handle = await open(this.options.logFile, "r");
+      try {
+        const size = (await handle.stat()).size;
+        const length = Math.min(size, 1_500);
+        const buffer = Buffer.alloc(length);
+        await handle.read(buffer, 0, length, size - length);
+        return buffer.toString("utf8").trim();
+      } finally {
+        await handle.close();
+      }
+    } catch {
+      return "";
+    }
+  }
+
+  /** Poll for the descriptor; a descriptor written by some other process is never trusted. */
+  async #discover(): Promise<void> {
+    const pollMs = this.options.pollMs ?? 250;
