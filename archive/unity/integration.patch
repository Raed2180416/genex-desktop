+/**
+ * One Unity editor process (Unity in the studio, plan §3.3): spawn it on a project, find the
+ * Pipeline package's descriptor, wait for the editor to settle, talk to it over loopback HTTP
+ * with the bearer token only this process ever holds, watch that it lives, restart it once
+ * when it dies, and take the whole process tree down on release.
+ *
+ * What "lives" means was measured on 2026-09-11 (the first real night): the descriptor's
+ * `lastHeartbeat` FREEZES while an editor idles in Edit mode — windowed and `-batchmode` alike —
+ * and stays frozen for as long as nobody presses Play, while the process and its HTTP server
+ * are perfectly alive. Reading that as a crash killed a healthy editor mid-night, twice. So
+ * liveness is the process (not exited, pid alive) and the server answering `/api/status` at
+ * all — 200, 401, 503, any answer; the heartbeat is never read as a verdict.
+ *
+ * The editor runs as the user's own app beside `spawn.ts`, not under a Seatbelt (plan §2.2
+ * choice 6): it needs Metal, the licence heartbeat, the Package Manager and a writable
+ * `Library/`. Safety is in what this class alone decides — the binary, the flags, the project
+ * path — and in the tool layer above it. Agents never see the token: the descriptor is a
+ * `denyRead` for every agent process.
+ *
+ * Nothing here has been run against a real editor (rule 11 of the work packages): every wire
+ * shape is what the Pipeline package's documentation says and what `tests/helpers/fake-pipeline.ts`
+ * serves; the spike comments mark where a real Unity could differ.
+ */
+import { spawn as nodeSpawn } from "node:child_process";
+import { open, readFile, rm } from "node:fs/promises";
+import path from "node:path";
+import { killTree } from "../substrate/spawn.ts";
+import { sanitizeUnityText } from "../substrate/unity.ts";
+import type { UnityEditorDescriptor, UnityEditorEvent, UnityEditorState, UnityExecResult, UnityRuntimeDescriptor } from "../substrate/unity-types.ts";
+
+export const PIPELINE_DIR = path.join("Library", "Pipeline");
+export const PIPELINE_DESCRIPTOR = ".unity-pipeline-port";
+export const PIPELINE_RUNTIME_DESCRIPTOR = ".unity-pipeline-runtime-port";
+
+/** Cold import of a big project's Library takes minutes; the grey box measured ~50 s cold and 5–19 s warm (2026-09-11). */
+export const UNITY_SETTLE_MS = 10 * 60_000;
+/**
+ * A live process whose server has not answered for this long is hung. The window is wide on
+ * purpose: a domain reload drops the server for a few seconds, a cold import answers 503 for
+ * minutes (an answer), and the descriptor's heartbeat freezes in idle Edit mode (measured
+ * 2026-09-11) — so only silence counts, and only a long one.
+ */
+export const UNITY_HEARTBEAT_STALE_MS = 90_000;
+/** SIGTERM, then this long, then SIGKILL for the tree. */
+export const UNITY_KILL_GRACE_MS = 10_000;
+
+export function pipelineDescriptorPath(root: string): string {
+  return path.join(root, PIPELINE_DIR, PIPELINE_DESCRIPTOR);
+}
+
+/**
+ * Where the Play-mode runtime server writes its descriptor. Measured on 0.6.0-exp.1 (2026-09-11):
+ * the PROJECT ROOT — `<project>/.unity-pipeline-runtime-port` (`{ pid, port: 7900, platform:
+ * "OSXEditor", unityVersion, buildGuid, startedAt, lastHeartbeat, workingDirectory, evalToken,
+ * capabilities }`), not `Library/Pipeline/` where the editor's own descriptor lives.
+ */
+export function pipelineRuntimeDescriptorPath(root: string): string {
+  return path.join(root, PIPELINE_RUNTIME_DESCRIPTOR);
+}
+
+/** The older guess, still read as a fallback: the runtime descriptor beside the editor's. */
+export function pipelineRuntimeDescriptorLegacyPath(root: string): string {
+  return path.join(root, PIPELINE_DIR, PIPELINE_RUNTIME_DESCRIPTOR);
+}
+
+/** The paths an agent process on this project must never read: the token lives in them. */
+export function pipelineDenyReads(root: string): string[] {
+  return [path.join(root, PIPELINE_DIR), pipelineDescriptorPath(root), pipelineRuntimeDescriptorPath(root), pipelineRuntimeDescriptorLegacyPath(root)];
+}
+
+/** The slice of a `ChildProcess` the editor manager uses — what a test's in-process stand-in provides. */
+export interface UnityChild {
+  pid?: number | undefined;
+  exitCode: number | null;
+  kill(signal?: NodeJS.Signals): boolean;
+  once(event: "exit", listener: (code: number | null, signal: NodeJS.Signals | null) => void): unknown;
+  unref?(): void;
+}
+
+export type UnitySpawn = (binary: string, args: string[], options: { cwd: string; env: NodeJS.ProcessEnv; detached: true; stdio: "ignore" }) => UnityChild;
+
+/** The real thing: its own process group, so `killTree` takes the editor's helpers with it. */
+export const defaultUnitySpawn: UnitySpawn = (binary, args, options) => nodeSpawn(binary, args, options);
+
+export interface UnityEditorOptions {
+  binary: string;
+  /** The project (a worktree or the live folder) the editor opens. */
+  root: string;
+  logFile: string;
+  label: string;
+  /** `-batchmode` (M3); never `-nographics`. */
+  headless: boolean;
+  editorVersion?: string | null;
+  runId?: string | null;
+  spawn?: UnitySpawn;
+  settleMs?: number;
+  /** How long to wait for the descriptor to appear; default the settle budget. */
+  discoverMs?: number;
+  /** How long the server may go unanswering (with the process alive) before the editor counts as hung. */
+  heartbeatStaleMs?: number;
+  /** How often liveness is checked. */
+  watchMs?: number;
+  /** How often the descriptor is polled while discovering. */
+  pollMs?: number;
+  killGraceMs?: number;
+  onEvent?: (event: UnityEditorEvent) => void;
+}
+
+export interface UnityExecOptions {
+  timeoutMs?: number;
+  /** `runtime` sends to the Play-mode server (input, timescale); default the editor's. */
+  server?: "editor" | "runtime";
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function parseJson(text: string): Record<string, unknown> | null {
+  try {
+    const parsed = JSON.parse(text) as unknown;
+    return parsed && typeof parsed === "object" ? (parsed as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+function pidAlive(pid: number | undefined): boolean {
+  if (!pid) return false;
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (err) {
+    return (err as NodeJS.ErrnoException).code === "EPERM";
+  }
+}
+
+function minutes(ms: number): string {
+  return `${Math.max(1, Math.round(ms / 60_000))} min`;
+}
+
+export class UnityEditor {
+  readonly options: UnityEditorOptions;
+  state: UnityEditorState = "stopped";
+  /** Why the editor is not coming back: set by the second crash or a failed restart. */
+  stoppedBecause: string | null = null;
+  playing = false;
+  paused = false;
+  /** How long the last cold start took to settle, for the readiness note. */
+  settledMs: number | null = null;
+  restarts = 0;
+  #child: UnityChild | null = null;
+  #exited: { code: number | null; signal: NodeJS.Signals | null } | null = null;
+  #exitPromise: Promise<void> | null = null;
+  #descriptor: UnityEditorDescriptor | null = null;
+  #runtime: UnityRuntimeDescriptor | null = null;
+  #watch: NodeJS.Timeout | null = null;
+  #lastHealthy = 0;
+  #recovering: Promise<void> | null = null;
+  #released = false;
+  #startedAt = Date.now();
+  /** Every pid this editor ever started, so a teardown can assert nothing survived. */
+  readonly pids: number[] = [];
+
+  constructor(options: UnityEditorOptions) {
+    this.options = options;
+  }
+
+  get pid(): number | undefined {
+    return this.#child?.pid;
+  }
+
+  get port(): number | null {
+    return this.#descriptor?.port ?? null;
+  }
+
+  get mode(): "editor" | "batchmode" | null {
+    return this.#descriptor?.mode ?? null;
+  }
+
+  get headless(): boolean {
+    return this.options.headless;
+  }
+
+  get root(): string {
+    return this.options.root;
+  }
+
+  get label(): string {
+    return this.options.label;
+  }
+
+  get editorVersion(): string | null {
+    return this.options.editorVersion ?? this.#descriptor?.unityVersion ?? null;
+  }
+
+  get runId(): string | null {
+    return this.options.runId ?? null;
+  }
+
+  get exited(): { code: number | null; signal: NodeJS.Signals | null } | null {
+    return this.#exited;
+  }
+
+  get released(): boolean {
+    return this.#released;
+  }
+
+  /** The command line, so a night's log and a test can say exactly what was launched. */
+  launchArgs(): string[] {
+    return ["-projectPath", this.options.root, "-logFile", this.options.logFile, ...(this.options.headless ? ["-batchmode"] : []), "-automated"];
+  }
+
+  /** Spawn, discover, settle. Throws a sentence when the editor never answers. */
+  async start(): Promise<void> {
+    this.#released = false;
+    this.stoppedBecause = null;
+    this.#startedAt = Date.now();
+    this.#setState("starting");
+    this.#spawn();
+    await this.#discover();
+    this.#setState("settling");
+    this.settledMs = await this.#settle();
+    this.#lastHealthy = Date.now();
