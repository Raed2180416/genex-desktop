+/**
+ * The gate inside `unity_command` (Unity in the studio, plan §3.4). The proxy carries every
+ * Pipeline command by name, and this is what makes the proxy safer than the raw CLI would be:
+ * a deny list nobody gets past (`eval` is unrestricted C# on the editor's main thread), the
+ * save rule (only the lease holder saves), the ownership rule every path-bearing argument is
+ * held to (the same `allowedFile` the Edit hook enforces), and the confirmation Unity wants on
+ * a mutation, injected only after the checks passed. Pure over its inputs, so the gate can be
+ * proven without an editor.
+ */
+import path from "node:path";
+import { allowedFile, ownershipReason, specOf, type Ownership } from "../substrate/ownership.ts";
+import { UNITY_DENIED_COMMANDS, UNITY_DENIED_PREFIXES, type UnityRole } from "../substrate/unity-types.ts";
+
+/** Argument keys that name a file or folder of the project; each is resolved and checked. */
+export const UNITY_PATH_ARG_KEYS = ["path", "save_path", "scene", "prefab", "asset", "file", "source", "destination"] as const;
+
+/** Commands (by prefix or name) that only read: no confirmation, no path mutation check. */
+export const UNITY_READ_ONLY_PREFIXES = ["get_", "list_", "find_", "capture_", "screenshot", "editor_status", "recompile_status", "test_status", "studio_"] as const;
+
+/** The two scene-list commands only the entry owner may run (plan §3.4). */
+const ENTRY_OWNER_ONLY = new Set(["add_scene_to_build", "remove_scene_from_build"]);
+
+export interface UnityGateInput {
+  command: string;
+  args: Record<string, unknown>;
+  role: UnityRole;
+  /** The delegation's ownership, when it has one; a director's session has none. */
+  ownership: Ownership | null;
+  ownsMain: boolean;
+  /** Does the caller hold the lease on the editor this command goes to? */
+  leaseOwner: boolean;
+  /** The project root the paths resolve under; absent means paths are only normalised. */
+  root?: string;
+}
+
+export type UnityGateResult = { ok: true; command: string; args: Record<string, unknown> } | { ok: false; reason: string };
+
+/** Anything that is not a read is a mutation: the studio confirms it, and the path rule applies. */
+export function isMutatingCommand(name: string): boolean {
+  const command = String(name ?? "").trim();
+  if (!command) return false;
+  return !UNITY_READ_ONLY_PREFIXES.some((prefix) => command.startsWith(prefix));
+}
+
+/** A path argument as a project-relative POSIX path, or null when it points outside the root. */
+export function projectRelative(value: string, root: string | undefined): string | null {
+  const raw = String(value ?? "").trim();
+  if (!raw) return null;
+  if (!root) return raw.replace(/^\.\//, "").split(path.sep).join("/");
+  const base = path.resolve(root);
+  const resolved = path.isAbsolute(raw) ? path.resolve(raw) : path.resolve(base, raw);
+  if (resolved !== base && !resolved.startsWith(base + path.sep)) return null;
+  return path.relative(base, resolved).split(path.sep).join("/");
+}
+
+export function gateUnityCommand(input: UnityGateInput): UnityGateResult {
+  const command = String(input.command ?? "").trim();
+  if (!command) return { ok: false, reason: "unity_command needs a command name — ask command=list for the catalogue" };
+  if (!/^[a-z][a-z0-9_.-]*$/i.test(command)) return { ok: false, reason: `"${command.slice(0, 40)}" is not a Pipeline command name` };
+  const lower = command.toLowerCase();
+  if (ENTRY_OWNER_ONLY.has(lower)) {
+    if (!input.ownsMain) return { ok: false, reason: `${command} changes the build's scene list, which belongs to whoever owns the entry — say so in your summary instead` };
+  } else if ((UNITY_DENIED_COMMANDS as readonly string[]).includes(lower)) {
+    return { ok: false, reason: `${command} is not available through the studio — it is refused for every session (the editor's own eval, menus, builds, quitting and the authoring root stay with the studio)` };
+  }
+  if (UNITY_DENIED_PREFIXES.some((prefix) => lower.startsWith(prefix))) {
+    return { ok: false, reason: `${command} changes packages or project settings, which the studio never lets a session do — note what the project needs in your summary` };
+  }
+  if (lower === "save_all" && !input.leaseOwner) {
+    return { ok: false, reason: "save_all is only allowed under your own editor lease — acquire the editor first (unity_session action=acquire)" };
+  }
+  const args: Record<string, unknown> = { ...(input.args ?? {}) };
+  for (const key of UNITY_PATH_ARG_KEYS) {
+    const value = args[key];
+    if (value === undefined || value === null || value === "") continue;
+    if (typeof value !== "string") return { ok: false, reason: `${key} must be a path string` };
+    const rel = projectRelative(value, input.root);
