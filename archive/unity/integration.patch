--- /dev/null
+++ b/src/substrate/unity.ts
@@ -0,0 +1,364 @@
+/**
+ * Unity — detection, the pin and the status sentence (Unity in the studio, 2026-09-11).
+ *
+ * The studio never installs an editor, activates a licence or accepts the EULA on its own: it
+ * looks for the `unity` CLI (the studio's own copy under `<userData>/tools/unity`, then PATH,
+ * then Unity Hub's), asks it which Unity 6 editors are installed and whether an account is
+ * signed in, and reports what it found in one sentence the picker can show. Every missing
+ * piece is a button on the Unity page — the user's click, every time (owner decision D2).
+ *
+ * Detection runs the CLI, so it is probed once and cached by studio-core (`unityStatus`), like
+ * Blender. `DetectOptions.probe` is the test seam: what `<cli> <args>` prints, or null when
+ * the binary is not there.
+ */
+import { access, constants, readFile, realpath } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { runCommand } from "./engines/claude-cli.ts";
+import type { UnityEditorInfo, UnityStatus } from "./unity-types.ts";
+
+/** The versions this integration was written and tested against. */
+export const UNITY_PIN = {
+  /** Oldest Unity CLI whose `--format json` shapes the studio parses. */
+  cliMinimum: "1.0.0",
+  /** The Pipeline package needs Unity 6.0; nothing older opens. */
+  editorMinimum: "6000.0",
+  /** The Unity 6 release the studio's template is proven on — the first real editor this code met (2026-09-11, the owner's Hub install). */
+  editorPreferred: "6000.6.0f1",
+  /** The Pipeline package the template pins and `unity pipeline install` is asked for. */
+  pipelinePackage: "com.unity.pipeline",
+  pipelineVersion: "0.6.0-exp.1",
+  /** The studio's own C# bridge, embedded as `Packages/<name>` and referenced as `file:<name>`. */
+  bridgePackage: "com.aigamestudio.bridge",
+  /**
+   * Unity's CLI CDN: `<base>latest-<channel>.json` is the channel manifest (`{ version, binaries:
+   * { "darwin-arm64": { filename, sha256, size }, … } }`) and `<base><version>/<filename>` the
+   * binary — read off Unity's own install script on 2026-09-11. The channel is fixed so a night
+   * never changes with a CLI release.
+   */
+  cliCdnBase: "https://public-cdn.cloud.unity3d.com/hub/prod/cli/",
+  cliInstallScript: "https://public-cdn.cloud.unity3d.com/hub/prod/cli/install.sh",
+  cliChannel: "beta",
+  /** Rough size for the button's line. */
+  cliBytes: 40 * 1024 * 1024,
+  editorBytes: 6 * 1024 * 1024 * 1024,
+} as const;
+
+export interface DetectOptions {
+  home?: string;
+  /** Test seam: the licence file to read (default Unity's `/Library/Application Support/Unity/Unity_lic.ulf`). */
+  licenceFile?: string;
+  /** Test seam: what `<cli> <args>` prints, or null when the binary is absent or failed. */
+  probe?: (binary: string, args: string[]) => Promise<string | null>;
+  /** Test seam: PATH to search instead of the process's. */
+  pathEnv?: string;
+  /**
+   * An isolated app (the smokes, a rig) looks only in its own folder and the places it was
+   * given (`pathEnv`, `home`) — never this Mac's PATH, home or Unity Hub — so what it finds
+   * does not depend on the machine it runs on.
+   */
+  isolated?: boolean;
+}
+
+/**
+ * Whether a message asks for the game to be made in Unity — "make me something in Unity" — and
+ * does not name three.js. The harness seed's `asksForUnity` keeps the same rule (tested equal).
+ */
+export function asksForUnityText(text: string): boolean {
+  const ask = String(text ?? "");
+  return /\bunity\b/i.test(ask) && !/\bthree\.?js\b/i.test(ask);
+}
+
+/**
+ * Detect-first: the studio's own copy, then PATH, then where Unity Hub puts the CLI. Isolated,
+ * this Mac's own places (its PATH, its home, the Hub app) are left out; a `pathEnv` or `home`
+ * given explicitly is still searched.
+ */
+export function unityCliCandidates(userData: string, home?: string, pathEnv?: string, isolated = false): Array<{ binary: string; source: "studio" | "path" | "hub" }> {
+  const out: Array<{ binary: string; source: "studio" | "path" | "hub" }> = [{ binary: studioUnityCli(userData), source: "studio" }];
+  for (const dir of (pathEnv ?? (isolated ? "" : process.env.PATH ?? "")).split(path.delimiter).filter(Boolean)) out.push({ binary: path.join(dir, "unity"), source: "path" });
+  if (home !== undefined || !isolated) out.push({ binary: path.join(home ?? os.homedir(), ".unity", "bin", "unity"), source: "hub" });
+  if (isolated) return out;
+  out.push({ binary: "/Applications/Unity Hub.app/Contents/Resources/cli/unity", source: "hub" });
+  out.push({ binary: "/usr/local/bin/unity", source: "hub" });
+  return out;
+}
+
+/** Where the studio's own CLI download lands. */
+export function studioUnityCli(userData: string): string {
+  return path.join(userData, "tools", "unity");
+}
+
+/** What the studio wrote down about the CLI it installed: version, channel, script, when. */
+export function studioUnityCliRecord(userData: string): string {
+  return path.join(userData, "tools", "unity-cli.json");
+}
+
+/** The environment every studio-side CLI call runs with: no update nag, no colour codes in the lines the page shows. */
+export function unityCliEnv(base: NodeJS.ProcessEnv = process.env): NodeJS.ProcessEnv {
+  return { ...base, UNITY_NO_UPDATE_CHECK: "1", NO_COLOR: "1" };
+}
+
+/** `6000.0.50f1` → [6000, 0, 50]; `1.2.3-beta.4` → [1, 2, 3]. */
+export function parseUnityVersion(text: string): [number, number, number] | null {
+  const m = /(\d+)\.(\d+)(?:\.(\d+))?/.exec(text ?? "");
+  if (!m) return null;
+  return [Number(m[1]), Number(m[2]), Number(m[3] ?? 0)];
+}
+
+export function unityVersionAtLeast(version: string, minimum: string): boolean {
+  const a = parseUnityVersion(version);
+  const b = parseUnityVersion(minimum);
+  if (!a || !b) return false;
+  for (let i = 0; i < 3; i++) {
+    if (a[i] > b[i]) return true;
+    if (a[i] < b[i]) return false;
+  }
+  return true;
+}
+
+/** Newest first, by the numeric triple then the full string. */
+export function sortEditors(editors: UnityEditorInfo[]): UnityEditorInfo[] {
+  return [...editors].sort((x, y) => {
+    const a = parseUnityVersion(x.version) ?? [0, 0, 0];
+    const b = parseUnityVersion(y.version) ?? [0, 0, 0];
+    for (let i = 0; i < 3; i++) if (a[i] !== b[i]) return b[i] - a[i];
+    return y.version.localeCompare(x.version);
+  });
+}
+
+/** The executable inside an install: an app bundle's `Contents/MacOS/Unity`, or the path itself. */
+export function editorBinaryFor(installPath: string): string {
+  return installPath.endsWith(".app") ? path.join(installPath, "Contents", "MacOS", "Unity") : installPath;
+}
+
+/** The editor whose version matches a project's `ProjectVersion.txt` exactly, else null. */
+export function editorForVersion(editors: UnityEditorInfo[], version: string): UnityEditorInfo | null {
+  return editors.find((e) => e.version === version) ?? null;
+}
+
+async function defaultProbe(binary: string, args: string[]): Promise<string | null> {
+  try {
+    await access(binary, constants.X_OK);
+  } catch {
+    return null;
+  }
+  const result = await runCommand(binary, args, { timeoutMs: 15_000, env: unityCliEnv() }).catch(() => null);
+  if (!result) return null;
+  // The CLI prints JSON on stdout and progress on stderr; a non-zero exit with JSON is still an answer.
+  return result.stdout || (result.code === 0 ? "" : null);
+}
+
+function parseJson(text: string | null): unknown {
+  if (!text) return null;
+  const trimmed = text.trim();
+  try {
+    return JSON.parse(trimmed);
+  } catch {
+    // ndjson or a preamble: take the last line that parses.
+    const lines = trimmed.split("\n").reverse();
+    for (const line of lines) {
+      try {
+        return JSON.parse(line);
+      } catch {
+        /* next */
+      }
+    }
+    return null;
+  }
+}
+
+/**
+ * The CLI wraps every `--json` answer (measured on 1.0.0-beta.8, Unity Hub's copy):
+ * `{ success, command, data, errors, warnings }` — the answer is `data`. An older or a bare
+ * shape passes through as it is.
+ */
+export function unwrapCliJson(parsed: unknown): unknown {
+  if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+    const envelope = parsed as Record<string, unknown>;
+    if (typeof envelope.success === "boolean" && "data" in envelope) return envelope.data;
+  }
+  return parsed;
+}
+
+/**
+ * `unity editors --installed --json`: on beta.8 each row is `{ version, alias, architecture,
+ * location, modules, default }` inside the envelope; a bare array or `{ editors: [...] }` is
+ * read too.
+ */
+export function parseEditors(text: string | null): UnityEditorInfo[] {
+  const parsed = unwrapCliJson(parseJson(text));
+  const list = Array.isArray(parsed) ? parsed : parsed && typeof parsed === "object" && Array.isArray((parsed as { editors?: unknown }).editors) ? (parsed as { editors: unknown[] }).editors : [];
+  const out: UnityEditorInfo[] = [];
+  for (const raw of list) {
+    if (!raw || typeof raw !== "object") continue;
+    const row = raw as Record<string, unknown>;
+    const version = String(row.version ?? row.editorVersion ?? "").trim();
+    const install = String(row.path ?? row.location ?? row.installPath ?? "").trim();
+    if (!version || !install) continue;
+    // beta.8 rows carry no source; an install under Unity Hub's editor folder is Hub's.
+    const source = row.source === "hub" || row.source === "cli" || row.source === "manual" ? row.source : /\/Unity\/Hub\/Editor\//.test(install) ? "hub" : null;
+    out.push({ version, path: install, binary: editorBinaryFor(install), source });
+  }
+  return sortEditors(out);
+}
+
+/**
+ * `unity auth status --json` → the account, or null when not signed in. On beta.8 the answer is
+ * `{ loggedIn, sessionState, mode, credentialSource, account }` (exit 3 when signed out, the
+ * JSON still on stdout); the signed-in `account` shape is unmeasured (spike S6), so the usual
+ * names are read.
+ */
+export function parseAuth(text: string | null): { name: string | null; email: string | null } | null {
+  const parsed = unwrapCliJson(parseJson(text)) as Record<string, unknown> | null;
+  if (!parsed || typeof parsed !== "object") return null;
+  const signedIn = parsed.signedIn === true || parsed.loggedIn === true || parsed.authenticated === true || parsed.status === "signed_in" || parsed.status === "authenticated";
+  if (!signedIn) return null;
+  // Measured signed in on beta.8: `user: { name, email }` beside `account: { foreignKey, source }`.
+  const holders = [parsed.user, parsed.account, parsed].filter((v) => v && typeof v === "object") as Record<string, unknown>[];
+  const pick = (keys: string[]): string | null => {
+    for (const holder of holders) for (const key of keys) if (typeof holder[key] === "string" && (holder[key] as string).trim()) return holder[key] as string;
+    return null;
+  };
+  return { name: pick(["name", "displayName", "username", "userName"]), email: pick(["email", "emailAddress"]) };
+}
+
+/**
+ * `unity license status --json` → the licence, or null when the CLI says nothing about it. On
+ * beta.8 the answer is `{ active, signedIn, authMode, licenses: [{ product, type, organization,
+ * expires }] }` — `product` is "Unity Personal", `type` the licence file's kind (ULF); a Hub
+ * activation counts here whether or not the CLI itself is signed in. The older `license --json`
+ * list (each row a licence active on this machine) is read too.
+ */
+export function parseLicence(text: string | null): { kind: string; active: boolean } | null {
+  const parsed = unwrapCliJson(parseJson(text));
+  if (!parsed || typeof parsed !== "object") return null;
+  if (Array.isArray(parsed)) {
+    const first = parsed.find((row) => row && typeof row === "object") as Record<string, unknown> | undefined;
+    if (!first) return null;
+    const kind = first.product ?? first.type ?? first.kind ?? first.plan ?? first.license ?? null;
+    // A row in `license list` is a licence active on this machine, so listed means active.
+    return { kind: kind ? String(kind) : "unknown", active: first.active === false ? false : true };
+  }
+  const record = parsed as Record<string, unknown>;
+  const first = Array.isArray(record.licenses) && record.licenses.length ? (record.licenses[0] as Record<string, unknown>) : record;
+  const kind = first.product ?? first.type ?? first.kind ?? first.plan ?? first.license ?? record.product ?? null;
+  const flag = [record.active, first.active, first.valid].find((v) => typeof v === "boolean") as boolean | undefined;
+  const active = flag ?? (first.status === "active" || first.status === "valid" || record.status === "active");
+  if (!kind && flag === undefined && !active) return null;
+  return { kind: kind ? String(kind) : "unknown", active };
+}
+
+export function parseCliVersion(text: string | null): string | null {
+  if (!text) return null;
+  const parsed = parseJson(text) as Record<string, unknown> | null;
+  const fromJson = parsed && typeof parsed === "object" ? parsed.version ?? parsed.cliVersion : null;
+  const m = /(\d+\.\d+\.\d+(?:-[0-9A-Za-z.]+)?)/.exec(fromJson ? String(fromJson) : text);
+  return m?.[1] ?? null;
+}
+
+/** Where Unity's licensing client keeps the activated licence on macOS (a ULF: XML with the entitlements). */
+export const UNITY_LICENCE_FILE = "/Library/Application Support/Unity/Unity_lic.ulf";
+
+/**
+ * The licence as the file on disk says it — no process, no keychain. Measured 2026-09-11: the
+ * ULF carries `<Entitlement Ns="unity_editor" Tag="UnityPersonal" Type="EDITOR" ValidTo="9999-12-31T00:00:00"/>`.
+ */
+export async function readLicenceFile(file: string = UNITY_LICENCE_FILE): Promise<{ kind: string; active: boolean; source: "file" } | null> {
+  const text = await readFile(file, "utf8").catch(() => null);
+  if (!text) return null;
+  const entitlements = [...text.matchAll(/<Entitlement\b([^>]*)\/>/g)].map((m) => m[1] ?? "");
+  const editor = entitlements.find((attrs) => /Type="EDITOR"/.test(attrs)) ?? entitlements[0];
+  if (editor === undefined) return null;
+  const tag = /Tag="([^"]*)"/.exec(editor)?.[1] ?? "";
+  const validTo = /ValidTo="([^"]*)"/.exec(editor)?.[1];
+  const until = validTo ? Date.parse(validTo) : NaN;
+  const active = !Number.isFinite(until) || until > Date.now();
+  // "UnityPersonal" → "Unity Personal", "UnityPro" → "Unity Pro".
+  const kind = tag ? tag.replace(/([a-z])([A-Z])/g, "$1 $2") : "Unity";
+  return { kind, active, source: "file" };
+}
+
+/**
+ * The CLI's own sign-in and licence answers — the two questions that make it read its keychain
+ * item on macOS. Never part of routine detection: asked by `unityStatus(recheck: true)` alone,
+ * which is the Unity page's "Check again" and the end of a sign-in the user started.
+ */
+export async function probeUnityAccount(cliPath: string, options: DetectOptions = {}): Promise<{ account: UnityStatus["account"]; licence: { kind: string; active: boolean; source: "cli" } | null }> {
+  const probe = options.probe ?? defaultProbe;
+  const account = parseAuth(await probe(cliPath, ["auth", "status", "--json"]).catch(() => null));
+  const licence = parseLicence(await probe(cliPath, ["license", "status", "--json"]).catch(() => null));
+  return { account, licence: licence ? { ...licence, source: "cli" } : null };
+}
+
+/** The status code and sentences for what is known — one rule for detection and for a later account check. */
+export function unityStatusOf(known: Omit<UnityStatus, "code" | "detail" | "remedy" | "pin">): UnityStatus {
+  const pin = { cliMinimum: UNITY_PIN.cliMinimum, editorMinimum: UNITY_PIN.editorMinimum, editorPreferred: UNITY_PIN.editorPreferred };
+  const { cli, editors, account, licence } = known;
+  if (!cli) {
+    return { ...known, editors: [], pin, code: "no_cli", detail: "the Unity command line is not on this Mac", remedy: `Install the Unity CLI (about ${Math.round(UNITY_PIN.cliBytes / 1_048_576)} MB, into the studio's own folder).` };
+  }
+  const usable = editors.filter((e) => unityVersionAtLeast(e.version, UNITY_PIN.editorMinimum));
+  const tooOld = editors.filter((e) => !unityVersionAtLeast(e.version, UNITY_PIN.editorMinimum));
+  if (!usable.length) {
+    return { ...known, editors: [], pin, code: "no_editor", detail: tooOld.length ? `Unity ${tooOld[0]!.version} is older than Unity 6` : "no Unity 6 editor on this Mac", remedy: `Install Unity ${UNITY_PIN.editorPreferred} (about ${Math.round(UNITY_PIN.editorBytes / 1_073_741_824)} GB, 10–20 minutes).` };
+  }
+  // An active licence is what the editor needs; the CLI's own sign-in is a separate session
+  // (measured 2026-09-11: Hub activated Unity Personal on this Mac while `unity auth status`
+  // said signed out). Only a licence positively reported as inactive blocks: no licence file
+  // and no answer is not evidence that the editor cannot run. Then the sign-in is the remedy
+  // without an account (Hub activates Personal on it), and Hub itself with one.
+  const inactive = licence !== null && !licence.active;
+  if (inactive && !account) {
+    return { ...known, editors: usable, pin, code: "not_signed_in", detail: `Unity ${usable[0]!.version} found; not signed in`, remedy: "Sign in to Unity (opens Unity's sign-in in your browser)." };
+  }
+  if (inactive) {
+    return { ...known, editors: usable, pin, code: "no_licence", detail: `Unity ${usable[0]!.version} found; no active licence`, remedy: "Open Unity Hub once to activate a licence on this Mac." };
+  }
+  return { ...known, editors: usable, pin, code: "ready", detail: `Unity ${usable[0]!.version} found` };
+}
+
+/**
+ * Detection, keychain-free: the CLI (`--version`), the installed editors (`editors --installed
+ * --json`) and the licence file on disk. It runs at boot, at every run start and on every
+ * cached recheck, so nothing here may make macOS prompt; the account is `probeUnityAccount`.
+ */
+export async function detectUnity(userData: string, enabled: boolean, options: DetectOptions = {}): Promise<UnityStatus> {
+  const probe = options.probe ?? defaultProbe;
+  const base = { enabled, cli: null, editors: [] as UnityEditorInfo[], account: null, accountChecked: false, licence: null };
+  let cli: UnityStatus["cli"] = null;
+  const seen = new Set<string>();
+  for (const candidate of unityCliCandidates(userData, options.home, options.pathEnv, options.isolated === true)) {
+    if (seen.has(candidate.binary)) continue;
+    seen.add(candidate.binary);
+    const output = await probe(candidate.binary, ["--version"]).catch(() => null);
+    if (output === null) continue;
+    const version = parseCliVersion(output) ?? "0.0.0";
+    cli = { version, path: await realpath(candidate.binary).catch(() => candidate.binary), source: candidate.source };
+    break;
+  }
+  if (!cli) return unityStatusOf(base);
+  let editors: UnityEditorInfo[] = [];
+  try {
+    editors = parseEditors(await probe(cli.path, ["editors", "--installed", "--json"]));
+  } catch (err) {
+    const pin = { cliMinimum: UNITY_PIN.cliMinimum, editorMinimum: UNITY_PIN.editorMinimum, editorPreferred: UNITY_PIN.editorPreferred };
+    return { ...base, cli, pin, code: "error", detail: `the Unity command line failed: ${String((err as Error)?.message ?? err)}` };
+  }
+  const licence = await readLicenceFile(options.licenceFile);
+  return unityStatusOf({ ...base, cli, editors, licence });
+}
+
+/** The status with the CLI's own account and licence answers folded in — `unityStatus(recheck: true)`. */
+export function withUnityAccount(status: UnityStatus, asked: Awaited<ReturnType<typeof probeUnityAccount>>): UnityStatus {
+  return unityStatusOf({ ...status, account: asked.account, accountChecked: true, licence: asked.licence ?? status.licence });
+}
+
+
+/**
+ * The loop's outage detector reads provider trouble off error text. A Unity failure must never
+ * spell those, or one compile error would burn the retry ladder meant for an API that is down.
+ */
+export function sanitizeUnityText(text: string): string {
+  return text.replace(/ECONNRESET|ECONNREFUSED|ETIMEDOUT|EAI_AGAIN|socket hang up|fetch failed|network error|temporarily unavailable|overloaded|bad gateway|service unavailable|gateway time-?out|internal server error|\b(529|502|503|504|500)\b/gi, "[…]");
+}
