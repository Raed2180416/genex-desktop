diff --git a/src/renderer/ui/UnityPanel.tsx b/src/renderer/ui/UnityPanel.tsx
new file mode 100644
index 0000000..d405fb7
--- /dev/null
+++ b/src/renderer/ui/UnityPanel.tsx
@@ -0,0 +1,238 @@
+/**
+ * The Unity page (Unity in the studio, owner decision D2) — the toggle beside the model ("this
+ * builder may open the Unity editor"), three detections with a dot each, and a button for
+ * every missing piece: the CLI into the studio's own folder, Unity's own sign-in in the
+ * browser, a Unity 6 editor behind the EULA checkbox. Nothing installs, signs in or accepts
+ * terms without the click. Self-contained like BlenderPanel: it reads the setting and the
+ * status itself and listens for `unity.setup` progress, so the picker and the Review room
+ * render the same component with no plumbing through the composer. Every sentence comes
+ * from words.ts (UNITY_WORDS), which the e2e runners assert.
+ */
+import type { JSX, ReactNode } from "react";
+import { useCallback, useEffect, useState } from "react";
+import type { UnitySetupView, UnityStatusView } from "../types.ts";
+import { UNITY_WORDS, unityRowWords } from "../words.ts";
+import { UnityLogo } from "./brand.tsx";
+import { Button } from "./Button.tsx";
+import { Toggle } from "./Toggle.tsx";
+
+export { unitySummary } from "../words.ts";
+
+export function useUnity(): {
+  status: UnityStatusView | null;
+  enabled: boolean;
+  /** editors run with no window (the setting `unityHeadless`); null until the settings arrive */
+  headless: boolean | null;
+  setHeadless: (on: boolean) => Promise<void>;
+  /** the step in flight (or its error), null when nothing is running */
+  setup: UnitySetupView | null;
+  setEnabled: (on: boolean) => Promise<void>;
+  recheck: () => Promise<void>;
+  installCli: () => Promise<void>;
+  signIn: () => Promise<void>;
+  installEditor: (acceptEula: boolean) => Promise<void>;
+  cancel: () => Promise<void>;
+} {
+  const [status, setStatus] = useState<UnityStatusView | null>(null);
+  const [enabled, setEnabledState] = useState(true);
+  const [headless, setHeadlessState] = useState<boolean | null>(null);
+  const [setup, setSetup] = useState<UnitySetupView | null>(null);
+
+  const refresh = useCallback(async (recheck = false) => {
+    try {
+      const next = await window.studio.unityStatus(recheck);
+      setStatus(next);
+      setEnabledState(next.enabled);
+    } catch {
+      /* a failed probe leaves the last answer on screen */
+    }
+  }, []);
+
+  useEffect(() => {
+    void refresh();
+    void window.studio
+      .settings()
+      .then((settings) => setHeadlessState(settings.unityHeadless !== false))
+      .catch(() => {});
+    return window.studio.onEvent((event) => {
+      if (event.type === "unity.setup") {
+        const payload = event.payload as UnitySetupView;
+        setSetup(payload.phase === "done" || payload.phase === "cancelled" ? null : payload);
+      }
+      if (event.type === "unity.changed") {
+        const payload = event.payload as UnityStatusView;
+        setStatus(payload);
+        setEnabledState(payload.enabled);
+      }
+      if (event.type === "settings.changed") {
+        const payload = event.payload as { unity?: boolean; unityHeadless?: boolean };
+        if (typeof payload?.unity === "boolean") setEnabledState(payload.unity);
+        if (typeof payload?.unityHeadless === "boolean") setHeadlessState(payload.unityHeadless);
+      }
+    });
+  }, [refresh]);
+
+  const begin = (step: UnitySetupView["step"]): void => setSetup({ step, phase: "running", progress: null, line: "" });
+
+  return {
+    status,
+    enabled,
+    setup,
+    setEnabled: async (on) => {
+      setEnabledState(on);
+      await window.studio.setSettings({ unity: on }).catch(() => {});
+    },
+    headless,
+    setHeadless: async (on) => {
+      setHeadlessState(on);
+      await window.studio.setSettings({ unityHeadless: on }).catch(() => {});
+    },
+    recheck: () => refresh(true),
+    installCli: async () => {
+      begin("cli");
+      const answer = await window.studio.installUnityCli().catch(() => ({ started: false }));
+      if (!answer.started) setSetup(null);
+    },
+    signIn: async () => {
+      begin("signin");
+      const answer = await window.studio.signInUnity().catch(() => ({ started: false }));
+      if (!answer.started) setSetup(null);
+    },
+    installEditor: async (acceptEula) => {
+      begin("editor");
+      const answer = await window.studio.installUnityEditor({ acceptEula }).catch(() => ({ started: false, error: undefined as string | undefined }));
+      if (!answer.started) setSetup(answer.error ? { step: "editor", phase: "error", progress: null, line: "", error: answer.error } : null);
+    },
+    cancel: async () => {
+      await window.studio.cancelUnitySetup().catch(() => {});
+      setSetup(null);
+    },
+  };
+}
+
+function Row({ id, label, line, done, children }: { id: "cli" | "account" | "editor"; label: string; line: string; done: boolean; children?: ReactNode }): JSX.Element {
+  return (
+    <div className="flex flex-col gap-1.5" data-unity-row={id} data-unity-done={done ? "true" : "false"}>
+      <div className="flex items-center gap-2 text-[11px]">
+        <span className="inline-block h-1.5 w-1.5 shrink-0 rounded-full" style={{ background: done ? "var(--green)" : "var(--orange)" }} />
+        <span className="shrink-0 font-medium text-ink">{label}</span>
+        <span className="min-w-0 flex-1 truncate text-ink-2">{line}</span>
+      </div>
+      {children}
+    </div>
+  );
+}
+
+/** The bar and the last line under a button while its step runs; `progress` null is a bar that breathes. */
+function Progress({ view, onCancel }: { view: UnitySetupView; onCancel: () => void }): JSX.Element {
+  const pct = view.progress === null ? null : Math.min(100, Math.max(0, Math.round(view.progress * 100)));
+  return (
+    <div className="flex flex-col gap-1">
+      <div className="relative h-1.5 w-full overflow-hidden rounded-full" style={{ background: "var(--inset)" }}>
+        <div className={`absolute inset-y-0 left-0 rounded-full transition-[width] duration-150 ${pct === null ? "animate-pulse" : ""}`} style={{ width: `${pct ?? 100}%`, background: "var(--accent)", opacity: pct === null ? 0.5 : 1 }} />
+      </div>
+      <div className="flex items-center gap-2 text-[10.5px] text-ink-3">
+        <span className="min-w-0 flex-1 truncate">{view.line || UNITY_WORDS.working}</span>
+        <Button variant="ghost" className="!h-[20px] !px-1.5 !text-[10.5px]" onClick={onCancel}>
+          {UNITY_WORDS.cancel}
+        </Button>
+      </div>
+    </div>
+  );
+}
+
+export function UnityPanel({ compact = false }: { compact?: boolean }): JSX.Element {
+  const { status, enabled, headless, setHeadless, setup, setEnabled, recheck, installCli, signIn, installEditor, cancel } = useUnity();
+  const [eula, setEula] = useState(false);
+  const rows = unityRowWords(status);
+  const busy = setup !== null && setup.phase === "running";
+  const hasCli = status?.cli !== null && status?.cli !== undefined;
+  const block = (step: UnitySetupView["step"], action: { label: string; onClick: () => void; disabled?: boolean; line: string }, extra?: ReactNode): JSX.Element => {
+    const mine = setup?.step === step ? setup : null;
+    return (
+      <div className="flex flex-col gap-2 rounded-[8px] border border-line bg-inset/40 px-2.5 py-2">
+        {extra}
+        {mine && mine.phase === "running" ? (
+          <Progress view={mine} onCancel={() => void cancel()} />
+        ) : (
+          <div className="flex items-center gap-2">
+            <Button variant="accent" className="!h-7 !px-2.5 !text-[11.5px]" disabled={busy || action.disabled === true} onClick={action.onClick}>
+              {mine?.phase === "error" ? UNITY_WORDS.tryAgain : action.label}
+            </Button>
+            <span className="min-w-0 flex-1 text-[10.5px] leading-[13px] text-ink-3">{action.line}</span>
+          </div>
+        )}
+        {mine?.phase === "error" ? <span className="text-[10.5px] leading-[13px] text-red">{mine.error ?? mine.line}</span> : null}
+      </div>
+    );
+  };
+
+  return (
+    <div className={`flex flex-col gap-2 ${compact ? "px-2 py-1.5" : ""}`} data-unity-panel>
+      <div className="flex items-center gap-2">
+        <span className="flex min-w-0 flex-1 flex-col">
+          <span className="inline-flex items-center gap-1.5 text-[12px] font-medium text-ink">
+            <UnityLogo height={12} />
+            {UNITY_WORDS.pageTitle}
+          </span>
+          <span className="text-[10.5px] leading-[13px] text-ink-3">{UNITY_WORDS.pageSubtitle}</span>
+        </span>
+        <Toggle on={enabled} onChange={(next) => void setEnabled(next)} size="sm" label="" />
+      </div>
+
+      {status === null ? <span className="text-[11px] text-ink-3">{UNITY_WORDS.looking}</span> : null}
+
+      <Row id="cli" label={UNITY_WORDS.rowCli} line={rows.cli.line} done={rows.cli.done}>
+        {status && !rows.cli.done ? block("cli", { label: UNITY_WORDS.installCli, onClick: () => void installCli(), line: UNITY_WORDS.cliSize }) : null}
+      </Row>
+
+      <Row id="account" label={UNITY_WORDS.rowAccount} line={rows.account.line} done={rows.account.done}>
+        {rows.account.licence ? (
+          <span className="pl-3.5 text-[10.5px] leading-[13px] text-ink-3" data-unity-licence>
+            {rows.account.licence}
+          </span>
+        ) : null}
+        {status && !status.account ? block("signin", { label: UNITY_WORDS.signIn, onClick: () => void signIn(), disabled: !hasCli, line: hasCli ? UNITY_WORDS.signInHow : UNITY_WORDS.needsCli }) : null}
+      </Row>
+
+      <Row id="editor" label={UNITY_WORDS.rowEditor} line={rows.editor.line} done={rows.editor.done}>
+        {status && !rows.editor.done
+          ? block(
+              "editor",
+              { label: `${UNITY_WORDS.installEditor} (${status.pin.editorPreferred})`, onClick: () => void installEditor(eula), disabled: !hasCli || !eula, line: hasCli ? UNITY_WORDS.editorSize : UNITY_WORDS.needsCli },
+              <label className="flex cursor-pointer items-center gap-1.5 text-[10.5px] leading-[13px] text-ink-2">
+                <input type="checkbox" checked={eula} onChange={(event) => setEula(event.target.checked)} disabled={busy} data-unity-eula />
+                <span>{UNITY_WORDS.eula}</span>
+              </label>,
+            )
+          : null}
+      </Row>
+
+      {/* Where the editor runs (2026-09-11, the first real night: Unity windows opened on the
+          owner's Mac when they expected the game inside the studio). Hidden is the default. */}
+      <div className="flex flex-col gap-1" data-unity-window={headless === false ? "shown" : "hidden"}>
+        <div className="flex items-center gap-2 text-[11px]">
+          <span className="shrink-0 font-medium text-ink">{UNITY_WORDS.windowLabel}</span>
+          <div className="flex items-center gap-1" role="group" aria-label={UNITY_WORDS.windowLabel}>
+            <Button variant={headless === false ? "ghost" : "default"} className="!h-[22px] !px-2 !text-[10.5px]" aria-pressed={headless !== false} disabled={headless === null} onClick={() => void setHeadless(true)}>
+              {UNITY_WORDS.windowHidden}
+            </Button>
+            <Button variant={headless === false ? "default" : "ghost"} className="!h-[22px] !px-2 !text-[10.5px]" aria-pressed={headless === false} disabled={headless === null} onClick={() => void setHeadless(false)}>
+              {UNITY_WORDS.windowShown}
+            </Button>
+          </div>
+        </div>
+        <span className="text-[10.5px] leading-[13px] text-ink-3">{headless === false ? UNITY_WORDS.windowShownHint : UNITY_WORDS.windowHiddenHint}</span>
+      </div>
+
+      <div className="flex items-center gap-2">
+        <span className="min-w-0 flex-1 text-[10.5px] leading-[13px] text-ink-3">{UNITY_WORDS.footer}</span>
+        {!busy ? (
+          <Button variant="ghost" className="!h-[22px] !px-1.5 !text-[10.5px]" onClick={() => void recheck()}>
+            {UNITY_WORDS.checkAgain}
+          </Button>
+        ) : null}
+      </div>
+    </div>
+  );
+}
