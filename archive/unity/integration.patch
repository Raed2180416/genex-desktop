+  /** One PNG from the editor: `capture_game_view` (or the Scene view), inline base64 or a file under the project. */
+  async capture(request: UnityCaptureRequest = {}): Promise<UnityCapture> {
+    const width = clampSize(request.width, UNITY_VIEW.width);
+    const height = clampSize(request.height, UNITY_VIEW.height);
+    let source: "camera" | "screen" = request.source ?? "camera";
+    let note: string | null = null;
+    // Measured 2026-09-11 (spike S1): a `-batchmode` editor has no backbuffer, so `screen` is
+    // black; the camera's frame is byte-identical to a windowed one. A HUD on a Screen Space –
+    // Camera canvas is in that frame; OnGUI and Screen Space – Overlay are not.
+    if (source === "screen" && this.editor.headless) {
+      source = "camera";
+      note = "a hidden editor has no screen — this is the camera's frame, without overlay UI (a HUD on a Screen Space – Camera canvas is in it)";
+    } else if (source === "screen" && !this.editor.playing) {
+      source = "camera";
+      note = "the screen (overlay UI) is only available in Play mode — this is the camera's frame";
+    }
+    const command = request.view === "scene" ? "capture_scene_view" : "capture_game_view";
+    // Measured 2026-09-11: the answer is `{ width, height, encoding: "png", base64, bytes, source, savedPath }`; `save_path` resolves under Assets/, so the studio never sends it.
+    const parameters: Record<string, unknown> = { width, height, include_inline_image: true, ...(command === "capture_game_view" ? { source } : {}), ...(request.camera ? { camera: request.camera } : {}) };
+    const shot = await this.#exec(command, parameters, 60_000);
+    if (!shot.ok) throw new Error(shot.error ?? `${command} failed`);
+    const r = record(shot.result) ?? {};
+    const inline = [r.image, r.inlineImage, r.base64, r.data].find((v): v is string => typeof v === "string" && v.length > 0);
+    let png: Buffer | null = null;
+    if (inline) png = Buffer.from(inline.replace(/^data:image\/png;base64,/, ""), "base64");
+    else if (typeof r.path === "string" && r.path) {
+      const file = path.isAbsolute(r.path) ? path.resolve(r.path) : path.resolve(this.root, r.path);
+      if (file === this.root || !file.startsWith(this.root + path.sep)) throw new Error(`the editor saved the capture outside the project: ${r.path}`);
+      png = await readFile(file);
+    }
+    if (!png || !isPng(png)) throw new Error(`${command} answered without a PNG`);
+    return { png, width: num(r.width) ?? width, height: num(r.height) ?? height, source, note };
+  }
+
+  #statsOf(bitmap: Bitmap): PreviewPixelStats {
