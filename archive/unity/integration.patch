+/** Width and height off a PNG's IHDR, or null when the file is not one. */
+async function pngSize(file: string): Promise<{ width: number; height: number } | null> {
+  const head = await readFile(file).catch(() => null);
+  if (!head || head.length < 24 || head.toString("ascii", 1, 4) !== "PNG") return null;
+  return { width: head.readUInt32BE(16), height: head.readUInt32BE(20) };
