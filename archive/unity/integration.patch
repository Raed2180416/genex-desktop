+  /** The `window.__studio` vocabulary → the bridge's commands; anything else is `{ __missing }`. */
+  async studioCall(method: string, arg?: unknown): Promise<unknown> {
+    // The seed's `step(ms)` is milliseconds everywhere (the browser shim runs round(ms / frameMs)
+    // simulated frames); the bridge steps fixed 1/60 s frames, so convert here, never in the seed.
+    if (method === "step") return this.#step(Math.max(1, Math.round((num(arg) ?? 1000) / (1000 / 60))));
+    if (method === "cameras") {
