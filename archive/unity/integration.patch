+describe("the Pipeline package in a project", () => {
+  const MANIFEST = `${JSON.stringify(
+    {
+      dependencies: {
+        "com.unity.collab-proxy": "2.5.2",
+        "com.unity.ide.rider": "3.0.31",
+        "com.unity.inputsystem": "1.11.2",
+        "com.unity.modules.ui": "1.0.0",
+        "com.unity.render-pipelines.universal": "17.0.3",
+      },
+    },
+    null,
+    2,
+  )}\n`;
+
+  /** Lines of a manifest with trailing commas dropped, so a moved comma is not a changed line. */
+  const lines = (text: string): string[] => text.split("\n").map((line) => line.replace(/,$/, ""));
+
+  async function project(root: string): Promise<{ dir: string; bridge: string }> {
+    const dir = path.join(root, "game");
+    await mkdir(path.join(dir, "Packages"), { recursive: true });
+    await mkdir(path.join(dir, "Assets"), { recursive: true });
+    await writeFile(path.join(dir, "Packages", "manifest.json"), MANIFEST);
+    const bridge = path.join(root, "resources", "unity-bridge");
+    await mkdir(path.join(bridge, "Editor"), { recursive: true });
+    await writeFile(path.join(bridge, "package.json"), '{ "name": "com.aigamestudio.bridge", "version": "0.1.0" }\n');
+    await writeFile(path.join(bridge, "Editor", "StudioBridge.cs"), "// bridge\n");
+    return { dir, bridge };
+  }
+
+  it("writes exactly the two manifest lines and the bridge folder, keeps Unity's formatting, and is idempotent", async () => {
+    const root = await tmpDir("studio-unity-pipeline-");
+    const { dir, bridge } = await project(root);
+    const progress: UnitySetupView[] = [];
+    const first = await installPipelineIntoProject(dir, bridge, (p) => progress.push(p));
+    assert.deepEqual(first, { manifestChanged: true, bridgeWritten: true });
+    const after = await readFile(path.join(dir, "Packages", "manifest.json"), "utf8");
+    assert.ok(after.endsWith("}\n"), "trailing newline, as Unity writes it");
+    const before = lines(MANIFEST);
+    const added = lines(after).filter((line) => !before.includes(line));
+    assert.deepEqual(added.sort(), [`    "com.aigamestudio.bridge": "file:com.aigamestudio.bridge"`, `    "com.unity.pipeline": "0.6.0-exp.1"`], "exactly the two lines the sheet showed");
+    assert.ok(before.every((line) => lines(after).includes(line)), "nothing else moved or went");
+    const parsed = JSON.parse(after) as { dependencies: Record<string, string> };
+    assert.deepEqual(Object.keys(parsed.dependencies), [...Object.keys(parsed.dependencies)].sort(), "still sorted, as Unity keeps it");
+    assert.equal(parsed.dependencies["com.unity.pipeline"], UNITY_PIN.pipelineVersion);
+    assert.equal(parsed.dependencies["com.aigamestudio.bridge"], "file:com.aigamestudio.bridge");
+    assert.equal(await readFile(path.join(dir, "Packages", "com.aigamestudio.bridge", "Editor", "StudioBridge.cs"), "utf8"), "// bridge\n");
+    assert.ok(progress.every((p) => p.step === "pipeline" && p.phase === "running"));
+    assert.equal(progress.length, 2, "one line for the manifest, one for the folder");
+
+    const second = await installPipelineIntoProject(dir, bridge, () => {});
+    assert.deepEqual(second, { manifestChanged: false, bridgeWritten: false });
+    assert.equal(await readFile(path.join(dir, "Packages", "manifest.json"), "utf8"), after, "byte for byte");
+
+    // A changed bridge in the studio's resources is written again; the manifest is not touched.
+    await writeFile(path.join(bridge, "Editor", "StudioBridge.cs"), "// bridge v2\n");
+    const third = await installPipelineIntoProject(dir, bridge, () => {});
+    assert.deepEqual(third, { manifestChanged: false, bridgeWritten: true });
+    assert.equal(await readFile(path.join(dir, "Packages", "com.aigamestudio.bridge", "Editor", "StudioBridge.cs"), "utf8"), "// bridge v2\n");
+    // A manifest that pinned an older Pipeline is moved to the pin, in place.
+    await writeFile(path.join(dir, "Packages", "manifest.json"), after.replace("0.6.0-exp.1", "0.5.0-exp.2"));
+    const fourth = await installPipelineIntoProject(dir, bridge, () => {});
+    assert.deepEqual(fourth, { manifestChanged: true, bridgeWritten: false });
+    assert.equal(await readFile(path.join(dir, "Packages", "manifest.json"), "utf8"), after);
+  });
+
+  it("appends when the manifest is not sorted, and refuses what is not a Unity project", async () => {
+    const root = await tmpDir("studio-unity-pipeline-");
+    const { dir, bridge } = await project(root);
+    await writeFile(path.join(dir, "Packages", "manifest.json"), `${JSON.stringify({ dependencies: { "com.unity.ugui": "2.0.0", "com.unity.inputsystem": "1.11.2" } }, null, 2)}\n`);
+    await installPipelineIntoProject(dir, bridge, () => {});
+    const parsed = JSON.parse(await readFile(path.join(dir, "Packages", "manifest.json"), "utf8")) as { dependencies: Record<string, string> };
+    assert.deepEqual(Object.keys(parsed.dependencies), ["com.unity.ugui", "com.unity.inputsystem", "com.aigamestudio.bridge", "com.unity.pipeline"]);
+    await assert.rejects(installPipelineIntoProject(path.join(root, "nowhere"), bridge, () => {}), /no Packages\/manifest\.json — it is not a Unity project/);
+    await writeFile(path.join(dir, "Packages", "manifest.json"), "{ not json");
+    await assert.rejects(installPipelineIntoProject(dir, bridge, () => {}), /not the JSON Unity writes/);
+    await writeFile(path.join(dir, "Packages", "manifest.json"), MANIFEST);
+    await assert.rejects(installPipelineIntoProject(dir, path.join(root, "no-bridge"), () => {}), /bridge package is missing/);
+  });
+
+  it("the fake CLI's own `pipeline install` edits the manifest in its cwd, for the lanes that drive it as a process", async () => {
+    const root = await tmpDir("studio-unity-fake-pipeline-");
+    const { dir } = await project(root);
+    const cli = await fakeUnityCli(path.join(root, "cli"));
+    const { spawn } = await import("node:child_process");
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(cli.binary, ["pipeline", "install"], { cwd: dir, stdio: "ignore" });
+      child.once("exit", (code) => (code === 0 ? resolve() : reject(new Error(`exit ${code}`))));
+      child.once("error", reject);
+    });
+    const parsed = JSON.parse(await readFile(path.join(dir, "Packages", "manifest.json"), "utf8")) as { dependencies: Record<string, string> };
+    assert.equal(parsed.dependencies["com.unity.pipeline"], UNITY_PIN.pipelineVersion);
+    assert.deepEqual((await cli.calls()).at(-1), ["pipeline", "install"]);
+  });
+});
