+/** `pgrep -f <pattern>`: the pids, or none (pgrep exits 1 when nothing matches). */
+async function pgrep(pattern: string): Promise<number[]> {
+  try {
+    const { stdout } = await execFileAsync("pgrep", ["-f", pattern]);
