+      await sleep(200);
+    }
+    return { ok: false, frames, exceptions, ms: Date.now() - started, ...(bridge ? {} : { error: "the studio bridge is not in this project" }) };
+  }
+
+  /** `editor_play`, then `studio_ready` until two frames rendered or the budget runs out. */
+  async play(scene?: string, opts: { timeoutMs?: number } = {}): Promise<{ ok: boolean; frames: number; exceptions: number; ms: number; error?: string }> {
