+      return { ok: false, reason: ownershipReason(rel, input.ownership) };
+    }
+    args[key] = rel;
+  }
+  if (isMutatingCommand(lower) && args.dry_run !== true && args.dry_run !== "true") args.confirm = true;
+  return { ok: true, command, args };
