+
+/** `KeyboardEvent.code` → the Input System's control name (measured 2026-09-11: `w` is accepted as `key=W`). */
+const CODE_TO_UNITY: Record<string, string> = {
+  Space: "space",
+  Enter: "enter",
+  Escape: "escape",
+  Tab: "tab",
+  Backspace: "backspace",
+  Delete: "delete",
+  Insert: "insert",
+  Home: "home",
+  End: "end",
+  PageUp: "pageUp",
+  PageDown: "pageDown",
+  ShiftLeft: "leftShift",
+  ShiftRight: "rightShift",
+  ControlLeft: "leftCtrl",
+  ControlRight: "rightCtrl",
+  AltLeft: "leftAlt",
+  AltRight: "rightAlt",
+  MetaLeft: "leftMeta",
+  MetaRight: "rightMeta",
+  ArrowUp: "upArrow",
+  ArrowDown: "downArrow",
+  ArrowLeft: "leftArrow",
+  ArrowRight: "rightArrow",
+  Minus: "minus",
+  Equal: "equals",
+  Comma: "comma",
+  Period: "period",
+  Slash: "slash",
+  Backslash: "backslash",
+  Semicolon: "semicolon",
+  Quote: "quote",
+  BracketLeft: "leftBracket",
+  BracketRight: "rightBracket",
+  Backquote: "backquote",
+  CapsLock: "capsLock",
+};
+
+/** A key as the computer tool or a play script names it → the Input System's name; an unknown name passes through as given. */
+export function unityKeyName(raw: string): string {
+  const text = String(raw ?? "").trim();
+  if (!text) return "";
+  const known = normalizeKey(text);
+  if (!known) return text;
+  const code = known.code;
+  if (CODE_TO_UNITY[code]) return CODE_TO_UNITY[code]!;
+  if (/^Key[A-Z]$/.test(code)) return code.slice(3).toLowerCase();
+  if (/^Digit[0-9]$/.test(code)) return `digit${code.slice(5)}`;
+  if (/^F([1-9]|1[0-9]|2[0-4])$/.test(code)) return code.toLowerCase();
+  // Already an Input System name (`leftShift`, `upArrow`) or something the studio does not know: as given.
+  return text;
+}
+
+/** A command whose result is a JSON string (recompile_status does that), read as the object it spells. */
+function parseJsonText(text: string): Record<string, unknown> | null {
+  try {
+    const value = JSON.parse(text) as unknown;
+    return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function num(value: unknown): number | null {
+  const n = typeof value === "number" ? value : Number(value);
+  return Number.isFinite(n) ? n : null;
+}
+
+function record(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+}
+
+function clampSize(value: unknown, fallback: number): number {
+  const n = num(value);
+  return n === null ? fallback : Math.max(16, Math.min(UNITY_CAPTURE_MAX_PX, Math.round(n)));
+}
+
+/** `{ entries: [...] }`, `{ logs: [...] }` or a bare array → the port's console entries. */
+function consoleEntriesOf(result: unknown): PreviewConsoleEntry[] {
+  const raw = Array.isArray(result) ? result : (record(result)?.entries ?? record(result)?.logs ?? record(result)?.messages);
+  if (!Array.isArray(raw)) return [];
+  const out: PreviewConsoleEntry[] = [];
+  for (const item of raw) {
+    const row = record(item);
+    if (!row) continue;
+    const at = num(row.at) ?? num(row.time) ?? num(row.timestamp) ?? (typeof row.timestampUtc === "string" ? Date.parse(row.timestampUtc) : typeof row.time === "string" ? Date.parse(row.time) : NaN);
+    const level = String(row.level ?? row.severity ?? row.type ?? "log").toLowerCase();
+    const message = String(row.message ?? row.text ?? row.condition ?? "");
+    out.push({ at: Number.isFinite(at) ? at : Date.now(), level: level === "exception" || level === "assert" ? "error" : level === "warn" ? "warning" : level, message: sanitizeUnityText(message) });
+  }
+  return out;
+}
