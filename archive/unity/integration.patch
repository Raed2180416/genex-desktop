+    const descriptor = await this.#readDescriptor();
+    if (descriptor && descriptor.pid === this.#child?.pid) this.#descriptor = descriptor;
+    if ((await this.status()) !== null) {
+      this.#lastHealthy = Date.now();
+      return;
+    }
+    const exitedMeanwhile = this.#exitReason();
+    if (exitedMeanwhile) return this.#crashed(exitedMeanwhile);
+    const silent = Date.now() - this.#lastHealthy;
+    if (silent > stale) return this.#crashed(`no answer from the editor for ${Math.round(silent / 1000)} s`);
+  }
+
+  /** "the editor exited (1)" once the child's exit event has fired, else null. */
+  #exitReason(): string | null {
+    const exited = this.#exited;
+    return exited ? `the editor exited (${exited.code ?? exited.signal ?? "no code"})` : null;
+  }
+
+  /** One automatic restart; the second failure ends the lease with `stoppedBecause`. */
+  #crashed(reason: string): void {
+    if (this.#recovering || this.#released) return;
+    this.#stopWatch();
+    this.#setState("crashed", reason);
+    if (this.restarts >= 1) {
+      this.stoppedBecause = `the editor crashed twice (${reason})`;
+      return;
+    }
+    this.restarts++;
+    this.#recovering = (async () => {
+      try {
+        await this.#killTree();
+        // Never a second editor on a folder the first still holds: Unity refuses the project
+        // lock and the studio would be talking to a process it cannot see.
+        if (!this.#exited && pidAlive(this.#child?.pid)) throw new Error(`pid ${this.#child?.pid ?? "?"} did not exit on SIGKILL`);
+        await this.#forgetDescriptors();
+        this.#spawn();
+        await this.#discover();
+        this.settledMs = await this.#settle();
+        this.#lastHealthy = Date.now();
+        this.#setState("restarted", `restarted after ${reason}`);
+        this.#startWatch();
+      } catch (err) {
+        this.stoppedBecause = sanitizeUnityText(`the editor crashed (${reason}) and did not come back: ${String((err as Error)?.message ?? err)}`);
+        this.state = "crashed";
+      } finally {
+        this.#recovering = null;
+      }
+    })();
+  }
+
+  /** The recovery in flight, for a caller that wants to wait it out rather than retry blind. */
+  recovering(): Promise<void> | null {
+    return this.#recovering;
+  }
+
+  async #waitExit(ms: number): Promise<boolean> {
+    if (this.#exited || !this.#exitPromise) return true;
+    const timer = new Promise<false>((resolve) => setTimeout(() => resolve(false), ms));
+    return Promise.race([this.#exitPromise.then(() => true), timer]);
+  }
+
+  async #killTree(): Promise<void> {
+    const pid = this.#child?.pid;
+    if (!pid || this.#exited) return;
+    killTree(pid, "SIGTERM");
+    if (await this.#waitExit(this.options.killGraceMs ?? UNITY_KILL_GRACE_MS)) return;
+    killTree(pid, "SIGKILL");
+    await this.#waitExit(3_000);
+  }
+
+  /** Remove the descriptors this editor wrote, and only those: a foreign editor's stay. */
+  async #forgetDescriptors(): Promise<void> {
+    const mine = this.#child?.pid;
+    for (const file of [pipelineDescriptorPath(this.options.root), pipelineRuntimeDescriptorPath(this.options.root), pipelineRuntimeDescriptorLegacyPath(this.options.root)]) {
+      const text = await readFile(file, "utf8").catch(() => null);
+      const parsed = text ? parseJson(text) : null;
+      if (parsed && (parsed.pid === mine || parsed.pid === undefined)) await rm(file, { force: true }).catch(() => {});
+    }
+    this.#descriptor = null;
+    this.#runtime = null;
+  }
+
+  /**
+   * Leave Play mode if playing (never `save_all`: the studio does not save an agent's dirty
+   * scene), SIGTERM, SIGKILL the tree after the grace, and wait for the descriptor to go.
+   */
+  async release(): Promise<void> {
+    if (this.#released) return;
+    this.#stopWatch();
+    if (this.#recovering) await this.#recovering.catch(() => {});
+    if (this.playing && !this.#exited) await this.exec("editor_stop", {}, { timeoutMs: 5_000 }).catch(() => null);
+    this.#released = true;
+    await this.#killTree();
+    const deadline = Date.now() + 3_000;
+    while (Date.now() < deadline) {
+      const descriptor = await this.#readDescriptor();
+      if (!descriptor || descriptor.pid !== this.#child?.pid) break;
+      await sleep(50);
+    }
+    await this.#forgetDescriptors();
+    this.playing = false;
+    this.paused = false;
+    this.#setState("stopped", "released");
+  }
+}
