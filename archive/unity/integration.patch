+  // ── input ────────────────────────────────────────────────────────────────────────────────
+
+  /** A point in capture pixels (origin top-left) → Unity's runtime coordinates (origin bottom-left). */
+  toUnityPoint(x: number, y: number, exact: boolean): { x: number; y: number } {
