+const UNITY_MODULES = ["accessibility", "ai", "androidjni", "animation", "assetbundle", "audio", "cloth", "director", "imageconversion", "imgui", "jsonserialize", "particlesystem", "physics", "physics2d", "screencapture", "terrain", "terrainphysics", "tilemap", "ui", "uielements", "umbra", "unityanalytics", "unitywebrequest", "unitywebrequestassetbundle", "unitywebrequestaudio", "unitywebrequesttexture", "unitywebrequestwww", "vehicles", "video", "wind", "xr"];
