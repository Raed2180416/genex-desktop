+// The built-in modules and uGUI this template promises every builder. The first real night
+// (2026-09-11) lost its car to `error CS1069: ParticleSystem … forwarded to
+// UnityEngine.ParticleSystemModule` and its HUD to a missing `UnityEngine.UI`: a manifest that
+// lists only URP and the Input System resolves nine modules and no uGUI, because Unity adds the
+// module lines on project creation, not on open. Packages/manifest.json now lists them all, and
+// this file references one type from each, so the template itself stops compiling the day a
+// module is dropped — a fact the studio's Unity runner measures on a real editor.
+using UnityEngine;
+using UnityEngine.UI;
+
+internal static class StudioModules
+{
+    // Never called; the references are the point.
+    internal static readonly System.Type[] Promised =
+    {
+        typeof(ParticleSystem),                          // com.unity.modules.particlesystem
+        typeof(AudioSource),                             // com.unity.modules.audio
+        typeof(WheelCollider),                           // com.unity.modules.vehicles
+        typeof(Terrain),                                 // com.unity.modules.terrain
+        typeof(Rigidbody2D),                             // com.unity.modules.physics2d
+        typeof(Cloth),                                   // com.unity.modules.cloth
+        typeof(Animator),                                // com.unity.modules.animation
+        typeof(Canvas),                                  // com.unity.modules.ui
+        typeof(Text),                                    // com.unity.ugui
+        typeof(UnityEngine.AI.NavMeshAgent),             // com.unity.modules.ai
+        typeof(UnityEngine.Video.VideoPlayer),           // com.unity.modules.video
+        typeof(UnityEngine.Playables.PlayableDirector),  // com.unity.modules.director
+        typeof(UnityEngine.Tilemaps.Tilemap),            // com.unity.modules.tilemap
+        typeof(UnityEngine.Networking.UnityWebRequest),  // com.unity.modules.unitywebrequest
+    };
+}
