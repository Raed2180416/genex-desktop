+// The studio_* commands that need the editor: which cameras there are, switching the one the
+// game view renders from, whether the game is ready after play, and the editor's own render
+// counters. Static methods under `[CliCommand]` from Unity's Pipeline package, main thread.
+using System.Collections.Generic;
+using AIGameStudio.Bridge;
+using UnityEditor;
+#if STUDIO_PIPELINE
+using Unity.Pipeline.Commands;
+#endif
+
+namespace AIGameStudio.Bridge.Editor
+{
+    public static class StudioEditorCommands
+    {
+#if STUDIO_PIPELINE
+        [CliCommand("studio_cameras", "Every camera the studio can photograph from: default, the registered ones, and eye:here at the player's head.")]
+#endif
+        public static object StudioCameras()
+        {
+            return new Dictionary<string, object> { ["cameras"] = StudioBridge.Cameras(), ["current"] = StudioBridge.CurrentCamera };
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_camera", "Switch the camera the game view renders from, without touching the scene.")]
+#endif
+        public static object StudioCamera(
+#if STUDIO_PIPELINE
+            [CliArg("name", "A name from studio_cameras", Required = true)]
+#endif
+            string name)
+        {
+            return StudioBridge.SwitchCamera(name);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_ready", "Whether the game is playing and has drawn its first frames: { playing, frame, exceptions, firstFrameMs }.", MainThreadRequired = true)]
+#endif
+        public static object StudioReady()
+        {
+            return StudioBridge.Ready(EditorApplication.isPlaying);
+        }
+
+#if STUDIO_PIPELINE
+        [CliCommand("studio_render_stats", "The editor's render counters for the last frame: draw calls, triangles, vertices, frame time.")]
+#endif
+        public static object StudioRenderStats()
+        {
+            return new Dictionary<string, object>
+            {
+                ["drawCalls"] = UnityStats.drawCalls,
+                ["triangles"] = UnityStats.triangles,
+                ["vertices"] = UnityStats.vertices,
+                ["frameTimeMs"] = UnityStats.frameTime * 1000f,
+                ["renderTimeMs"] = UnityStats.renderTime * 1000f,
+                ["playing"] = EditorApplication.isPlaying,
+            };
+        }
+    }
+}
