index 0000000..be2ce98
--- /dev/null
+++ b/src/main/unity-pool.ts
@@ -0,0 +1,424 @@
+/**
+ * The editors of a night (Unity in the studio, plan §3.1 and owner decision D4): per run one
+ * **live** editor — the director's, on the integration worktree, the one the stage shows —
+ * and `queueSlots` (default one) **transient** editors the workers validate through, one at a
+ * time, leased by worktree path with a renewable lease.
+ *
+ * A lease is refcounted per root: the same worktree while held is the same handle, so a
+ * worker's tools, the evidence pass on its editor and a director's `validate` on the same
+ * folder share one process. A waiter is told where it stands (`queued`, `aheadMinutes`) and
+ * the facet loop turns a timed-out wait into an observation hold, never a lost round.
+ *
+ * The editor binary is the one whose version matches the project's `ProjectVersion.txt`
+ * exactly; a mismatch is a refusal with a remedy, never a silent upgrade (Unity rewrites the
+ * whole Library and touches ProjectSettings on upgrade).
+ */
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { editorForVersion } from "../substrate/unity.ts";
+import { UNITY_HANDLE_PREFIX, type UnityEditorEvent, type UnityEditorState, type UnityStatus } from "../substrate/unity-types.ts";
+import { UnityEditor, type UnitySpawn } from "./unity-editor.ts";
+import { UnityPort, type UnityImageOps } from "./unity-port.ts";
+
+/** A worker's lease: renewed on every tool call, capped so a stuck session cannot hold the queue. */
+export const UNITY_LEASE_MS = 10 * 60_000;
+export const UNITY_LEASE_CAP_MS = 30 * 60_000;
+/** How long a transient lease waits for a slot before answering the queue shape. */
+export const UNITY_QUEUE_WAIT_MS = 15 * 60_000;
+
+export type UnityLeaseKind = "live" | "transient";
+
+export interface UnityLeaseRequest {
+  /** Null for an editor the user opened themselves (the stage's "Open in Unity" with no run). */
+  runId: string | null;
+  project: string;
+  root: string;
+  kind: UnityLeaseKind;
+  facetId?: string;
+  label?: string;
+  waitMs?: number;
+  /** Overrides the setting for this editor (the stage's "Open in Unity" wants a window). */
+  headless?: boolean;
+}
+
+export interface UnityLeaseGranted {
+  handle: string;
+  editorVersion: string | null;
+  /** How many were ahead when the wait began. */
+  queued: number;
+  waitedMs: number;
+  state: UnityEditorState;
+}
+
+export interface UnityLeaseRefused {
+  handle: null;
+  queued: number;
+  aheadMinutes: number;
+  /** `queue`: the wait ran out. `refused`: the project or the editor is not usable, `error` says why. */
+  reason: "queue" | "refused";
+  error: string;
+}
+
+export type UnityLeaseAnswer = UnityLeaseGranted | UnityLeaseRefused;
+
+export interface UnityPoolEntry {
+  handle: string;
+  runId: string | null;
+  project: string;
+  root: string;
+  kind: UnityLeaseKind;
+  label: string;
+  facetId: string | null;
+  editor: UnityEditor;
+  port: UnityPort;
+  refs: number;
+  leasedAt: number;
+  /** Transient only: when the lease lapses unless renewed. */
+  leaseUntil: number | null;
+  hardCapAt: number | null;
+}
+
+export interface UnityHandleView {
+  handle: string;
+  project: string;
+  runId: string | null;
+  label: string;
+  state: UnityEditorState;
+  editorVersion: string | null;
+  kind: UnityLeaseKind;
+  root: string;
+}
+
+export interface UnityPoolOptions {
+  /** Detection, cached by the core: which editors are installed. */
+  status: () => Promise<UnityStatus>;
+  queueSlots: () => number;
+  headless: () => boolean;
+  /** Where an editor's `-logFile` goes for a run (or for none). */
+  logDir: (runId: string | null) => string;
+  /** The live preview's own image operations, handed through to every port when present. */
+  imageOps?: () => UnityImageOps | null;
+  spawn?: UnitySpawn;
+  settleMs?: number;
+  discoverMs?: number;
+  heartbeatStaleMs?: number;
+  watchMs?: number;
+  pollMs?: number;
+  killGraceMs?: number;
+  leaseMs?: number;
+  leaseCapMs?: number;
+  waitMs?: number;
+  onEvent?: (event: UnityEditorEvent) => void;
+}
+
+interface Waiter {
+  root: string;
+  since: number;
+  wake: (granted: boolean) => void;
+}
+
+/** `m_EditorVersion: 6000.0.50f1` from `ProjectSettings/ProjectVersion.txt`, or null. */
+export async function projectEditorVersion(root: string): Promise<string | null> {
+  const text = await readFile(path.join(root, "ProjectSettings", "ProjectVersion.txt"), "utf8").catch(() => null);
+  if (!text) return null;
+  const m = /m_EditorVersion:\s*(\S+)/.exec(text);
+  return m?.[1] ?? null;
+}
+
+/** The refusal of plan §3.3 step 1, word for word in shape: what the project wants, what is installed, the two remedies. */
+export function editorMismatchSentence(wanted: string, installed: string[]): string {
+  return `this project wants ${wanted}; installed: ${installed.length ? installed.join(", ") : "none"} — open it in Unity Hub once to upgrade, or install ${wanted}`;
+}
+
+export class UnityPool {
+  readonly options: UnityPoolOptions;
+  #entries = new Map<string, UnityPoolEntry>();
+  #byRoot = new Map<string, UnityPoolEntry>();
+  #waiters: Waiter[] = [];
+  /** Slots freed and promised to the waiter at the head of the line, not yet taken. */
+  #reserved = 0;
+  #seq = 0;
+  #sweep: NodeJS.Timeout | null = null;
+  /** Every pid any editor of this pool started. */
+  readonly pids = new Set<number>();
+
+  constructor(options: UnityPoolOptions) {
+    this.options = options;
+  }
+
+  get leaseMs(): number {
+    return this.options.leaseMs ?? UNITY_LEASE_MS;
+  }
+
+  get leaseCapMs(): number {
+    return this.options.leaseCapMs ?? UNITY_LEASE_CAP_MS;
+  }
+
+  #transientInUse(): number {
+    let n = this.#reserved;
+    for (const entry of this.#entries.values()) if (entry.kind === "transient") n++;
+    return n;
+  }
+
+  /** Where a new transient lease would stand: how many hold or wait ahead of it. */
+  queueDepth(): number {
+    return this.#waiters.length;
+  }
+
+  async lease(request: UnityLeaseRequest): Promise<UnityLeaseAnswer> {
+    const root = path.resolve(request.root);
+    const held = this.#byRoot.get(root);
+    if (held) {
+      held.refs++;
+      this.renew(held.handle);
+      return this.#granted(held, 0, 0);
+    }
+    const version = await projectEditorVersion(root);
+    if (!version) return this.#refused(`${root} is not a Unity project — it has no ProjectSettings/ProjectVersion.txt`);
+    const status = await this.options.status();
+    if (!status.editors.length) return this.#refused(status.remedy ? `${status.detail} — ${status.remedy}` : status.detail);
+    const editor = editorForVersion(status.editors, version);
+    if (!editor) return this.#refused(editorMismatchSentence(version, status.editors.map((e) => e.version)));
+
+    // One live editor per run: pointing it at another folder releases the one it had.
+    if (request.kind === "live" && request.runId) {
+      for (const entry of [...this.#entries.values()]) {
+        if (entry.kind === "live" && entry.runId === request.runId && entry.root !== root) await this.#drop(entry, "the run's live editor moved to another folder");
+      }
+    }
+
+    const since = Date.now();
+    let queued = 0;
+    if (request.kind === "transient") {
+      queued = this.#waiters.length + Math.max(0, this.#transientInUse() - this.options.queueSlots() + 1);
+      if (this.#transientInUse() >= this.options.queueSlots() || this.#waiters.length) {
+        const granted = await this.#wait(root, request.waitMs ?? this.options.waitMs ?? UNITY_QUEUE_WAIT_MS);
+        if (!granted) {
+          const ahead = this.#waiters.length + this.#transientInUse();
+          return { handle: null, queued: ahead, aheadMinutes: Math.max(1, Math.round((ahead * this.leaseMs) / 60_000)), reason: "queue", error: `no editor slot came free in ${Math.round((request.waitMs ?? this.options.waitMs ?? UNITY_QUEUE_WAIT_MS) / 60_000)} min — ${ahead} ahead` };
+        }
+        this.#reserved = Math.max(0, this.#reserved - 1);
+      }
+      // A second lease on the same root may have landed while this one waited.
+      const meanwhile = this.#byRoot.get(root);
+      if (meanwhile) {
+        meanwhile.refs++;
+        this.#wakeNext();
+        return this.#granted(meanwhile, queued, Date.now() - since);
+      }
+    }
+    const handle = `${UNITY_HANDLE_PREFIX}${request.runId ?? "user"}:${++this.#seq}`;
+    const label = request.label ?? request.facetId ?? request.project;
+    const headless = request.headless ?? this.options.headless();
+    const logDir = this.options.logDir(request.runId);
+    const unityEditor = new UnityEditor({
+      binary: editor.binary,
+      root,
+      logFile: path.join(logDir, `${label.replace(/[^a-z0-9-_]/gi, "-")}-${this.#seq}.log`),
+      label,
+      headless,
+      editorVersion: editor.version,
+      runId: request.runId,
+      ...(this.options.spawn ? { spawn: this.options.spawn } : {}),
+      ...(this.options.settleMs !== undefined ? { settleMs: this.options.settleMs } : {}),
+      ...(this.options.discoverMs !== undefined ? { discoverMs: this.options.discoverMs } : {}),
+      ...(this.options.heartbeatStaleMs !== undefined ? { heartbeatStaleMs: this.options.heartbeatStaleMs } : {}),
+      ...(this.options.watchMs !== undefined ? { watchMs: this.options.watchMs } : {}),
+      ...(this.options.pollMs !== undefined ? { pollMs: this.options.pollMs } : {}),
+      ...(this.options.killGraceMs !== undefined ? { killGraceMs: this.options.killGraceMs } : {}),
+      onEvent: (event) => this.options.onEvent?.(event),
+    });
+    const now = Date.now();
+    const entry: UnityPoolEntry = {
+      handle,
+      runId: request.runId,
+      project: request.project,
+      root,
+      kind: request.kind,
+      label,
+      facetId: request.facetId ?? null,
+      editor: unityEditor,
+      port: new UnityPort({ handle, project: request.project, root, editor: unityEditor, release: () => this.release(handle).then(() => undefined), imageOps: this.options.imageOps?.() ?? null }),
+      refs: 1,
+      leasedAt: now,
+      leaseUntil: request.kind === "transient" ? now + this.leaseMs : null,
+      hardCapAt: request.kind === "transient" ? now + this.leaseCapMs : null,
+    };
+    // The slot is taken before the first await, so a second caller sees it held.
+    this.#entries.set(handle, entry);
+    this.#byRoot.set(root, entry);
+    this.#startSweep();
+    try {
+      await unityEditor.start();
+    } catch (err) {
+      this.#entries.delete(handle);
+      this.#byRoot.delete(root);
+      await unityEditor.release().catch(() => {});
+      for (const pid of unityEditor.pids) this.pids.add(pid);
+      this.#wakeNext();
+      return this.#refused(String((err as Error)?.message ?? err));
+    }
+    for (const pid of unityEditor.pids) this.pids.add(pid);
+    return this.#granted(entry, queued, Date.now() - since);
+  }
+
+  #granted(entry: UnityPoolEntry, queued: number, waitedMs: number): UnityLeaseGranted {
+    return { handle: entry.handle, editorVersion: entry.editor.editorVersion, queued, waitedMs, state: entry.editor.state };
+  }
+
+  #refused(error: string): UnityLeaseRefused {
+    return { handle: null, queued: 0, aheadMinutes: 0, reason: "refused", error };
+  }
+
+  #wait(root: string, waitMs: number): Promise<boolean> {
+    return new Promise<boolean>((resolve) => {
+      const waiter: Waiter = { root, since: Date.now(), wake: (granted) => resolve(granted) };
+      const timer = setTimeout(() => {
+        const at = this.#waiters.indexOf(waiter);
+        if (at >= 0) this.#waiters.splice(at, 1);
+        resolve(false);
+      }, waitMs);
+      timer.unref?.();
+      waiter.wake = (granted) => {
+        clearTimeout(timer);
+        resolve(granted);
+      };
+      this.#waiters.push(waiter);
+    });
+  }
+
+  /** A slot came free: promise it to the head of the line. */
+  #wakeNext(): void {
+    while (this.#waiters.length && this.#transientInUse() < this.options.queueSlots()) {
+      const next = this.#waiters.shift()!;
+      this.#reserved++;
+      next.wake(true);
+    }
+  }
+
+  /** Push a transient lease's expiry out by one lease, never past its hard cap. */
+  renew(handle: string): boolean {
+    const entry = this.#entries.get(handle);
+    if (!entry) return false;
+    if (entry.leaseUntil !== null) entry.leaseUntil = Math.min(Date.now() + this.leaseMs, entry.hardCapAt ?? Number.POSITIVE_INFINITY);
+    return true;
+  }
+
+  get(handle: string): UnityPoolEntry | null {
+    return this.#entries.get(handle) ?? null;
+  }
+
+  byRoot(root: string): UnityPoolEntry | null {
+    return this.#byRoot.get(path.resolve(root)) ?? null;
+  }
+
+  /** The port for a handle, or a throw naming the handle — the same contract the browser pool has. */
+  port(handle: string): UnityPort {
+    const entry = this.#entries.get(handle);
+    if (!entry) throw new Error(`no Unity editor is leased as ${handle}`);
+    return entry.port;
+  }
+
+  entries(): UnityPoolEntry[] {
+    return [...this.#entries.values()].sort((a, b) => b.leasedAt - a.leasedAt);
+  }
+
+  /** What the stage lists, newest first. */
+  handles(): UnityHandleView[] {
+    return this.entries().map((entry) => ({
+      handle: entry.handle,
+      project: entry.project,
+      runId: entry.runId,
+      label: entry.label,
+      state: entry.editor.state,
+      editorVersion: entry.editor.editorVersion,
+      kind: entry.kind,
+      root: entry.root,
+    }));
+  }
+
+  /** One holder lets go; the last one out releases the editor and wakes the queue. */
+  async release(handle: string): Promise<boolean> {
+    const entry = this.#entries.get(handle);
+    if (!entry) return false;
+    entry.refs--;
+    if (entry.refs > 0) return true;
+    await this.#drop(entry, "released");
+    return true;
+  }
+
+  async #drop(entry: UnityPoolEntry, _reason: string): Promise<void> {
+    if (this.#entries.get(entry.handle) !== entry) return;
+    this.#entries.delete(entry.handle);
+    if (this.#byRoot.get(entry.root) === entry) this.#byRoot.delete(entry.root);
+    entry.refs = 0;
+    try {
+      await entry.editor.release();
+    } finally {
+      this.#wakeNext();
+      this.#stopSweepWhenIdle();
+    }
+  }
+
+  /** Take an editor down whoever holds it — the stage's "Open in Unity" replacing a headless one, the run ending. */
+  async drop(handle: string): Promise<boolean> {
+    const entry = this.#entries.get(handle);
+    if (!entry) return false;
+    await this.#drop(entry, "dropped");
+    return true;
+  }
+
+  async releaseRun(runId: string): Promise<number> {
+    let released = 0;
+    for (const entry of [...this.#entries.values()]) {
+      if (entry.runId !== runId) continue;
+      await this.#drop(entry, "run ended");
+      released++;
+    }
+    return released;
+  }
+
+  async releaseAll(): Promise<void> {
+    for (const entry of [...this.#entries.values()]) await this.#drop(entry, "studio closing");
+    for (const waiter of this.#waiters.splice(0)) waiter.wake(false);
+    if (this.#sweep) clearInterval(this.#sweep);
+    this.#sweep = null;
+  }
+
+  #startSweep(): void {
+    if (this.#sweep) return;
+    const every = Math.max(50, Math.min(5_000, Math.floor(this.leaseMs / 4)));
+    this.#sweep = setInterval(() => void this.#sweepExpired(), every);
+    this.#sweep.unref?.();
+  }
+
+  #stopSweepWhenIdle(): void {
+    if (!this.#sweep) return;
+    for (const entry of this.#entries.values()) if (entry.kind === "transient") return;
+    clearInterval(this.#sweep);
+    this.#sweep = null;
+  }
+
+  async #sweepExpired(): Promise<void> {
+    const now = Date.now();
+    for (const entry of [...this.#entries.values()]) {
+      if (entry.leaseUntil === null || now < entry.leaseUntil) continue;
+      this.options.onEvent?.({ runId: entry.runId, label: entry.label, state: "stopped", ms: now - entry.leasedAt, editorVersion: entry.editor.editorVersion, detail: `lease expired after ${Math.round((now - entry.leasedAt) / 60_000)} min` });
+      await this.#drop(entry, "lease expired");
+    }
+  }
+
+  /** Pids of editors this pool started that are still alive — the `pgrep` a test runs at the end. */
+  alivePids(): number[] {
+    const alive: number[] = [];
+    for (const pid of this.pids) {
+      try {
+        process.kill(pid, 0);
+        alive.push(pid);
+      } catch {
+        /* gone */
+      }
+    }
+    return alive;
+  }
+}
diff --git a/src/main/unity-port.ts b/src/main/unity-port.ts
new file mode 100644
index 0000000..3d7643a
--- /dev/null
+++ b/src/main/unity-port.ts
@@ -0,0 +1,850 @@
+/**
+ * Unity as a second `PreviewPort` (Unity in the studio, plan §2.2 choice 1): one editor
+ * handle, and the surface-neutral half of the port's contract mapped onto Pipeline commands —
+ * load is open-scene in Edit mode, ready is the bridge's `studio_ready`, a screenshot is
+ * `capture_game_view` with the studio's own pixel stats over the PNG, `studioState` and
+ * `studioCall` go to the C# bridge, input goes to the Play-mode runtime server as Unity's own
+ * simulated keys and pointer. The browser-only methods answer "unavailable" as a shape, never
+ * a throw, so the judge instruments and the computer tool work over Unity with no new code.
+ *
+ * Coordinates: the model sees the capture (1280×720 by default, origin top-left, like every
+ * screenshot it is ever shown); Unity's runtime wants the bottom-left origin, and the port is
+ * where that flips. Key names arrive as the computer tool's (`KeyW`, `shift`, `up`) and leave
+ * as the Input System's (`w`, `leftShift`, `upArrow`).
+ */
