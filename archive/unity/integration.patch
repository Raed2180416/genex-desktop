+ */
+export function unityMakeWords(status: UnityStatusLike | null, enabled: boolean, on: boolean): { label: string; title: string; ready: boolean } {
+  const label = UNITY_WORDS.makeIn;
+  if (!enabled) return { label, title: UNITY_WORDS.makeInSwitchedOff, ready: false };
+  const editor = status?.editors[0] ?? null;
+  if (!status || status.code !== "ready" || !editor) return { label, title: `${UNITY_WORDS.makeInNotReady}${status?.detail ? ` (${status.detail}).` : "."}`, ready: false };
+  return { label, title: on ? UNITY_WORDS.makeInOn.replace("{version}", editor.version) : UNITY_WORDS.makeInOffer, ready: true };
