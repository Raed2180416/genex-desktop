+      }
+      const descriptor = await this.#readDescriptor();
+      if (descriptor) {
+        if (descriptor.pid === this.#child?.pid) {
+          this.#descriptor = descriptor;
+          return;
+        }
+        foreign = descriptor.pid;
+      }
+      await sleep(pollMs);
+    }
+    if (foreign !== null) {
+      throw new Error(`the descriptor at ${pipelineDescriptorPath(this.options.root)} belongs to pid ${foreign}, not the editor the studio started (pid ${this.#child?.pid ?? "unknown"}) — is another Unity open on this folder?`);
+    }
+    throw new Error(`the editor wrote no ${PIPELINE_DESCRIPTOR} in ${minutes(this.options.discoverMs ?? this.options.settleMs ?? UNITY_SETTLE_MS)} — is the Pipeline package in this project?`);
+  }
+
+  async #fetch(url: string, init: RequestInit, timeoutMs: number): Promise<Response> {
+    return fetch(url, { ...init, signal: AbortSignal.timeout(Math.max(500, timeoutMs)) });
+  }
+
+  /** `GET /api/status` until the editor stops settling (import, first compile). */
+  async #settle(): Promise<number> {
+    const started = Date.now();
+    const budget = this.options.settleMs ?? UNITY_SETTLE_MS;
+    const deadline = started + budget;
+    const pollMs = Math.max(100, (this.options.pollMs ?? 250) * 4);
+    while (Date.now() < deadline) {
+      if (this.#exited) throw new Error(`the editor exited (${this.#exited.code ?? this.#exited.signal ?? "no code"}) while settling`);
+      const status = await this.status();
+      // Measured 2026-09-11: `status` is "settling" during import and compile, then "ready"; the
+      // exact value set is unmeasured, so anything but "settling" counts as settled.
+      if (status && status.status !== "settling") return Date.now() - started;
+      await sleep(pollMs);
+    }
+    throw new Error(`the editor did not settle in ${minutes(budget)}`);
+  }
+
+  /** The bearer every endpoint wants (measured: status, commands, dialog and progress all 401 without it). */
+  #authHeaders(): Record<string, string> {
+    const token = this.#descriptor?.evalToken ?? "";
+    return token ? { authorization: `Bearer ${token}` } : {};
+  }
+
+  /** The editor's `/api/status`, or null while it is not answering. */
+  async status(): Promise<Record<string, unknown> | null> {
+    const port = this.#descriptor?.port;
+    if (!port) return null;
+    try {
+      // Measured 2026-09-11 on Pipeline 0.6.0-exp.1: every endpoint, status included, answers 401 without the bearer.
+      const response = await this.#fetch(`http://127.0.0.1:${port}/api/status`, { method: "GET", headers: this.#authHeaders() }, 5_000);
+      const body = parseJson(await response.text());
+      if (response.status === 503) return { ...(body ?? {}), status: "settling", busyReason: body?.busyReason ?? "settling" };
+      return body;
+    } catch {
+      return null;
+    }
+  }
+
+  /** The command catalogue (`GET /api/commands`), for `unity_command command=list`. */
+  async commands(): Promise<Array<{ name: string; description: string }>> {
+    const port = this.#descriptor?.port;
+    if (!port) return [];
+    try {
+      const response = await this.#fetch(`http://127.0.0.1:${port}/api/commands`, { method: "GET", headers: this.#authHeaders() }, 10_000);
+      const body = parseJson(await response.text());
+      const list = Array.isArray(body?.commands) ? body.commands : Array.isArray(body) ? body : [];
+      return list
+        .map((item: unknown) => {
+          const row = item && typeof item === "object" ? (item as Record<string, unknown>) : { name: item };
+          return { name: String(row.name ?? ""), description: sanitizeUnityText(String(row.description ?? row.summary ?? "")) };
+        })
+        .filter((row: { name: string }) => row.name);
+    } catch {
+      return [];
+    }
+  }
+
+  /** A modal the editor is showing (windowed mode only), or null. */
+  async dialog(): Promise<{ title: string; message: string | null } | null> {
+    const port = this.#descriptor?.port;
+    if (!port) return null;
+    try {
+      const response = await this.#fetch(`http://127.0.0.1:${port}/api/dialog`, { method: "GET", headers: this.#authHeaders() }, 5_000);
+      const body = parseJson(await response.text());
+      const dialog = body?.dialog && typeof body.dialog === "object" ? (body.dialog as Record<string, unknown>) : body?.title ? body : null;
+      if (!dialog || !dialog.title) return null;
+      return { title: String(dialog.title), message: dialog.message ? String(dialog.message) : null };
+    } catch {
+      return null;
+    }
+  }
+
+  async #runtimeTarget(): Promise<{ port: number; token: string } | null> {
+    if (!this.#runtime) {
+      const text = (await readFile(pipelineRuntimeDescriptorPath(this.options.root), "utf8").catch(() => null)) ?? (await readFile(pipelineRuntimeDescriptorLegacyPath(this.options.root), "utf8").catch(() => null));
+      const parsed = text ? parseJson(text) : null;
+      if (!parsed || typeof parsed.port !== "number") return null;
+      this.#runtime = parsed as unknown as UnityRuntimeDescriptor;
+    }
+    return { port: this.#runtime.port, token: this.#runtime.evalToken ?? this.#descriptor?.evalToken ?? "" };
+  }
+
+  /**
+   * `POST /api/exec`. A 503 (settling, compiling, a dialog) is retried with backoff until the
+   * call's own deadline; a 401 re-reads the descriptor once (the token rotates on restart); a
+   * refused connection during a domain reload is retried the same way. Never throws for a
+   * Unity problem — the answer says what happened, scrubbed of the outage vocabulary.
+   */
+  async exec(command: string, parameters: Record<string, unknown> = {}, opts: UnityExecOptions = {}): Promise<UnityExecResult> {
+    const started = Date.now();
+    const timeoutMs = opts.timeoutMs ?? 60_000;
+    const deadline = started + timeoutMs;
+    const runtime = opts.server === "runtime";
+    let reread = false;
+    let backoff = 250;
+    for (;;) {
+      const ms = () => Date.now() - started;
+      if (this.#released) return { ok: false, error: "the editor has been released", ms: ms() };
+      const target = runtime ? await this.#runtimeTarget() : this.#descriptor ? { port: this.#descriptor.port, token: this.#descriptor.evalToken } : null;
+      if (!target) {
+        return { ok: false, error: runtime ? "the game is not in Play mode (no runtime server) — play first" : "the editor is not running", ms: ms() };
+      }
+      let response: Response;
+      try {
+        response = await this.#fetch(
+          `http://127.0.0.1:${target.port}/api/exec`,
+          { method: "POST", headers: { "content-type": "application/json", authorization: `Bearer ${target.token}` }, body: JSON.stringify({ command, parameters }) },
+          Math.min(timeoutMs, Math.max(1_000, deadline - Date.now())),
+        );
+      } catch (err) {
+        if (runtime) this.#runtime = null;
+        if (this.#exited) return { ok: false, error: `the editor is not running (exited ${this.#exited.code ?? this.#exited.signal ?? ""})`.trim(), ms: ms() };
