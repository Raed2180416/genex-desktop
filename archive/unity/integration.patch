diff --git a/src/harness-seed/loop/unity.mjs b/src/harness-seed/loop/unity.mjs
new file mode 100644
index 0000000..daf9f75
--- /dev/null
+++ b/src/harness-seed/loop/unity.mjs
@@ -0,0 +1,618 @@
+/**
+ * Unity in the night (Unity in the studio, 2026-09-11; plan §5, §6, contract §3.7).
+ *
+ * A Unity project is a second surface for the same night, not a second harness: the judge, the
+ * verdict record, the facet loop and the director's tools all consume one evidence envelope, and
+ * what changes is where the pictures come from — a Unity editor the studio holds open on the
+ * worktree, reached only through the studio's own `unity_*` tools and the `unity.*` RPCs.
+ *
+ * This module is everything the seed knows about that surface in one place, so the loop files
+ * branch on `isUnity(run)` and nothing else: the run facts stamped at start, the grant a
+ * delegation carries, the brief block every builder reads, the planner's one line, the checks
+ * the harness puts on a Unity board, the verdict rules a Unity pass can end on, and the small
+ * stages `gatherEvidence` composes (lease, compile, play, prove, stop, tests, the validation
+ * event). Nothing here talks to a browser.
+ *
+ * The seed is plain JavaScript and cannot import `src/substrate/unity-types.ts`; the tool
+ * names and roles below are copied from it and a conformance test holds the two together.
+ */
+import { CLAUDE_CODE_ENGINE, CODEX_ENGINE, roleEngine, toolCall } from "./model-roles.mjs";
+
+/** The two surfaces a night runs on. */
+export const UNITY_SURFACE = "unity";
+export const THREE_SURFACE = "three";
+
+/** Handles that route to a Unity editor carry this prefix (`UNITY_HANDLE_PREFIX` in unity-types.ts). */
+export const UNITY_HANDLE_PREFIX = "unity:";
+
+/**
+ * The studio's Unity tools, in the order they are granted — copied from
+ * `src/substrate/unity-types.ts` `UNITY_TOOL_NAMES` (the seed cannot import a TS type). Add at
+ * the end; the engine tests assert the order.
+ */
+export const UNITY_TOOL_NAMES = [
+  "unity_play",
+  "unity_pause",
+  "unity_stop",
+  "unity_capture",
+  "unity_state",
+  "unity_input",
+  "unity_console",
+  "unity_recompile",
+  "unity_test",
+  "unity_command",
+  "unity_session",
+];
+
+/** Which roles get which tools — copied from `UNITY_TOOLS_BY_ROLE` in unity-types.ts. */
+export const UNITY_TOOLS_BY_ROLE = {
+  builder: UNITY_TOOL_NAMES,
+  director: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console", "unity_recompile", "unity_test", "unity_command"],
+  playtester: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console"],
+  scout: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console"],
+};
+
+/**
+ * One line per tool, in the studio's voice, for the brief block. The parameters are the ones
+ * `_unityToolsFor` declares (plan §3.4): flat strings, because the Codex bridge passes strings.
+ */
+export const UNITY_TOOLS = [
+  { name: "unity_recompile", says: "compile the scripts; the errors come back verbatim (Assets/X.cs(12,5): error CS1002 …). After every edit to a .cs file, before anything else." },
+  { name: "unity_play", says: "enter Play mode (scene= names one); answers with the frame it reached." },
+  { name: "unity_pause", says: "pause or resume Play mode; answers with the frame." },
+  { name: "unity_stop", says: "back to Edit mode, scene unchanged." },
+  { name: "unity_capture", says: "a still of the Game view (camera= a registered name or eye:here; view=scene for the Scene view). The editor has no window, so the still is the camera's render: a HUD on a Screen Space – Camera canvas is in it, OnGUI and Screen Space – Overlay are not. The picture, plus its pixel stats." },
+  { name: "unity_state", says: "the registered probes as JSON — frame, time, __render.drawCalls and whatever StudioProbes reports." },
+  { name: "unity_input", says: "play it: keys=w,a,s,d action=press|down|up hold_ms=800, or pointer={x,y,button,action} in screenshot pixels. The game's own Input System, never the mouse on this Mac." },
+  { name: "unity_console", says: "errors since load (severity=error by default), minus the ones the build you forked from already had." },
+  { name: "unity_test", says: "the project's tests (mode=editor|playmode|all, filter=…). Minutes, so not after every edit." },
+  { name: "unity_command", says: "any editor command by name — command=list for the catalogue; scene and prefab edits go through it (command=…, args={…} as JSON), never by editing .unity or .prefab files by hand." },
+  { name: "unity_session", says: "action=acquire|release|status — your turn on the editor. One editor validates at a time; a queue wait is minutes, not a failure." },
+];
+
+/** The check kinds a Unity planner may write: `scene` is not among them (no scene census on Unity yet). */
+export const UNITY_CHECK_KINDS = ["pixel", "metric", "probe", "demo", "vision", "play"];
+
+/** The wait a skippable pass (a judge, a playtest, a validate) gives the queue before it says "no editor free". */
+export const UNITY_SKIPPABLE_WAIT_MS = 90_000;
+
+// ── the run ────────────────────────────────────────────────────────────────────────────────
+
+/** True when this night runs on a Unity editor: `run.unity` was stamped at start. */
+export function isUnity(run) {
+  return Boolean(run?.unity && typeof run.unity === "object");
+}
+
+/** "unity" or "three" — the surface every evidence pass of this run photographs. */
+export function surfaceOf(run) {
+  return isUnity(run) ? UNITY_SURFACE : THREE_SURFACE;
+}
+
+/** True for a handle that routes to a Unity editor rather than a browser window. */
+export function isUnityHandle(handle) {
+  return typeof handle === "string" && handle.startsWith(UNITY_HANDLE_PREFIX);
+}
+
+/** `6000.0.50f1` → [6000, 0, 50]; null for anything that is not a version. */
+export function parseUnityVersion(text) {
+  const m = /(\d+)\.(\d+)(?:\.(\d+))?/.exec(String(text ?? ""));
+  return m ? [Number(m[1]), Number(m[2]), Number(m[3] ?? 0)] : null;
+}
+
+/** Whether a Unity version is at or above another (the pin is `6000.0`). */
+export function unityVersionAtLeast(version, minimum) {
+  const a = parseUnityVersion(version);
+  const b = parseUnityVersion(minimum);
+  if (!a || !b) return false;
+  for (let i = 0; i < 3; i++) {
+    if (a[i] > b[i]) return true;
+    if (a[i] < b[i]) return false;
+  }
+  return true;
+}
+
+/**
+ * The run facts a Unity night records once (`run.unity`, `run_started.unity`): the editor the
+ * project will open in, the CLI, and how many transient editors may validate at once. Null —
+ * a Three night, as before — unless the folder is a Unity project AND Unity is set up and on.
+ *
+ * `status` is what `unity.status` answers (`UnityStatus & { queueSlots, headless }`); `shape` is
+ * the project's shape as `game.list` describes it (`kind`, `unity.editorVersion`, `unity.tests`).
+ */
+export function unityRunFacts(status, shape) {
+  if (shape?.kind !== "unity-project") return null;
+  if (!status || typeof status !== "object" || status.enabled !== true || status.code !== "ready") return null;
+  const editors = Array.isArray(status.editors) ? status.editors.filter((e) => e && typeof e.version === "string") : [];
+  const wanted = String(shape?.unity?.editorVersion ?? "");
+  const editor = editors.find((e) => e.version === wanted) ?? editors[0] ?? null;
+  if (!editor) return null;
+  const slots = Number(status.queueSlots);
+  return {
+    editorVersion: editor.version,
+    cli: String(status.cli?.version ?? ""),
+    queueSlots: Number.isFinite(slots) && slots > 0 ? Math.round(slots) : 1,
+    // Whether the project carries a test assembly: `unity-tests-pass` rides only then, and the
+    // integrate and close passes run the tests only then. Read off the shape (lane B's facts);
+    // absent means no tests, never "run them and see".
+    tests: shape?.unity?.tests === true,
+  };
+}
+
+/**
+ * The grant a delegation on a Unity run carries — the serializable half `_unityToolsFor` mints
+ * tools from.
+ *
+ * @param {any} run
+ * @param {{ root?: string | null, facetId?: string | null, iteration?: number, role?: string, label?: string | null }} [options]
+ */
+export function unityGrantFor(run, { root, facetId = null, iteration = 0, role = "builder", label = null } = {}) {
+  if (!isUnity(run) || !root) return null;
+  return {
+    project: run.project,
+    root,
+    runId: run.runId,
+    ...(facetId ? { facetId } : {}),
+    iteration: Number.isFinite(iteration) ? iteration : 0,
+    role: UNITY_TOOLS_BY_ROLE[role] ? role : "builder",
+    ...(label ? { label } : {}),
+  };
+}
+
+// ── briefs ─────────────────────────────────────────────────────────────────────────────────
+
+/** Which of the run's engines a Unity role's session speaks to. */
+function engineForRole(run, role) {
+  if (role === "builder") return roleEngine(run, "builder");
+  if (role === "playtester") return roleEngine(run, "judge");
+  return roleEngine(run, "planner");
+}
+
+/**
+ * The block every Unity session reads: what it has instead of a browser, one line per tool in
+ * this engine's own spelling, and the four rules a Unity build lives by. Empty on a Three run,
+ * so a night without Unity carries no Unity word anywhere.
+ *
+ * `engine` overrides the role's default engine (the playtester decides its engine at run time).
+ *
+ * @param {any} run
+ * @param {{ role?: string, engine?: string | null }} [options]
+ */
+export function unityBriefBlock(run, { role = "builder", engine = null } = {}) {
+  if (!isUnity(run)) return "";
+  const on = engine ?? engineForRole(run, role);
+  const names = new Set(UNITY_TOOLS_BY_ROLE[role] ?? UNITY_TOOL_NAMES);
+  const lines = UNITY_TOOLS.filter((tool) => names.has(tool.name)).map((tool) => `- ${toolCall(on, tool.name)} — ${tool.says}`);
+  const head =
+    role === "builder"
+      ? `YOU HAVE UNITY — COMPILE, PLAY AND SEE IT: this is a Unity ${run.unity.editorVersion} project and the studio opens an editor on this folder for you. Nothing you write is real until it compiles and plays there — there is no browser, no page and no window.__studio here; the Unity tools are your hands and eyes:`
+      : role === "director"
+        ? `YOU HAVE UNITY — COMPILE, PLAY AND SEE IT: this is a Unity ${run.unity.editorVersion} project. The studio holds ONE live editor open on your integration worktree (the user's stage shows it); every worker gets a transient editor of its own, ${run.unity.queueSlots === 1 ? "one at a time" : `${run.unity.queueSlots} at a time`}, and waits its turn. Your tools on the live editor:`
+        : `YOU HAVE UNITY: this is a Unity ${run.unity.editorVersion} project and the studio holds an editor open on it. There is no browser window — these tools are your hands and eyes:`;
+  const rules =
+    role === "builder" || role === "director"
+      ? [
+          `Compile first, then play, then look; leave the editor in Edit mode when you finish. Wire what you add by StudioSpawn (Assets/Studio/StudioSpawn.cs), never by editing Main.unity; keep the StudioProbes registrations, and tag what you add with a StudioTag component so the checks can find it. Never hand-edit a .unity, .prefab or .asset file — a fileID or GUID typed by hand breaks the project; the editor writes them through ${toolCall(on, "unity_command")}.`,
+          ...(run.blender ? [`A shape modelled with the blender tool lands as a GLB under Assets/<Area>/Models/ and the editor imports it on the next compile.`] : []),
+        ]
+      : [`Play it the way a player would; a screenshot before and after every move is the evidence you answer from.`];
+  return [head, ...lines, ...rules].join("\n");
+}
+
+// ── the front door: a new game in Unity ──────────────────────────────────────────────────────
+
+/**
+ * Whether the studio can make a Unity game right now: `unity.status` says ready (on, CLI, a
+ * Unity 6 editor, no licence positively inactive) and names an editor to stamp the project with.
+ */
+export function unityReadyToMake(status) {
+  return Boolean(status && typeof status === "object" && status.enabled === true && status.code === "ready" && Array.isArray(status.editors) && typeof status.editors[0]?.version === "string");
+}
+
+/** The editor version a new Unity game would be stamped with on this Mac, or null when none can be opened. */
+export function unityOnMac(status) {
+  return unityReadyToMake(status) ? status.editors[0].version : null;
+}
+
+/**
+ * What a folder that is not a Unity project may be told about Unity: `false` when the user
+ * switched Unity off (then not a word — the setting is theirs), else the editor waiting on this
+ * Mac or null when none is set up.
+ */
+export function unityAvailability(status) {
+  if (status && typeof status === "object" && status.enabled === false) return false;
+  return unityOnMac(status);
+}
+
+/**
+ * The one Unity sentence a folder that is NOT a Unity project hears — a run's director and
+ * planner, a bound chat's coordinator: a folder never changes engines, and where Unity waits.
+ * Without it the racing night's director read `unity: null` as "the studio didn't detect a
+ * Unity install on this Mac" and pushed back on a user who had Unity ready.
+ *
+ * @param {string} project
+ * @param {string | null | false} version what `unityAvailability` says (false: switched off — not a word)
+ */
+export function otherEngineUnityLine(project, version) {
+  if (version === false) return "";
+  const where = version
+    ? `Unity ${version} is on this Mac: to build in Unity, the user starts a new game (sidebar → Start a game) with the composer's Unity switch on, or says "in Unity" in its first message.`
+    : "Unity is not set up on this Mac (the Unity page, model menu → Unity).";
+  return `UNITY: not here — "${project}" is not a Unity project, and a folder never changes engines (a run on it cannot switch). ${where} If asked whether this builds in Unity, say exactly that — never that Unity was not detected.`;
+}
+
+/** Why a Unity game cannot be made now, in the status's own words. */
+export function unityNotReadyWhy(status) {
+  if (status && typeof status === "object" && status.enabled === false) return "switched off on the Unity page";
+  const detail = String(status?.detail ?? "").trim();
+  return detail || "not set up on this Mac";
+}
+
+/**
+ * Whether an ask wants the game made in Unity. The composer's switch is explicit and wins either
+ * way; without it, the sentence decides — "make me something in Unity" — and naming three.js
+ * keeps three.js.
+ *
+ * @param {string} text
+ * @param {"three" | "unity" | null | undefined} [gameEngine] the composer's switch, when set
+ */
+export function asksForUnity(text, gameEngine = null) {
+  if (gameEngine === "unity") return true;
+  if (gameEngine === "three") return false;
+  const ask = String(text ?? "");
+  return /\bunity\b/i.test(ask) && !/\bthree\.?js\b/i.test(ask);
+}
+
+/**
+ * The coordinator's line about Unity on a chat that has no folder yet — what it may make, how,
+ * and what the composer's switch asked for. Read by the local tool loop's system prompt; the
+ * delegated path decides the folder itself (turn-loop.mjs) and needs no line.
+ *
+ * @param {any} status what `unity.status` answers
+ * @param {"three" | "unity" | null | undefined} [gameEngine]
+ */
+export function coordinatorUnityLine(status, gameEngine = null) {
+  const ready = unityReadyToMake(status);
+  const version = ready ? status.editors[0].version : null;
+  const how = 'new_game with engine "unity" — or, with hours set, start_autopilot with engine "unity"';
+  const page = "the Unity page (model menu → Unity)";
+  if (gameEngine === "unity") {
+    return ready
+      ? `UNITY: the user asked for this game in Unity (the composer's switch or their own words). Make it in Unity ${version}: ${how}. Never a three.js game here.`
+      : `UNITY: the user asked for this game in Unity (the composer's switch or their own words), but Unity is ${unityNotReadyWhy(status)}. Say so in one sentence and make nothing until it is set up on ${page}; do not fall back to three.js.`;
+  }
+  return ready
+    ? `UNITY: available (${version}). When the user asks for a Unity game, make it in Unity: ${how}. Otherwise games are three.js.`
+    : `UNITY: ${unityNotReadyWhy(status)}. Games are three.js; if the user asks for Unity, say it is not set up on this Mac (${page}) and offer three.js.`;
+}
+
+/**
+ * The planner's one line about Unity, on a Unity project only: available, with the version and
+ * the queue's shape; or not set up. A folder that is not a Unity project says nothing.
+ *
+ * @param {any} run
+ * @param {{ kind?: string } | null} [shape]
+ */
+export function plannerUnityLine(run, shape = null) {
+  if (shape?.kind !== "unity-project" && !isUnity(run)) return "";
+  if (!isUnity(run)) return "UNITY: not set up on this Mac (the CLI, a Unity 6 editor and a sign-in are on the Unity page). Builders can edit C# but nothing can compile, play or be photographed until it is.";
+  return `UNITY: available (${run.unity.editorVersion}). Builders compile, play and photograph in the Unity editor; ${run.unity.queueSlots === 1 ? "one editor validates at a time" : `${run.unity.queueSlots} editors validate at a time`}, so plan seams that compile independently and keep each worker's first compile small. Checks are pixel, metric, probe, demo, vision and play — there is no scene census on Unity yet, so a scene check is unmeasured here.`;
+}
+
+/** The sentence the brief writers put where the browser tools used to be, for the engine test. */
+export function unityToolSpelling(run, name, role = "builder") {
+  return toolCall(engineForRole(run, role), name);
+}
+
+// ── checks ─────────────────────────────────────────────────────────────────────────────────
+
+/**
+ * The checks the harness itself puts on every Unity board (plan §5.3), `origin: "harness"` so
+ * a planner re-ask cannot drop them and a builder cannot edit them. They are probes over the
+ * pass's own Unity facts (`evidence.unity.*`, `consoleErrors`) rather than over the game's
+ * state, which is why `needs` names those roots: checks.mjs answers them from the envelope, and
+ * a pass that never reached the game's state (it did not compile) still fails `unity-compiles`.
+ */
+export const UNITY_CHECKS = {
+  "unity-compiles": {
+    kind: "probe",
+    weight: "identity",
+    origin: "harness",
+    expr: "unity.compile.ok == true",
+    needs: ["unity.compile.ok"],
+    note: "harness-owned: the scripts compile — a build that does not compile fails here and is looked at no further",
+  },
+  "unity-plays": {
+    kind: "probe",
+    weight: "identity",
+    origin: "harness",
+    expr: "unity.play.frames >= 2 && unity.play.exceptions == 0",
+    needs: ["unity.play.frames", "unity.play.exceptions"],
+    note: "harness-owned: Play mode ran at least two frames and threw nothing on start",
+  },
+  "unity-no-new-errors": {
+    kind: "probe",
+    weight: "normal",
+    origin: "harness",
+    expr: "len(consoleErrors) == 0",
+    needs: ["consoleErrors"],
+    note: "harness-owned: no console error this build introduced (errors the build it forked from already logged are forgiven)",
+  },
+  "unity-tests-pass": {
+    kind: "probe",
+    weight: "normal",
+    origin: "harness",
+    optional: true,
+    expr: "unity.tests.failed == 0",
+    needs: ["unity.tests.failed"],
+    note: "harness-owned: the project's own tests pass when a pass runs them (they run at integrate and at the close; unmeasured when nobody ran them)",
+  },
+};
+
+/** The ids a Unity board carries, given the project's facts (`unity-tests-pass` only with a test assembly). */
+export function unityCheckIds(unity) {
+  return ["unity-compiles", "unity-plays", "unity-no-new-errors", ...(unity?.tests === true ? ["unity-tests-pass"] : [])];
+}
+
+/** The test mode an evidence pass should run for this board: "editor" when a check names the tests, else nothing. */
+export function unityTestsFor(spec) {
+  return (spec?.checks ?? []).some((c) => c?.id === "unity-tests-pass") ? "editor" : null;
+}
+
+// ── verdicts ───────────────────────────────────────────────────────────────────────────────
+
+/**
+ * The three rule tokens a Unity pass adds to the verdict record (plan §5.4): two decisions and
+ * one look. `kept` is what the token decides; the sentences are the ones verdict.mjs composes,
+ * kept here so a reader of this module sees the whole rule.
+ */
+export const UNITY_RULES = {
+  "does-not-compile": { kept: false, because: "Undone: the scripts did not compile after this build." },
+  "tests-fail": { kept: false, because: "Undone: the project's own tests failed after this build." },
+  compiles: { kept: null, because: "It compiles and plays." },
+};
+
+/** The rule a broken Unity pass ends on: what the compile or the tests said, else the plain "broken". */
+export function unityBrokenRule(evidence) {
+  if (evidence?.unity?.compile?.ok === false) return "does-not-compile";
+  if (evidence?.unity?.tests?.ran === true && (evidence.unity.tests.failed ?? 0) > 0) return "tests-fail";
+  return null;
+}
+
+/** The lines a broken Unity build's next brief carries, ahead of the browser's own. */
+export function unityBrokenDetail(evidence) {
+  const out = [];
+  const compile = evidence?.unity?.compile;
+  if (compile && compile.ok === false) out.push(`compile errors: ${(compile.errors ?? []).slice(0, 12).join("\n") || "the editor reported a failed compile without a line"}`);
+  const play = evidence?.unity?.play;
+  if (play && play.ok === false) out.push(`play: ${play.error ?? "Play mode did not start"}`);
+  const tests = evidence?.unity?.tests;
+  if (tests?.ran && (tests.failed ?? 0) > 0) out.push(`tests: ${tests.failed} failed — ${(tests.failures ?? []).slice(0, 6).join(" | ")}`);
+  return out;
+}
+
+// ── the stages gatherEvidence composes ─────────────────────────────────────────────────────
+
+/**
+ * The problems that are the editor's, not the build's: a queue that ran out, a crashed editor, a
+ * dialog in the way. gauntlet.mjs counts them as observation-only — hold the challenger
+ * unjudged, never execute it — the same rule a blind browser window gets.
+ */
+export const UNITY_OBSERVATION_PROBLEMS = [/^unity editor queue:/, /^the unity editor crashed/i, /^the unity editor is blocked by a dialog/i];
+
+/** The sentence for a lease that came back without a handle, worded by what the studio said. */
+export function unityLeaseProblem(answer) {
+  const error = String(answer?.error ?? "");
+  if (answer?.busyReason === "blocked_by_dialog" || /dialog/i.test(error)) return `the Unity editor is blocked by a dialog: ${error || "the editor is waiting on a dialog nobody can answer"}`;
+  if (/crash/i.test(error)) return `the Unity editor crashed: ${error}`;
+  if (answer?.reason === "refused") return `unity editor queue: ${error || "the studio refused the lease"}`;
+  if (answer?.reason === "queue" || (answer && "queued" in answer)) {
+    const waited = Math.round((Number(answer?.waitedMs) || 0) / 60_000);
+    const ahead = Number(answer?.queued) || 0;
+    const minutes = Number.isFinite(Number(answer?.aheadMinutes)) ? Number(answer.aheadMinutes) : null;
+    return `unity editor queue: no editor free after ${waited} min (${ahead} ahead${minutes !== null ? `, about ${minutes} min` : ""})`;
+  }
+  return `unity editor queue: ${error || "no editor could be leased"}`;
+}
+
+/** One RPC answer, classified: the editor's fault (an observation problem) or the build's. */
+export function unityAnswerProblem(answer, fallback) {
+  const error = String(answer?.error ?? "");
+  if (answer?.busyReason === "blocked_by_dialog" || /dialog/i.test(error)) return `the Unity editor is blocked by a dialog: ${error || fallback}`;
+  // spike S2: what a crashed editor answers on the RPC (an error line, a closed socket) is
+  // unmeasured; the fake says "editor crashed" and the port's `status.crashed` says the rest.
+  if (/crash/i.test(error)) return `the Unity editor crashed: ${error}`;
+  return `${fallback}${error ? `: ${error}` : ""}`;
+}
+
+/**
+ * The editor a pass looks through. A `unity:` handle the caller holds is reused as it is (a
+ * worker's own lease, the run's live editor); anything else leases one for the pass —
+ * `transient` by default, a queue slot the pass gives back — and `leased: true` says so.
+ *
+ * @param {any} ctx
+ * @param {{ run: any, root?: string | null, handle?: string | null, kind?: string, facetId?: string | null, label?: string | null, waitMs?: number | null }} options
+ */
+export async function unityLease(ctx, { run, root, handle = null, kind = "transient", facetId = null, label = null, waitMs = null }) {
+  if (isUnityHandle(handle)) return { handle, leased: false, queueWaitMs: 0, queued: 0, editorVersion: run?.unity?.editorVersion ?? null, state: null, problem: null };
+  if (!root) return { handle: null, leased: false, queueWaitMs: 0, queued: 0, editorVersion: null, state: null, problem: "unity editor queue: no folder to open an editor on" };
+  const answer = await ctx
+    .call("unity.lease", {
+      runId: run.runId,
+      project: run.project,
+      root,
+      kind: kind === "live" ? "live" : "transient",
+      ...(facetId ? { facetId } : {}),
+      ...(label ? { label } : {}),
+      ...(Number.isFinite(waitMs) && waitMs > 0 ? { waitMs } : {}),
+    })
+    .catch((err) => ({ handle: null, error: String(err?.message ?? err) }));
+  if (!answer || !isUnityHandle(answer.handle)) {
+    return { handle: null, leased: false, queueWaitMs: Number(answer?.waitedMs) || 0, queued: Number(answer?.queued) || 0, editorVersion: null, state: null, problem: unityLeaseProblem(answer) };
+  }
+  return { handle: answer.handle, leased: true, queueWaitMs: Number(answer.waitedMs) || 0, queued: Number(answer.queued) || 0, editorVersion: answer.editorVersion ?? null, state: answer.state ?? null, problem: null };
+}
+
+/** Give a lease back — only one this pass took; a caller's own handle is the caller's to release. */
+export async function unityRelease(ctx, lease) {
+  if (!lease?.leased || !lease.handle) return;
+  await ctx.call("unity.release", { handle: lease.handle }).catch(() => {});
+}
+
+/** `unity.compile` normalised to the `UnityEvidence.compile` shape. */
+export async function unityCompileStage(ctx, handle) {
+  const answer = await ctx.call("unity.compile", { handle }).catch((err) => ({ ok: false, errors: [], error: String(err?.message ?? err) }));
+  const errors = Array.isArray(answer?.errors) ? answer.errors.map(String).filter(Boolean) : [];
+  return {
+    ok: answer?.ok === true,
+    errors,
+    ms: Number(answer?.ms) || 0,
+    ...(answer?.ok !== true && !errors.length && answer?.error ? { error: String(answer.error) } : {}),
+    ...(answer?.busyReason ? { busyReason: String(answer.busyReason) } : {}),
+  };
+}
+
+/** `unity.play` normalised to the `UnityEvidence.play` shape. */
+export async function unityPlayStage(ctx, handle, scene = null) {
+  const answer = await ctx.call("unity.play", { handle, ...(scene ? { scene } : {}) }).catch((err) => ({ ok: false, error: String(err?.message ?? err) }));
+  return {
+    ok: answer?.ok === true,
+    frames: Number(answer?.frames) || 0,
+    exceptions: Number(answer?.exceptions) || 0,
+    ms: Number(answer?.ms) || 0,
+    ...(answer?.ok !== true ? { error: String(answer?.error ?? "Play mode did not start") } : {}),
+    ...(answer?.busyReason ? { busyReason: String(answer.busyReason) } : {}),
+  };
+}
+
+/** `unity.stop`: back in Edit mode; a scene the pass left dirty is a warning the caller words. */
+export async function unityStopStage(ctx, handle) {
+  const answer = await ctx.call("unity.stop", { handle }).catch((err) => ({ ok: false, playing: null, dirty: null, error: String(err?.message ?? err) }));
+  return { ok: answer?.ok === true, playing: answer?.playing === true, dirty: answer?.dirty === true, ...(answer?.error ? { error: String(answer.error) } : {}) };
+}
+
+/** `unity.tests` normalised to the `UnityEvidence.tests` shape; `ran: false` when nothing was asked. */
+export async function unityTestsStage(ctx, handle, mode = "editor", filter = null) {
+  const wanted = ["editor", "playmode", "all"].includes(mode) ? mode : "editor";
+  const answer = await ctx.call("unity.tests", { handle, mode: wanted, ...(filter ? { filter } : {}) }).catch((err) => ({ ran: false, error: String(err?.message ?? err) }));
+  return {
+    ran: answer?.ran === true,
+    passed: Number(answer?.passed) || 0,
+    failed: Number(answer?.failed) || 0,
+    failures: Array.isArray(answer?.failures) ? answer.failures.map(String).slice(0, 24) : [],
+    ms: Number(answer?.ms) || 0,
+    ...(answer?.error ? { error: String(answer.error) } : {}),
+  };
+}
+
+/**
+ * Prove the studio drives Play mode before anything it drives is believed — the Unity twin of
+ * gauntlet's `proveStep`. The witness is `studio_state` (through `preview.state`): the frame
+ * counter must advance on each of two steps, something must have been drawn, and the game's own
+ * time must move. The codes are the browser's, so the callers read one vocabulary.
+ *
+ * The step's argument is milliseconds, as everywhere else the seed calls `step`; the port turns
+ * it into frames for `studio_step`.
+ */
+export async function proveUnityStep(ctx, h = {}, ms = 1_000) {
+  const read = async () => {
+    const state = await ctx.call("preview.state", { ...h }).catch(() => null);
+    if (!state || typeof state !== "object" || state.__missing || state.unavailable) return null;
+    const frame = Number(state.frame);
+    if (!Number.isFinite(frame)) return null;
+    // Measured 2026-09-11: the bridge reports `time` and `__render.drawCalls` (the port overlays UnityStats when the runtime counter reads 0); which one a brought project's bridge reports is
+    // the bridge's contract (lane B); the fake answers all three.
+    return {
+      frame,
+      time: Number(state.time ?? state.simulatedMs ?? 0) || 0,
+      drawCalls: Number(state.__render?.drawCalls) || 0,
+    };
+  };
+  const samples = [await read()];
+  for (let i = 0; i < 2; i++) {
+    await ctx.call("preview.call", { method: "step", arg: ms, ...h }).catch(() => null);
+    samples.push(await read());
+  }
+  const out = { ok: false, code: "no-clock", reason: "", frames: 0, drawCalls: 0, drawn: "counters", lit: null, ms: 0, idle: 0, idleLoop: false, note: "" };
+  if (samples.some((sample) => sample === null)) {
+    out.reason = "the studio bridge is not in this project (studio_state answers nothing) — add com.aigamestudio.bridge and a StudioProbes component to the scene";
+    return out;
+  }
+  const first = samples[0];
+  const last = samples[samples.length - 1];
+  out.frames = last.frame - first.frame;
+  out.drawCalls = last.drawCalls;
+  out.ms = last.time - first.time;
+  if (!samples.every((sample, index) => index === 0 || sample.frame > samples[index - 1].frame)) {
+    out.code = "no-frame";
+    out.reason = "the studio stepped the editor and the frame counter did not move — the bridge is not stepping Play mode";
+    return out;
+  }
+  if (!(out.drawCalls > 0)) {
+    // Measured 2026-09-11 on a hidden (-batchmode) editor: nothing renders per frame — the
+    // runtime recorder, UnityStats and get_performance_stats all read 0 in Play mode, before and
+    // after a capture — while a camera capture renders on demand and comes back with pixels. So
+    // the proof that something is drawn is the picture itself, judged by its lit fraction.
+    const shot = await ctx.call("preview.screenshot", { ...h, surface: "canvas" }).catch(() => null);
+    const lit = Number(shot?.stats?.litFraction);
+    if (Number.isFinite(lit) && lit > 0.005) {
+      out.drawn = "capture";
+      out.lit = lit;
+    } else {
+      out.code = "no-draw";
+      out.reason = `frames ran but nothing was drawn (__render.drawCalls is 0${Number.isFinite(lit) ? `, and a camera capture is ${(lit * 100).toFixed(1)}% lit` : ""})`;
+      return out;
+    }
+  }
+  if (!(out.ms > 0)) {
+    out.code = "flat-clock";
+    out.reason = "the game's own time did not advance across two steps — the bridge's clock is not the studio's";
+    return out;
+  }
+  out.ok = true;
+  out.code = "ok";
+  return out;
+}
+
+/**
+ * The `unity_validation` run event — one per evidence pass on an editor, in the shape
+ * `UnityValidationEvent` (unity-types.ts). The Builds tab folds these under the unity node.
+ *
+ * @param {{ run: any, facetId?: string | null, mode?: string, worker?: string | null, ok?: boolean, unity?: any, still?: string | null, queueWaitMs?: number, editorVersion?: string | null }} fields
+ */
+export function unityValidationEvent({ run, facetId = null, mode = "iteration", worker = null, ok = false, unity = null, still = null, queueWaitMs = 0, editorVersion = null }) {
+  const modes = ["gate", "health", "iteration", "validate"];
+  return {
+    runId: run.runId,
+    facetId: facetId ?? null,
+    mode: modes.includes(mode) ? mode : "iteration",
+    worker: worker ?? null,
+    ok: ok === true,
+    compileMs: Number(unity?.compile?.ms) || 0,
+    compileErrors: Array.isArray(unity?.compile?.errors) ? unity.compile.errors.length : unity?.compile?.ok === false ? 1 : 0,
+    // The first `error CS…` line, for the chat's one sentence ("does not compile — …"); null
+    // when the compile passed or the editor named no line.
+    firstError: unity?.compile?.ok === false ? (Array.isArray(unity.compile.errors) && unity.compile.errors[0] ? String(unity.compile.errors[0]) : unity.compile.error ? String(unity.compile.error) : null) : null,
+    played: unity?.play?.ok === true,
+    testsPassed: unity?.tests?.ran ? Number(unity.tests.passed) || 0 : null,
+    testsFailed: unity?.tests?.ran ? Number(unity.tests.failed) || 0 : null,
+    still: still ?? null,
+    queueWaitMs: Number(queueWaitMs) || 0,
+    editorVersion: editorVersion ?? run?.unity?.editorVersion ?? null,
+  };
+}
+
+/**
+ * Put the event on the run's thread; never fatal — the pass is the record, the event a courtesy.
+ *
+ * @param {any} ctx
+ * @param {{ threadId?: string | null, run: any, facetId?: string | null, mode?: string, worker?: string | null, ok?: boolean, unity?: any, still?: string | null, queueWaitMs?: number, editorVersion?: string | null }} fields
+ */
+export async function recordUnityValidation(ctx, { threadId = null, ...fields }) {
+  const payload = unityValidationEvent(fields);
+  const thread = threadId ?? ctx?.threadId ?? null;
+  await ctx.call("events.append", { ...(thread ? { threadId: thread } : {}), batch: [{ type: "custom", event_type: "unity_validation", payload }] }).catch(() => {});
+  return payload;
+}
+
+/** The two engine ids, re-exported so a test of this module's rendering needs one import. */
+export { CLAUDE_CODE_ENGINE, CODEX_ENGINE };
