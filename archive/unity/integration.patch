+      const stats = await this.#exec("studio_render_stats", {}, 5_000);
+      const s = record(stats.result);
+      if (stats.ok && s && (num(s.drawCalls) ?? 0) > 0) r.__render = { ...render, drawCalls: num(s.drawCalls), triangles: num(render.triangles) ?? num(s.triangles), source: "UnityStats" };
