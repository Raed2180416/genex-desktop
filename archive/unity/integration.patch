diff --git a/src/unity-bridge/Runtime/StudioInput.cs b/src/unity-bridge/Runtime/StudioInput.cs
new file mode 100644
index 0000000..1dbc41c
--- /dev/null
+++ b/src/unity-bridge/Runtime/StudioInput.cs
@@ -0,0 +1,62 @@
+// Mouse-look for the studio's drivers (measured 2026-09-11 on Pipeline 0.6.0-exp.1): the package's
+// `simulate_pointer` carries a position only and never moves `<Mouse>/delta`, so a look action
+// bound to the mouse delta needs the delta queued on the device itself. The delta is held here
+// and queued by the runner at the start of the next frame the clock actually runs — a delta
+// queued while the clock is frozen would be consumed by one of the editor's own idle frames
+// (a look is not scaled by deltaTime, so the player would turn while "paused", and how many
+// idle frames passed before the step would decide by how much: the first run's non-determinism).
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace AIGameStudio.Bridge
+{
+    public static class StudioInput
+    {
+        static Vector2 pending;
+        static System.Action<Vector2> lookHook;
+
+        /// A game may hand the studio its own look input (the template's PlayerController.Drive):
+        /// the delta then reaches the game exactly once, on the next frame the clock runs, which
+        /// is what makes two seeded passes turn the same way. Without a hook the delta is queued
+        /// on the mouse device, which the Input System applies on its own schedule.
+        public static void RegisterLook(System.Action<Vector2> apply)
+        {
+            lookHook = apply;
+        }
+
+        public static object Look(float dx, float dy)
+        {
+            if (lookHook == null)
+            {
+#if STUDIO_INPUT_SYSTEM
+                if (UnityEngine.InputSystem.Mouse.current == null) return new Dictionary<string, object> { ["ok"] = false, ["reason"] = "no mouse device is present" };
+#else
+                return new Dictionary<string, object> { ["ok"] = false, ["reason"] = "the Input System package is not in this project and no look hook is registered" };
+#endif
+            }
+            pending += new Vector2(dx, dy);
+            return new Dictionary<string, object> { ["ok"] = true, ["dx"] = dx, ["dy"] = dy, ["pending"] = pending.magnitude, ["via"] = lookHook != null ? "hook" : "mouse" };
+        }
+
+        /// Called by the runner's Update on a frame the clock runs: the held delta becomes this
+        /// frame's look, handed to the hook or flushed as this frame's mouse delta.
+        internal static void Flush()
+        {
+            if (pending == Vector2.zero || Time.timeScale <= 0f) return;
+            var delta = pending;
+            pending = Vector2.zero;
+            if (lookHook != null)
+            {
+                try { lookHook(delta); }
+                catch (System.Exception e) { Debug.LogException(e); }
+                return;
+            }
+#if STUDIO_INPUT_SYSTEM
+            var mouse = UnityEngine.InputSystem.Mouse.current;
+            if (mouse == null) return;
+            UnityEngine.InputSystem.InputSystem.QueueDeltaStateEvent(mouse.delta, delta);
+            UnityEngine.InputSystem.InputSystem.Update();
+#endif
+        }
+    }
+}
