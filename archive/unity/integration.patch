+describe("the Unity CLI install", () => {
+  const PLATFORM = unityCliPlatform();
+  const BINARY = Buffer.from("#!/bin/sh\n# a fake Unity CLI binary (the bytes only matter to the checksum)\necho 1.3.0\n");
+  const SHA = createHash("sha256").update(BINARY).digest("hex");
+  const MANIFEST = { version: "1.3.0", binaries: { [PLATFORM]: { filename: `unity-${PLATFORM}`, sha256: SHA, size: BINARY.length }, "linux-x64": { filename: "unity-linux-x64", sha256: "0".repeat(64), size: 1 } } };
+
+  /** A fake CDN: one answer per URL — text, bytes or a status; anything else 404s. */
+  function fakeCdn(routes: Record<string, { status?: number; text?: string; bytes?: Buffer }>) {
+    const calls: string[] = [];
+    const fetch: NonNullable<SetupOptions["fetch"]> = async (url, init) => {
+      calls.push(url);
+      const route = routes[url] ?? { status: 404, text: "not found" };
+      const body = route.bytes ?? Buffer.from(route.text ?? "");
+      const stream = new ReadableStream<Uint8Array>({
+        start(controller) {
+          // Two chunks, so a cancel mid-stream has a chunk to land on.
+          const half = Math.ceil(body.length / 2);
+          controller.enqueue(new Uint8Array(body.subarray(0, half)));
+          if (init.signal.aborted) return controller.error(new Error("aborted"));
+          controller.enqueue(new Uint8Array(body.subarray(half)));
+          controller.close();
+        },
+      });
+      const status = route.status ?? 200;
+      return { ok: status < 400, status, headers: { get: () => null }, body: stream };
+    };
+    return { fetch, calls };
+  }
+  const manifestUrl = unityCliManifestUrl();
+  const binaryUrl = `${UNITY_PIN.cliCdnBase}1.3.0/unity-${PLATFORM}`;
+  const good = () => fakeCdn({ [manifestUrl]: { text: JSON.stringify(MANIFEST) }, [binaryUrl]: { bytes: BINARY } });
+
+  /** The `--version` ask on the installed binary, recorded. */
+  function fakeRun(options: { version?: string | null; seen: Array<{ file: string; args: string[]; env: NodeJS.ProcessEnv }> }): NonNullable<SetupOptions["run"]> {
+    return async (file, args, opts) => {
+      options.seen.push({ file, args, env: opts.env ?? {} });
+      if (options.version === null) return { code: 1 };
+      opts.onLine(options.version ?? "1.3.0");
+      return { code: 0 };
+    };
+  }
+
+  it("reads the channel manifest, downloads this Mac's binary, verifies its sha256, makes it the studio's own copy, and records what it did — no script run, no shell config touched", async () => {
+    const userData = path.join(await tmpDir("studio-unity-cli-"), "userData");
+    const { fetch, calls } = good();
+    const seen: Array<{ file: string; args: string[]; env: NodeJS.ProcessEnv }> = [];
+    const progress: UnitySetupView[] = [];
+    const binary = await installUnityCli(userData, (p) => progress.push(p), new AbortController().signal, { fetch, run: fakeRun({ seen }) });
+    assert.deepEqual(calls, [manifestUrl, binaryUrl], "the manifest, then the binary the manifest names — nothing else from the network");
+    assert.match(manifestUrl, /\/latest-beta\.json$/, "the beta channel's manifest, because the pin says beta");
+    assert.equal(binary, path.join(userData, "tools", "unity"));
+    assert.deepEqual(await readFile(binary), BINARY);
+    assert.ok((await stat(binary)).mode & 0o100, "executable");
+    assert.deepEqual(seen.map((s) => [s.file, s.args]), [[binary, ["--version"]]], "the only process run is the installed binary's own --version");
+    assert.equal(seen[0]!.env.UNITY_NO_UPDATE_CHECK, "1");
+    assert.ok(progress.every((p) => p.step === "cli" && p.phase === "running"), "the step reports running lines; index.ts closes with done");
+    assert.ok(progress.some((p) => /^Downloading Unity CLI 1\.3\.0/.test(p.line)), "the page sees the download");
+    assert.equal(progress.at(-1)!.line, "Unity CLI 1.3.0 installed");
+    assert.equal(progress.at(-1)!.progress, 1);
+    const record = JSON.parse(await readFile(path.join(userData, "tools", "unity-cli.json"), "utf8")) as { version: string; channel: string; manifest: string; url: string; sha256: string; binary: string };
+    assert.deepEqual({ version: record.version, channel: record.channel, manifest: record.manifest, url: record.url, sha256: record.sha256, binary: record.binary }, { version: "1.3.0", channel: "beta", manifest: manifestUrl, url: binaryUrl, sha256: SHA, binary });
+    assert.deepEqual(await readdir(path.join(userData, "tools", "downloads")), [], "no part-file left behind");
+    // The binary the install left behind is the studio's copy that detection finds first.
+    const status = await detectUnity(userData, true, { pathEnv: "", home: path.join(userData, "nohome"), probe: fakeUnityProbe(binary, { version: "1.3.0", ...READY }) });
+    assert.equal(status.cli?.source, "studio");
+  });
+
+  it("a bad answer from the CDN, a manifest that is not one, a manifest without this Mac, a wrong checksum, a binary that does not run, and cancel each stop with a sentence", async () => {
+    const userData = path.join(await tmpDir("studio-unity-cli-"), "userData");
+    const seen: Array<{ file: string; args: string[]; env: NodeJS.ProcessEnv }> = [];
+    const signal = new AbortController().signal;
+    const install = (cdn: ReturnType<typeof fakeCdn>, run = fakeRun({ seen }), s = signal) => installUnityCli(userData, () => {}, s, { fetch: cdn.fetch, run });
+    await assert.rejects(install(fakeCdn({ [manifestUrl]: { status: 503 } })), /Unity's CDN answered 503/);
+    await assert.rejects(install(fakeCdn({ [manifestUrl]: { text: "<html>not found</html>" } })), /not a release manifest/);
+    await assert.rejects(install(fakeCdn({ [manifestUrl]: { text: JSON.stringify({ version: "1.3.0", binaries: { "linux-x64": MANIFEST.binaries["linux-x64"] } }) } })), new RegExp(`no Unity CLI for ${PLATFORM} in the 1\\.3\\.0 manifest`));
+    await assert.rejects(install(fakeCdn({ [manifestUrl]: { text: JSON.stringify(MANIFEST) }, [binaryUrl]: { status: 404 } })), /answered 404/);
+    await assert.rejects(install(fakeCdn({ [manifestUrl]: { text: JSON.stringify(MANIFEST) }, [binaryUrl]: { bytes: Buffer.from("not the bytes the manifest promised") } })), /checksum does not match/);
+    assert.equal(seen.length, 0, "nothing ran before a verified binary existed");
+    await assert.rejects(install(good(), fakeRun({ seen, version: null })), /does not answer `--version`/);
+    const controller = new AbortController();
+    const cancelling = install(good(), async (_file, _args, opts) => {
+      controller.abort();
+      opts.onLine("1.3.0");
+      return { code: 0 };
+    }, controller.signal);
+    await assert.rejects(cancelling, /cancelled/);
+    assert.deepEqual(await readdir(path.join(userData, "tools", "downloads")), [], "no part-file survives any failure");
+  });
+});
