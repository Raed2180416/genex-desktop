+
+async function filesIn(dir: string, rel = ""): Promise<string[]> {
+  const out: string[] = [];
+  for (const entry of await readdir(dir, { withFileTypes: true }).catch(() => [])) {
+    if (entry.name === ".git") continue;
+    const relative = rel ? `${rel}/${entry.name}` : entry.name;
+    if (entry.isDirectory()) out.push(...(await filesIn(path.join(dir, entry.name), relative)));
+    else out.push(relative);
+  }
+  return out.sort();
+}
+
+async function digest(dir: string): Promise<Map<string, string>> {
+  const out = new Map<string, string>();
+  for (const file of await filesIn(dir)) out.set(file, createHash("sha1").update(await readFile(path.join(dir, file))).digest("hex"));
+  return out;
+}
