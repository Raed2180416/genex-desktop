diff --git a/tests/fixtures/unity/grey-box/Assets/Studio/StudioSpawn.cs b/tests/fixtures/unity/grey-box/Assets/Studio/StudioSpawn.cs
new file mode 100644
index 0000000..8cce2b7
--- /dev/null
+++ b/tests/fixtures/unity/grey-box/Assets/Studio/StudioSpawn.cs
@@ -0,0 +1,42 @@
+// The wiring registry — the one file the main owner edits, and the way everyone else adds to
+// the scene. Workers never hand-edit Main.unity: they register a spawner by code from their own
+// file (a [RuntimeInitializeOnLoadMethod] that calls StudioSpawn.Register), and this component
+// instantiates every registered area under itself when the scene starts. The SPAWN WIRING
+// block below is the entry owner's: one line per area wired by name, nothing else.
+using System;
+using System.Collections.Generic;
+using UnityEngine;
+
+public sealed class StudioSpawn : MonoBehaviour
+{
+    static readonly SortedDictionary<string, Action<Transform>> spawners = new SortedDictionary<string, Action<Transform>>(StringComparer.Ordinal);
+
+    /// Register what an area puts into the scene: `StudioSpawn.Register("lighting", root => Instantiate(prefab, root));`
+    public static void Register(string area, Action<Transform> spawn)
+    {
+        if (string.IsNullOrEmpty(area) || spawn == null) return;
+        spawners[area] = spawn;
+    }
+
+    /// The registered areas, in the order they are spawned.
+    public static string[] Areas()
+    {
+        var names = new List<string>(spawners.Keys);
+        return names.ToArray();
+    }
+
+    void Awake()
+    {
+        // SPAWN WIRING — the entry owner's block. One line per area that is wired by name here
+        // rather than from its own file; the harness merges this block, nothing outside it.
+        // END SPAWN WIRING
+
+        foreach (var pair in spawners)
+        {
+            var root = new GameObject(pair.Key).transform;
+            root.SetParent(transform, false);
+            try { pair.Value(root); }
+            catch (Exception e) { Debug.LogException(e); }
+        }
+    }
+}
