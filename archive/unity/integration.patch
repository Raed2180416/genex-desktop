+/** A writable copy of the fixture — the fixture itself is never adopted, adoption writes. */
+async function copyOf(name = "grey-box"): Promise<string> {
+  const dir = path.join(await tmpDir("studio-unity-"), name);
+  await cp(greyBox, dir, { recursive: true });
+  await rm(path.join(dir, "manifest.json"));
+  return dir;
+}
+
+async function writeManifest(dir: string, deps: Record<string, string>): Promise<void> {
+  await writeFile(path.join(dir, "Packages", "manifest.json"), `${JSON.stringify({ dependencies: deps }, null, 2)}\n`);
+}
+
+const URP_DEPS = {
+  "com.aigamestudio.bridge": "file:com.aigamestudio.bridge",
+  "com.unity.inputsystem": "1.11.2",
+  "com.unity.pipeline": UNITY_PIN.pipelineVersion,
+  "com.unity.render-pipelines.universal": "17.0.4",
