+    const [a, b] = await Promise.all([this.#bitmapOf(fileA), this.#bitmapOf(fileB)]);
+    return { diff: computePixelDiff(a.bgra, b.bgra, a.width, a.height), heatmap: null };
+  }
+
+  async statsOf(data: Buffer): Promise<{ stats: PixelStats; width: number; height: number }> {
+    if (this.#imageOps?.statsOf) return this.#imageOps.statsOf(data);
+    if (!isPng(data)) throw new Error("on a headless studio the Unity port reads PNG stills only");
+    const bitmap = decodePng(data);
+    return { stats: computePixelStats(bitmap.bgra, bitmap.width, bitmap.height), width: bitmap.width, height: bitmap.height };
+  }
+
+  async resizeImage(data: Buffer, maxPx: number, quality = 80): Promise<Buffer> {
+    if (isPng(data)) return encodeJpeg(resizeBitmap(decodePng(data), maxPx), quality);
+    if (this.#imageOps?.resizeImage) return this.#imageOps.resizeImage(data, maxPx, quality);
+    return data;
+  }
+
+  async pairImages(left: Buffer, right: Buffer, opts: { height?: number; quality?: number } = {}): Promise<Buffer> {
+    if (this.#imageOps?.pairImages) return this.#imageOps.pairImages(left, right, opts);
+    if (!isPng(left) || !isPng(right)) throw new Error("on a headless studio the Unity port pairs PNG stills only");
