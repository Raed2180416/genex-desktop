+/**
+ * Unity in the studio (2026-09-11, `.claude/plans/unity-integration-plan.md`): the shapes every
+ * lane of the work shares. Types only — no Electron, no Node I/O — so the renderer, the main
+ * process, the substrate and the tests all read one definition of what a Unity status, a grant,
+ * an editor descriptor, a tool name and a run event look like.
+ *
+ * Unity here is a second preview surface, not a second harness: the editor is a long-lived
+ * process per run with an HTTP server (the Pipeline package), the studio owns its bearer token,
+ * and agents reach it only through the studio's own `unity_*` tools.
+ */
+
+// ── detection and setup ──────────────────────────────────────────────────────────────────────
+
+export type UnityStatusCode = "ready" | "no_cli" | "no_editor" | "not_signed_in" | "no_licence" | "error";
+
+/** One installed editor as `unity editors --installed --json` reports it. */
+export interface UnityEditorInfo {
+  /** e.g. `6000.0.50f1` */
+  version: string;
+  /** The install root (`…/Unity.app`) or, in tests, a bare executable. */
+  path: string;
+  /** The executable the studio spawns: `<path>/Contents/MacOS/Unity`, or `path` when it is not an app bundle. */
+  binary: string;
+  /** Where the install came from, when the CLI says. */
+  source?: "hub" | "cli" | "manual" | null;
+}
+
+/** What the studio knows about Unity on this Mac, in one object the picker can show. */
+export interface UnityStatus {
+  code: UnityStatusCode;
+  /** the composer's toggle (settings.unity) */
+  enabled: boolean;
+  /** The `unity` CLI, when found. */
+  cli: { version: string; path: string; source: "studio" | "path" | "hub" } | null;
+  /** Every installed editor at or above the minimum, newest first. */
+  editors: UnityEditorInfo[];
+  /**
+   * The account `unity auth status` reports, when signed in — asked only on the user's own
+   * "Check again" or after a sign-in, because on macOS that question makes the CLI read its
+   * keychain item and the system prompts for it (measured 2026-09-11: "Always Allow" did not
+   * hold across the CLI's own session refreshes, and the owner saw the prompt on every check).
+   */
+  account: { name: string | null; email: string | null } | null;
+  /** Whether the account was ever asked for; false means "not checked", not "signed out". */
+  accountChecked: boolean;
+  /** The licence: from Unity's licence file on disk (`file`) in routine detection, from the CLI (`cli`) after a check. */
+  licence: { kind: string; active: boolean; source?: "file" | "cli" } | null;
+  /** one sentence for the picker: "Unity 6000.0.50f1 found" / "the Unity CLI is not on this Mac" */
+  detail: string;
+  remedy?: string;
+  pin: { cliMinimum: string; editorMinimum: string; editorPreferred: string };
+}
+
+// ── the project ──────────────────────────────────────────────────────────────────────────────
+
+/** What `detectProjectShape` reads off a Unity project root. */
+export interface UnityProjectFacts {
+  /** `m_EditorVersion` from ProjectSettings/ProjectVersion.txt, e.g. `6000.0.50f1`. */
+  editorVersion: string;
+  /** `com.unity.pipeline` is in Packages/manifest.json. */
+  pipeline: boolean;
+  /** `com.aigamestudio.bridge` is embedded under Packages/. */
+  bridge: boolean;
+  /** `com.unity.inputsystem` is in the manifest (the studio can drive the game). */
+  inputSystem: boolean;
+  renderPipeline: "urp" | "hdrp" | "builtin";
+  /** A test assembly exists under Assets/ (an asmdef that references the Test Runner): `unity-tests-pass` rides only then. */
+  tests?: boolean;
+}
+
+/** The version line a Unity night records on `run_started.unity` and reads in briefs. */
+export interface UnityRunFacts {
+  editorVersion: string;
+  cli: string;
+  queueSlots: number;
+  /** Mirrors `UnityProjectFacts.tests` onto the run record. */
+  tests?: boolean;
+}
+
+// ── the grant (the serializable half that crosses the RPC) ───────────────────────────────────
+
+export type UnityRole = "builder" | "director" | "playtester" | "scout";
+
+/**
+ * A delegation's Unity grant: which project, which worktree the editor opens, and for whose
+ * run record. `root` must equal the delegation's cwd — the tools only ever reach the editor
+ * leased on the caller's own worktree.
+ */
+export interface UnityGrant {
+  project: string;
+  root: string;
+  runId?: string;
+  facetId?: string;
+  iteration?: number;
+  role?: UnityRole;
+  label?: string;
+}
+
+// ── the editor ───────────────────────────────────────────────────────────────────────────────
+
+/** `<project>/Library/Pipeline/.unity-pipeline-port`, as the Pipeline package writes it. */
+export interface UnityEditorDescriptor {
+  pid: number;
+  port: number;
+  projectPath?: string;
+  unityVersion?: string;
+  mode: "editor" | "batchmode";
+  evalToken: string;
+  /** ISO time or epoch ms — the package rewrites the file on every heartbeat. */
+  lastHeartbeat?: string | number;
+  capabilities?: string[];
+}
+
+/** `<project>/Library/Pipeline/.unity-pipeline-runtime-port` — the Play-mode server (input, timescale). */
+export interface UnityRuntimeDescriptor {
+  pid: number;
+  port: number;
+  evalToken?: string;
+  lastHeartbeat?: string | number;
+}
+
+export type UnityEditorState = "starting" | "settling" | "settled" | "playing" | "paused" | "stopped" | "crashed" | "restarted";
+
+/** One `POST /api/exec` answer, normalised: the studio never throws on a Unity error, it reports it. */
+export interface UnityExecResult {
+  ok: boolean;
+  /** The command's own JSON result when ok. */
+  result?: unknown;
+  /** The error text when not ok. */
+  error?: string;
+  /** HTTP status; 503 carries `busyReason` (`settling`, `blocked_by_dialog`, `compiling`). */
+  status?: number;
+  busyReason?: string;
+  ms?: number;
+}
+
+/** Handles for Unity ports carry this prefix so `preview.*` RPCs can route them off the pool. */
+export const UNITY_HANDLE_PREFIX = "unity:";
+
+/** The evidence a Unity pass adds beside the browser envelope (`gatherEvidence(surface: "unity")`). */
+export interface UnityEvidence {
+  compile: { ok: boolean; errors: string[]; ms: number };
+  play: { ok: boolean; frames: number; exceptions: number; ms: number } | null;
+  tests: { ran: boolean; passed: number; failed: number; failures: string[]; ms: number } | null;
+}
+
+// ── the tool family (D5) ─────────────────────────────────────────────────────────────────────
+
+/**
+ * The studio's Unity tools, in the order they are granted. Every engine renders these names in
+ * its own voice (`mcp__studio__unity_play` / `node .studio/bridge/tool.mjs unity_play`); the
+ * order is asserted by the engine tests, so add at the end.
+ */
+export const UNITY_TOOL_NAMES = [
+  "unity_play",
+  "unity_pause",
+  "unity_stop",
+  "unity_capture",
+  "unity_state",
+  "unity_input",
+  "unity_console",
+  "unity_recompile",
+  "unity_test",
+  "unity_command",
+  "unity_session",
+] as const;
+export type UnityToolName = (typeof UNITY_TOOL_NAMES)[number];
+
+/** Which roles get which tools (§3.4 of the plan). */
+export const UNITY_TOOLS_BY_ROLE: Record<UnityRole, readonly UnityToolName[]> = {
+  builder: UNITY_TOOL_NAMES,
+  director: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console", "unity_recompile", "unity_test", "unity_command"],
+  playtester: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console"],
+  scout: ["unity_play", "unity_pause", "unity_stop", "unity_capture", "unity_state", "unity_input", "unity_console"],
+};
+
+/**
+ * Pipeline commands the proxy never forwards, whoever asks (`src/main/unity-gate.ts`). `eval`
+ * is the reason the raw CLI is not handed to agents at all: with the editor's token it is
+ * unrestricted C# on the editor's main thread.
+ */
+export const UNITY_DENIED_COMMANDS = [
+  "eval",
+  "eval_file",
+  "menu",
+  "build",
+  "quit",
+  "set_authoring_root",
+  "add_scene_to_build",
+  "remove_scene_from_build",
+] as const;
+
+/** Command-name prefixes that mutate the project outside any seam; denied in full. */
+export const UNITY_DENIED_PREFIXES = ["package_", "project_settings_", "set_project_setting", "add_package", "remove_package"] as const;
+
+// ── run events ───────────────────────────────────────────────────────────────────────────────
+
+/** `unity_action`: one tool call, folded into counts on the Builds tab. */
+export interface UnityActionEvent {
+  runId: string | null;
+  facetId: string | null;
+  role: UnityRole;
+  tool: UnityToolName;
+  command: string | null;
+  ok: boolean;
+  ms: number;
+  queueWaitMs: number;
+}
+
+/** `unity_validation`: one evidence pass on an editor (gate, health, iteration, validate). */
+export interface UnityValidationEvent {
+  runId: string;
+  facetId: string | null;
+  mode: "gate" | "health" | "iteration" | "validate";
+  worker: string | null;
+  ok: boolean;
+  compileMs: number;
+  compileErrors: number;
+  played: boolean;
+  testsPassed: number | null;
+  testsFailed: number | null;
+  /** A saved still, when the pass took one. */
+  still: string | null;
+  queueWaitMs: number;
+  editorVersion: string | null;
+  /** The first compiler line when the pass did not compile — the chat shows it; counts alone say nothing. (lane F, additive) */
+  firstError?: string | null;
+}
+
+/** `unity_editor`: the editor's lifecycle, for the stage status line and the Builds tab. */
+export interface UnityEditorEvent {
+  runId: string | null;
+  label: string;
+  state: UnityEditorState;
+  ms: number;
+  editorVersion: string | null;
+  detail?: string;
+}
+
+// ── the stage (renderer ↔ main) ──────────────────────────────────────────────────────────────
+
+/** One frame of the stage's still stream. */
+export interface UnityFrameView {
+  /** base64 JPEG, or null when the editor has nothing to show yet. */
+  jpeg: string | null;
+  width: number;
+  height: number;
+  state: UnityEditorState;
+  /** e.g. "Unity 6000.0.50f1 · Playing · frame 1 204" */
+  status: string;
+  frame: number | null;
+  scene: string | null;
+  editorVersion: string | null;
+  /** How long the stage waited for this frame. */
+  ms: number;
+}
+
+export type UnityTransportAction = "play" | "pause" | "stop" | "capture" | "step";
+
+/** Keyboard and pointer events the stage forwards (M2); coordinates are in frame pixels, origin top-left. */
+export type UnityStageInput =
+  | { type: "key"; key: string; action: "down" | "up" | "press" }
+  | { type: "pointer"; x: number; y: number; action: "move" | "down" | "up" | "click"; button?: "left" | "right" | "middle" }
+  | { type: "wheel"; x: number; y: number; dx: number; dy: number };
+
+/** What the Unity page (tools menu) shows: mirrored from `UnityStatus` field by field. */
+export type UnityStatusView = UnityStatus;
+
+/** Progress of a setup step (`unity.setup` events): the CLI download, the sign-in, the editor install, the package install. */
+export interface UnitySetupView {
+  step: "cli" | "signin" | "editor" | "pipeline";
+  phase: "running" | "done" | "error" | "cancelled";
+  /** 0–1 when the step reports progress, else null. */
+  progress: number | null;
+  /** The last line the CLI printed, for the row under the button. */
+  line: string;
+  error?: string;
+}
+
+/** Settings the Unity page reads and writes. */
+export interface UnitySettingsView {
+  /** may builders use Unity (default on) */
+  unity: boolean;
+  /** transient editors for workers at once (default 1; hidden until measured) */
+  unityQueueSlots: number;
+  /** launch editors with -batchmode — no Unity window on this Mac, the game shows in the studio only (default on since 2026-09-11; Open in Unity opens a window on request) */
+  unityHeadless: boolean;
+}
+
+export const UNITY_DEFAULT_QUEUE_SLOTS = 1;
