diff --git a/src/unity-bridge/Runtime/StudioBridge.cs b/src/unity-bridge/Runtime/StudioBridge.cs
new file mode 100644
index 0000000..3691abd
--- /dev/null
+++ b/src/unity-bridge/Runtime/StudioBridge.cs
@@ -0,0 +1,297 @@
+// The studio's contract inside a Unity project — the analogue of the browser template's
+// `window.__studio`. The game registers what it knows (probes, actions, demos, cameras, tags);
+// the studio reads it through the studio_* commands. With no registration at all the bridge
+// still answers from what every scene has: Camera.main, the Player, the enabled input actions.
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace AIGameStudio.Bridge
+{
+    public static class StudioBridge
+    {
+        public const int ContractVersion = 1;
+        /// The stepped clock: one studio step is one sixtieth of a second, as in the browser.
+        public const float StepSeconds = 1f / 60f;
+
+        static readonly SortedDictionary<string, Func<object>> probes = new SortedDictionary<string, Func<object>>(StringComparer.Ordinal);
+        static readonly SortedDictionary<string, Action> actions = new SortedDictionary<string, Action>(StringComparer.Ordinal);
+        static readonly SortedDictionary<string, Func<IEnumerator>> demos = new SortedDictionary<string, Func<IEnumerator>>(StringComparer.Ordinal);
+        static readonly SortedDictionary<string, Camera> cameras = new SortedDictionary<string, Camera>(StringComparer.Ordinal);
+        static readonly SortedDictionary<string, int> actionCounts = new SortedDictionary<string, int>(StringComparer.Ordinal);
+        static readonly List<KeyValuePair<GameObject, string>> tagged = new List<KeyValuePair<GameObject, string>>();
+
+        static int seed;
+        static bool paused;
+        static int stepFrames;
+        static int frame;
+        static string currentCamera = "default";
+        static Camera defaultCamera;
+        static Camera eyeCamera;
+
+        /// Raised by studio_seed after the random state is reset — the game's chance to put its world back.
+        public static event Action<int> Reset;
+
+        /// A value the judge reads by path: `Register("player.x", () => player.position.x)`.
+        public static void Register(string path, Func<object> read)
+        {
+            if (string.IsNullOrEmpty(path) || read == null) return;
+            probes[path] = read;
+        }
+
+        /// A named action the harness can trigger: `RegisterAction("primary", Fire)`.
+        public static void RegisterAction(string name, Action run)
+        {
+            if (string.IsNullOrEmpty(name) || run == null) return;
+            actions[name] = run;
+        }
+
+        /// A scripted demonstration, run as a coroutine to its end state: `RegisterDemo("walk", Walk)`.
+        public static void RegisterDemo(string name, Func<IEnumerator> run)
+        {
+            if (string.IsNullOrEmpty(name) || run == null) return;
+            demos[name] = run;
+        }
+
+        /// A camera the judge may switch to by name (`eye:here` for the player's own eyes).
+        public static void RegisterCamera(string name, Camera camera)
+        {
+            if (string.IsNullOrEmpty(name) || camera == null) return;
+            cameras[name] = camera;
+        }
+
+        /// Tag an object so checks can count it; a StudioTag component does this from the scene.
+        public static void Tag(GameObject target, string label)
+        {
+            if (target == null || string.IsNullOrEmpty(label)) return;
+            foreach (var entry in tagged) if (entry.Key == target && entry.Value == label) return;
+            tagged.Add(new KeyValuePair<GameObject, string>(target, label));
+        }
+
+        /// Count one performed action; the runner does this for every enabled Input System action.
+        public static void CountAction(string name)
+        {
+            if (string.IsNullOrEmpty(name)) return;
+            actionCounts.TryGetValue(name, out var count);
+            actionCounts[name] = count + 1;
+        }
+
+        /// The state the judge reads: defaults first, then every registered probe at its path.
+        public static Dictionary<string, object> State()
+        {
+            StudioBridgeRunner.Ensure();
+            var state = new Dictionary<string, object>
+            {
+                ["contract"] = ContractVersion,
+                ["frame"] = frame,
+                ["time"] = Time.timeAsDouble,
+                ["seed"] = seed,
+                ["paused"] = paused,
+                ["camera"] = currentCamera,
+                ["player"] = PlayerState(),
+                ["actions"] = new SortedDictionary<string, int>(actionCounts),
+                ["tags"] = TagCounts(),
+                ["demo"] = StudioBridgeRunner.DemoState(),
+                ["__render"] = StudioBridgeRunner.RenderStats(),
+            };
+            foreach (var probe in probes)
+            {
+                object value;
+                try { value = probe.Value(); }
+                catch (Exception e) { value = "error: " + e.Message; }
+                SetPath(state, probe.Key, value);
+            }
+            return state;
+        }
+
+        /// `{ x, y, z, yaw }` from the object tagged Player, else the first CharacterController; null when neither.
+        static object PlayerState()
+        {
+            var player = PlayerTransform();
+            if (player == null) return null;
+            var position = player.position;
+            return new Dictionary<string, object> { ["x"] = position.x, ["y"] = position.y, ["z"] = position.z, ["yaw"] = player.eulerAngles.y };
+        }
+
+        internal static Transform PlayerTransform()
+        {
+            var byTag = GameObject.FindWithTag("Player");
+            if (byTag != null) return byTag.transform;
+            var controller = UnityEngine.Object.FindFirstObjectByType<CharacterController>();
+            return controller != null ? controller.transform : null;
+        }
+
+        static SortedDictionary<string, int> TagCounts()
+        {
+            tagged.RemoveAll(entry => entry.Key == null);
+            var counts = new SortedDictionary<string, int>(StringComparer.Ordinal);
+            foreach (var entry in tagged)
+            {
+                counts.TryGetValue(entry.Value, out var count);
+                counts[entry.Value] = count + 1;
+            }
+            return counts;
+        }
+
+        /// `SetPath(state, "player.x", 1)` writes `state["player"]["x"]`, creating the dictionaries on the way.
+        static void SetPath(Dictionary<string, object> root, string path, object value)
+        {
+            var parts = path.Split('.');
+            var current = root;
+            for (var i = 0; i < parts.Length - 1; i++)
+            {
+                if (!(current.TryGetValue(parts[i], out var next) && next is Dictionary<string, object> child))
+                {
+                    child = new Dictionary<string, object>();
+                    current[parts[i]] = child;
+                }
+                current = child;
+            }
+            current[parts[parts.Length - 1]] = value;
+        }
+
+        /// Reseed, fix the step, tell the game to reset — and pause, so the judge steps from a known frame.
+        public static object Seed(int value)
+        {
+            StudioBridgeRunner.Ensure();
+            seed = value;
+            UnityEngine.Random.InitState(value);
+            Time.captureDeltaTime = StepSeconds;
+            frame = 0;
+            actionCounts.Clear();
+            try { Reset?.Invoke(value); }
+            catch (Exception e) { Debug.LogException(e); }
+            Pause();
+            return new Dictionary<string, object> { ["seed"] = value, ["paused"] = true, ["frame"] = frame };
+        }
+
+        public static object Pause()
+        {
+            StudioBridgeRunner.Ensure();
+            paused = true;
+            stepFrames = 0;
+            Time.timeScale = 0f;
+            return new Dictionary<string, object> { ["paused"] = true, ["frame"] = frame };
+        }
+
+        /// Resume live play; runs the game's own `start` action when it registered one (a title screen).
+        public static object Start()
+        {
+            StudioBridgeRunner.Ensure();
+            paused = false;
+            stepFrames = 0;
+            Time.timeScale = 1f;
+            if (actions.TryGetValue("start", out var start)) RunAction("start", start);
+            return new Dictionary<string, object> { ["paused"] = false, ["frame"] = frame };
+        }
+
+        /// Advance `frames` fixed steps while paused; the runner lets the clock run for exactly that many frames.
+        public static object Step(int frames)
+        {
+            StudioBridgeRunner.Ensure();
+            if (frames < 1) frames = 1;
+            paused = true;
+            stepFrames = frames;
+            Time.timeScale = 1f;
+            return new Dictionary<string, object> { ["stepping"] = frames, ["frame"] = frame };
+        }
+
+        /// One frame of the runner's Update: count the frame, and refreeze when the requested steps ran out.
+        internal static void Tick()
+        {
+            if (Time.timeScale <= 0f) return;
+            frame++;
+            if (!paused) return;
+            if (--stepFrames <= 0)
+            {
+                stepFrames = 0;
+                Time.timeScale = 0f;
+            }
+        }
+
+        internal static int Frame => frame;
+        internal static bool Paused => paused;
+        /// Frames the last studio_step still has to run — 0 once the clock is frozen again.
+        internal static int Stepping => stepFrames;
+
+        /// `{ playing, frame, exceptions, firstFrameMs }` — what the studio waits on after play.
+        public static object Ready(bool playing)
+        {
+            StudioBridgeRunner.Ensure();
+            return StudioBridgeRunner.Ready(playing);
+        }
+
+        public static string[] Actions() => new List<string>(actions.Keys).ToArray();
+
+        public static object TriggerAction(string name)
+        {
+            if (string.IsNullOrEmpty(name) || !actions.TryGetValue(name, out var run)) return new Dictionary<string, object> { ["ok"] = false, ["error"] = "no action named " + name };
+            RunAction(name, run);
+            return new Dictionary<string, object> { ["ok"] = true, ["action"] = name };
+        }
+
+        static void RunAction(string name, Action run)
+        {
+            try { run(); }
+            catch (Exception e) { Debug.LogException(e); }
+            CountAction(name);
+        }
+
+        public static string[] Demos() => new List<string>(demos.Keys).ToArray();
+
+        /// Start a demo; it runs live (unpaused) to its end, and `state().demo` says when it is done.
+        public static object Demo(string name)
+        {
+            if (string.IsNullOrEmpty(name) || !demos.TryGetValue(name, out var run)) return new Dictionary<string, object> { ["ok"] = false, ["error"] = "no demo named " + name };
+            Start();
+            StudioBridgeRunner.Ensure().RunDemo(name, run);
+            return new Dictionary<string, object> { ["ok"] = true, ["demo"] = name };
+        }
+
+        /// `default`, every registered camera, and `eye:here` (synthesised at the player's head when nothing registered it).
+        public static string[] Cameras()
+        {
+            var names = new List<string> { "default" };
+            foreach (var name in cameras.Keys) if (name != "default") names.Add(name);
+            if (!cameras.ContainsKey("eye:here") && PlayerTransform() != null) names.Add("eye:here");
+            return names.ToArray();
+        }
+
+        public static string CurrentCamera => currentCamera;
+
+        /// Switch the camera the game view renders from, without touching the scene: enable one, disable the bridge's others.
+        public static object SwitchCamera(string name)
+        {
+            if (string.IsNullOrEmpty(name)) name = "default";
+            if (defaultCamera == null) defaultCamera = Camera.main;
+            Camera chosen;
+            if (name == "default") chosen = defaultCamera;
+            else if (!cameras.TryGetValue(name, out chosen) && name == "eye:here") chosen = EyeHere();
+            if (chosen == null) return new Dictionary<string, object> { ["ok"] = false, ["error"] = "no camera named " + name };
+            foreach (var camera in cameras.Values) if (camera != null && camera != chosen) camera.enabled = false;
+            if (eyeCamera != null && eyeCamera != chosen) eyeCamera.enabled = false;
+            if (defaultCamera != null && defaultCamera != chosen) defaultCamera.enabled = false;
+            chosen.enabled = true;
+            currentCamera = name;
+            return new Dictionary<string, object> { ["ok"] = true, ["camera"] = name };
+        }
+
+        /// A camera at the player's head, looking where the player looks — made once, moved on every switch.
+        static Camera EyeHere()
+        {
+            var player = PlayerTransform();
+            if (player == null) return null;
+            if (eyeCamera == null)
+            {
+                var holder = new GameObject("StudioEye") { hideFlags = HideFlags.DontSave };
+                eyeCamera = holder.AddComponent<Camera>();
+                eyeCamera.enabled = false;
+            }
+            eyeCamera.transform.SetParent(player, false);
+            eyeCamera.transform.localPosition = new Vector3(0f, 0.6f, 0f);
+            eyeCamera.transform.localRotation = Quaternion.identity;
+            return eyeCamera;
+        }
+    }
+}
