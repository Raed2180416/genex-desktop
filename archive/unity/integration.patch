+    const factor = Math.max(1, Math.floor(Math.min(UNITY_VIEW.width / cropped.width, UNITY_VIEW.height / cropped.height)));
+    const scaled = scaleBitmapUp(cropped, factor);
+    return { jpeg: encodeJpeg(scaled, quality), width: scaled.width, height: scaled.height, region };
+  }
