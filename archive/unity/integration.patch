+    return { x: p.x, y: UNITY_VIEW.height - p.y };
+  }
+
+  async #key(key: string, action: "down" | "up"): Promise<boolean> {
+    const name = unityKeyName(key);
+    if (!name) return false;
+    // Measured 2026-09-11: `simulate_key { key, action }` on the runtime server moves the player in editor Play mode, windowed and headless.
+    return (await this.#runtime("simulate_key", { key: name, action })).ok;
+  }
+
+  async #pointerAt(x: number, y: number, exact: boolean, action: "move" | "down" | "up", button = "left", extra: Record<string, unknown> = {}): Promise<boolean> {
+    const p = pointInView(x, y, UNITY_VIEW.width, UNITY_VIEW.height, { exact });
