+/**
+ * Unity setup on the user's click (Unity in the studio, owner decision D2): install the CLI
+ * into the studio's own folder, sign in through Unity's browser flow, install a Unity 6
+ * editor after the user ticked the EULA box, and add the Pipeline package plus the studio's
+ * bridge to a project after the once-asked consent. Every step streams `--format ndjson`
+ * lines as progress; nothing here runs without a click in the Unity page or the Open Game
+ * sheet, and nothing here is reachable by an agent.
+ *
+ * Signatures are the contract main/index.ts and the tests are written against; the bodies are
+ * lane A's (see .claude/plans/unity-integration-workpackages.md). The CLI's download mechanics
+ * live in unity-download.ts; the Pipeline write needs no CLI at all — it is two manifest lines
+ * and one folder, written by hand so the sheet can show exactly what changes.
+ */
+import { createHash } from "node:crypto";
+import { cp, readFile, readdir, rm, stat, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { UNITY_PIN, unityCliEnv } from "../substrate/unity.ts";
+import type { UnitySetupView } from "../substrate/unity-types.ts";
+import { downloadUnityCli, runLines } from "./unity-download.ts";
+
+export interface SetupOptions {
+  /** Test seam: spawn the CLI (default: node:child_process). Must resolve when the process exits. */
+  run?: (file: string, args: string[], opts: { cwd?: string; env?: NodeJS.ProcessEnv; signal: AbortSignal; onLine: (line: string) => void }) => Promise<{ code: number }>;
+  /** Test seam for the CLI download: a `fetch` that answers with a body stream (default: Electron's `net.fetch`). */
+  fetch?: (url: string, init: { signal: AbortSignal }) => Promise<{ ok: boolean; status: number; headers: { get(name: string): string | null }; body: ReadableStream<Uint8Array> | null }>;
+  /** Test seam: where the install script is told to put the binary (default `<userData>/tools`). */
+  installDir?: string;
+}
+
+/** The sentence main/index.ts answers with too; the checkbox is the only thing that sets `acceptEula`. */
+export const EULA_REFUSAL = "Tick “I accept Unity's Editor Software Terms” first — the studio never accepts them for you.";
+
+const LINE_MAX = 200;
+
+/** One `--format ndjson` line, read for what the page shows: a sentence, a fraction, an error. */
+interface NdjsonView {
+  line: string | null;
+  progress: number | null;
+  error: string | null;
+}
+
+/**
+ * spike S6: the field names of the CLI's ndjson lines (`message`, `progress`, `error`, `url`)
+ * are read off a real `unity auth login` / `unity install` on the owner's Mac; until then the
+ * usual names are tried and a line that fits none is shown as it is.
+ */
+export function readNdjsonLine(raw: string): NdjsonView {
+  const text = raw.trim();
+  if (!text) return { line: null, progress: null, error: null };
+  let parsed: Record<string, unknown> | null = null;
+  try {
+    const value = JSON.parse(text) as unknown;
+    parsed = value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+  } catch {
+    parsed = null;
+  }
+  if (!parsed) return { line: text.slice(0, LINE_MAX), progress: null, error: null };
+  const message = [parsed.message, parsed.msg, parsed.status, parsed.text, parsed.step].find((v) => typeof v === "string" && v.trim()) as string | undefined;
+  const url = [parsed.url, parsed.verificationUrl, parsed.verification_url].find((v) => typeof v === "string" && /^https?:\/\//.test(v)) as string | undefined;
+  const rawFraction = [parsed.progress, parsed.fraction, parsed.percent, parsed.percentage].find((v) => typeof v === "number" && Number.isFinite(v)) as number | undefined;
+  let progress: number | null = null;
+  if (rawFraction !== undefined) progress = Math.max(0, Math.min(1, rawFraction > 1 ? rawFraction / 100 : rawFraction));
+  else if (typeof parsed.downloaded === "number" && typeof parsed.total === "number" && parsed.total > 0) progress = Math.max(0, Math.min(1, parsed.downloaded / parsed.total));
+  const level = typeof parsed.type === "string" ? parsed.type : typeof parsed.level === "string" ? parsed.level : "";
+  const errorText = typeof parsed.error === "string" ? parsed.error : parsed.error && typeof parsed.error === "object" && typeof (parsed.error as { message?: unknown }).message === "string" ? ((parsed.error as { message: string }).message) : null;
+  const error = errorText ?? (/^(error|fatal|failed)$/i.test(level) && message ? message : null);
+  const line = message ?? (url ? `Open ${url} in your browser` : null) ?? (error ? error : null);
+  return { line: line ? line.slice(0, LINE_MAX) : null, progress, error: error ? error.slice(0, LINE_MAX) : null };
+}
+
+/** Run one CLI command through the seam, streaming its ndjson lines as progress; throws on a non-zero exit. */
+async function streamCli(cli: string, args: string[], step: UnitySetupView["step"], onProgress: (p: UnitySetupView) => void, signal: AbortSignal, options: SetupOptions, opening: string): Promise<void> {
+  const run = options.run ?? runLines;
+  let lastLine = "";
+  let lastError: string | null = null;
+  let fraction: number | null = null;
+  onProgress({ step, phase: "running", progress: null, line: opening });
+  const { code } = await run(cli, args, {
+    env: unityCliEnv(),
+    signal,
+    onLine: (raw) => {
+      const view = readNdjsonLine(raw);
+      if (view.error) lastError = view.error;
+      if (view.progress !== null) fraction = view.progress;
+      if (view.line) lastLine = view.line;
+      if (view.line || view.progress !== null) onProgress({ step, phase: "running", progress: fraction, line: view.line ?? lastLine });
+    },
+  });
+  if (signal.aborted) throw new Error("cancelled");
+  if (code !== 0) throw new Error(lastError ?? `unity ${args[0]} exited with ${code}${lastLine ? `: ${lastLine}` : ""}`);
+}
+
+/**
+ * Install the Unity CLI into `<userData>/tools/unity` (never /usr/local). Resolves to the
+ * installed binary's path; throws with a sentence the page can show.
+ */
+export async function installUnityCli(userData: string, onProgress: (p: UnitySetupView) => void, signal: AbortSignal, options: SetupOptions = {}): Promise<string> {
+  return downloadUnityCli(userData, onProgress, signal, options);
+}
+
+/** `unity auth login` — opens Unity's sign-in in the browser; resolves when the CLI reports signed in. */
+export async function signInUnity(cli: string, onProgress: (p: UnitySetupView) => void, signal: AbortSignal, options: SetupOptions = {}): Promise<void> {
+  await streamCli(cli, ["auth", "login", "--format", "ndjson"], "signin", onProgress, signal, options, "Opening Unity's sign-in in your browser…");
+}
+
+/**
+ * `unity install <version> --accept-eula` — refused unless `acceptEula` is true, which only the
+ * user's checkbox sets. Progress lines from `--format ndjson`.
+ */
+export async function installUnityEditor(cli: string, version: string, opts: { acceptEula: boolean }, onProgress: (p: UnitySetupView) => void, signal: AbortSignal, options: SetupOptions = {}): Promise<void> {
+  if (opts?.acceptEula !== true) throw new Error(EULA_REFUSAL);
+  const wanted = version.trim() || UNITY_PIN.editorPreferred;
+  if (!/^[0-9A-Za-z.]+$/.test(wanted)) throw new Error(`"${wanted}" is not a Unity version`);
+  await streamCli(cli, ["install", wanted, "--accept-eula", "--format", "ndjson"], "editor", onProgress, signal, options, `Installing Unity ${wanted}…`);
+}
+
+/** The manifest's `dependencies`, with `wanted` set: inserted in order when the list is sorted (Unity writes it sorted), else appended. */
+function withDependencies(existing: Record<string, string>, wanted: Record<string, string>): Record<string, string> {
+  const keys = Object.keys(existing);
+  const sorted = keys.every((key, i) => i === 0 || keys[i - 1]!.localeCompare(key) <= 0);
+  const pending = Object.keys(wanted)
+    .filter((key) => !(key in existing))
+    .sort((a, b) => a.localeCompare(b));
+  const out: Record<string, string> = {};
+  for (const key of keys) {
+    if (sorted) {
+      while (pending.length && pending[0]!.localeCompare(key) < 0) {
+        const next = pending.shift()!;
+        out[next] = wanted[next]!;
+      }
+    }
+    out[key] = key in wanted ? wanted[key]! : existing[key]!;
+  }
+  for (const key of pending) out[key] = wanted[key]!;
+  return out;
+}
+
+/** sha256 of every file under `dir`, keyed by relative path — or null when the folder is not there. */
+async function treeDigest(dir: string): Promise<Map<string, string> | null> {
+  const info = await stat(dir).catch(() => null);
+  if (!info || !info.isDirectory()) return null;
+  const out = new Map<string, string>();
+  const walk = async (rel: string): Promise<void> => {
+    for (const entry of await readdir(path.join(dir, rel), { withFileTypes: true })) {
+      const child = rel ? `${rel}/${entry.name}` : entry.name;
+      if (entry.isDirectory()) await walk(child);
+      else if (entry.isFile()) out.set(child, createHash("sha256").update(await readFile(path.join(dir, child))).digest("hex"));
+    }
+  };
+  await walk("");
+  return out;
+}
+
+function sameDigest(a: Map<string, string>, b: Map<string, string>): boolean {
+  if (a.size !== b.size) return false;
+  for (const [key, value] of a) if (b.get(key) !== value) return false;
+  return true;
+}
+
+/**
+ * Add `com.unity.pipeline` (pinned) and the studio's embedded bridge package to a project:
+ * exactly the manifest lines the Open Game sheet showed, plus `Packages/com.aigamestudio.bridge/`.
+ * Returns what changed so the sheet can say so.
+ */
+export async function installPipelineIntoProject(projectDir: string, bridgeSourceDir: string, onProgress: (p: UnitySetupView) => void, _options: SetupOptions = {}): Promise<{ manifestChanged: boolean; bridgeWritten: boolean }> {
+  const manifestPath = path.join(projectDir, "Packages", "manifest.json");
+  const raw = await readFile(manifestPath, "utf8").catch(() => null);
+  if (raw === null) throw new Error("this folder has no Packages/manifest.json — it is not a Unity project");
+  let parsed: Record<string, unknown>;
+  try {
+    const value = JSON.parse(raw) as unknown;
+    if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error("not an object");
+    parsed = value as Record<string, unknown>;
+  } catch {
+    throw new Error("Packages/manifest.json is not the JSON Unity writes — open the project in Unity once, then try again");
+  }
+  const existing = parsed.dependencies && typeof parsed.dependencies === "object" && !Array.isArray(parsed.dependencies) ? (parsed.dependencies as Record<string, string>) : {};
+  const wanted: Record<string, string> = { [UNITY_PIN.pipelinePackage]: UNITY_PIN.pipelineVersion, [UNITY_PIN.bridgePackage]: `file:${UNITY_PIN.bridgePackage}` };
+  const manifestChanged = Object.entries(wanted).some(([key, value]) => existing[key] !== value);
+  if (manifestChanged) {
+    parsed.dependencies = withDependencies(existing, wanted);
+    await writeFile(manifestPath, `${JSON.stringify(parsed, null, 2)}\n`);
+    onProgress({ step: "pipeline", phase: "running", progress: null, line: `Packages/manifest.json: ${UNITY_PIN.pipelinePackage} ${UNITY_PIN.pipelineVersion}, ${UNITY_PIN.bridgePackage}` });
+  }
+
+  const source = await treeDigest(bridgeSourceDir);
+  if (!source) throw new Error("the studio's bridge package is missing from its resources — reinstall the studio");
+  const dest = path.join(projectDir, "Packages", UNITY_PIN.bridgePackage);
+  const present = await treeDigest(dest);
+  const bridgeWritten = !(present && sameDigest(source, present));
+  if (bridgeWritten) {
+    await rm(dest, { recursive: true, force: true });
+    await cp(bridgeSourceDir, dest, { recursive: true });
+    onProgress({ step: "pipeline", phase: "running", progress: null, line: `Packages/${UNITY_PIN.bridgePackage}: ${source.size} files` });
+  }
+  return { manifestChanged, bridgeWritten };
+}
