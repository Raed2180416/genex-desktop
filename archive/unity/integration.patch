+
+  // ── play, stop, pause, compile, tests, scenes ────────────────────────────────────────────
+
+  async #awaitFrames(timeoutMs: number): Promise<{ ok: boolean; frames: number; exceptions: number; ms: number; error?: string }> {
+    const started = Date.now();
