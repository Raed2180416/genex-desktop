+      pause: ["studio_pause", {}],
+      start: ["studio_start", {}],
+      debugCamera: ["studio_camera", { name: String(arg ?? "default") }],
+      eye: ["studio_camera", { name: String(arg ?? "eye:here") }],
+      demos: ["studio_demos", {}],
+      demo: ["studio_demo", { name: String(arg ?? "") }],
+    };
