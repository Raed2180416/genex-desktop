@@ -0,0 +1,62 @@
+// What this project measures — the registrations the judge reads (the analogue of the browser
+// template's installStudio({ player, probes, demos, cameras })). The bridge would find the
+// player and the input actions on its own; registering them here makes the paths explicit and
+// gives the checks a demo ("walk") and the eye camera. Keep every registration working; add
+// one probe per mechanic you build, a camera that shows it, a demo when the walk cannot reach it.
+using System.Collections;
+using AIGameStudio.Bridge;
+using UnityEngine;
+
+public sealed class StudioProbes : MonoBehaviour
+{
+    [SerializeField] PlayerController player;
+    [SerializeField] Camera eye;
+
+    void Awake()
+    {
+        var subject = player != null ? player : FindFirstObjectByType<PlayerController>();
+        if (subject != null)
+        {
+            StudioBridge.Register("player.x", () => subject.transform.position.x);
+            StudioBridge.Register("player.y", () => subject.transform.position.y);
+            StudioBridge.Register("player.z", () => subject.transform.position.z);
+            StudioBridge.Register("player.yaw", () => subject.Yaw);
+            StudioBridge.Register("player.grounded", () => subject.Grounded);
+            StudioBridge.Register("actions.primary", () => subject.PrimaryCount);
+            StudioBridge.RegisterAction("primary", subject.Primary);
+            StudioBridge.RegisterDemo("walk", Walk);
+            // The studio's mouse-look reaches the controller the way a person's does, once per stepped frame.
+            StudioInput.RegisterLook(delta => subject.Drive(Vector2.zero, delta));
+            StudioBridge.Reset += subject.ResetTo;
+        }
+        if (eye != null) StudioBridge.RegisterCamera("eye:here", eye);
+    }
+
+    void OnDestroy()
+    {
+        var subject = player != null ? player : FindFirstObjectByType<PlayerController>();
+        if (subject != null) StudioBridge.Reset -= subject.ResetTo;
+    }
+
+    /// The generic demonstration: walk forward for a second and a half, then turn and walk back.
+    IEnumerator Walk()
+    {
+        var subject = player != null ? player : FindFirstObjectByType<PlayerController>();
+        if (subject == null) yield break;
+        for (var i = 0; i < 90; i++)
+        {
+            subject.Drive(new Vector2(0f, 1f), Vector2.zero);
+            yield return null;
+        }
+        for (var i = 0; i < 30; i++)
+        {
+            subject.Drive(Vector2.zero, new Vector2(30f, 0f));
+            yield return null;
+        }
+        for (var i = 0; i < 60; i++)
+        {
+            subject.Drive(new Vector2(0f, 1f), Vector2.zero);
+            yield return null;
+        }
+    }
+}
