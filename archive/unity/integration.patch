+        case "down":
+          for (const key of action.keys) note(await this.#key(key, "down"));
+          break;
+        case "up":
+          for (const key of action.keys) note(await this.#key(key, "up"));
+          break;
+        case "hold": {
+          let all = true;
+          for (const key of action.keys) all = (await this.#key(key, "down")) && all;
