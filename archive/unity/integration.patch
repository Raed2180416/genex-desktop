+/**
+ * One check on one fixture: recorded either way, `{ ok, detail }` on every row. A step that
+ * throws is a failed row named after it — the program goes on to the next row and the teardown.
+ */
+class Sheet {
+  readonly rows: Row[] = [];
+  readonly label: string;
+  constructor(label: string) {
+    this.label = label;
+  }
+  ok(id: string, condition: unknown, detail: string): boolean {
+    const passed = Boolean(condition);
+    this.rows.push({ id, ok: passed, detail });
+    if (!passed) console.warn(`${this.label} — ${id}: ${detail}`);
+    return passed;
+  }
+  skip(id: string, reason: string, detail = ""): void {
+    this.rows.push({ id, ok: true, skipped: reason, detail: detail || `skipped: ${reason}` });
+  }
+  async step<T>(id: string, work: () => Promise<T>): Promise<T | undefined> {
+    try {
+      return await work();
+    } catch (err) {
+      this.rows.push({ id, ok: false, detail: `threw: ${message(err)}` });
+      console.warn(`${this.label} — ${id} threw: ${message(err)}`);
+      return undefined;
+    }
+  }
+  get passed(): boolean {
+    return this.rows.every((row) => row.ok);
