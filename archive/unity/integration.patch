+/**
+ * The gate inside `unity_command` (Unity in the studio, plan §3.4): the deny list and the
+ * denied prefixes for every role, the scene list for the entry owner only, `save_all` under
+ * the caller's own lease, every path-bearing argument resolved under the root and held to
+ * `allowedFile` with `ownershipReason`'s sentence on refusal, `confirm` injected on a mutation
+ * after the checks, `dry_run` passed through. Pure over its inputs: no editor anywhere.
+ */
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import { UNITY_PATH_ARG_KEYS, UNITY_READ_ONLY_PREFIXES, gateUnityCommand, isMutatingCommand, projectRelative } from "../../src/main/unity-gate.ts";
+import type { Ownership } from "../../src/substrate/ownership.ts";
+import { UNITY_DENIED_COMMANDS, UNITY_DENIED_PREFIXES, type UnityRole } from "../../src/substrate/unity-types.ts";
+
+const lighting: Ownership = { facetId: "lighting", owns: ["Assets/Lighting/**", "Assets/Studio/Probes.Lighting.cs"], ownsMain: false, template: false };
+const base = { role: "builder" as UnityRole, ownership: lighting, ownsMain: false, leaseOwner: true, root: "/tmp/wt" };
+const ROLES: UnityRole[] = ["builder", "director", "playtester", "scout"];
+
+describe("the unity_command gate — the deny list", () => {
+  it("refuses eval and the rest of the list whoever asks, and every denied prefix", () => {
+    for (const command of UNITY_DENIED_COMMANDS) {
+      if (command === "add_scene_to_build" || command === "remove_scene_from_build") continue;
+      for (const role of ROLES) {
+        const answer = gateUnityCommand({ ...base, role, command, args: {} });
+        assert.equal(answer.ok, false, `${role} may not ${command}`);
+        assert.match((answer as { reason: string }).reason, /not available through the studio/);
+      }
+    }
+    // The entry owner and a session without ownership (the director) are refused eval too.
+    assert.equal(gateUnityCommand({ ...base, role: "director", ownership: null, ownsMain: true, command: "eval", args: { code: "1" } }).ok, false);
+    assert.equal(gateUnityCommand({ ...base, command: "Eval", args: {} }).ok, false, "case does not slip through");
+    for (const prefix of UNITY_DENIED_PREFIXES) {
+      const answer = gateUnityCommand({ ...base, role: "director", ownership: null, ownsMain: true, command: `${prefix}anything`, args: {} });
+      assert.equal(answer.ok, false, prefix);
+      assert.match((answer as { reason: string }).reason, /packages or project settings/);
+    }
+  });
+
+  it("the build's scene list belongs to the entry owner", () => {
+    const worker = gateUnityCommand({ ...base, command: "add_scene_to_build", args: { scene: "Assets/Scenes/Main.unity" } });
+    assert.equal(worker.ok, false);
+    assert.match((worker as { reason: string }).reason, /belongs to whoever owns the entry/);
+    const owner = gateUnityCommand({ ...base, ownership: { ...lighting, ownsMain: true }, ownsMain: true, command: "remove_scene_from_build", args: { scene: "Assets/Scenes/Main.unity" } });
+    assert.equal(owner.ok, true);
+  });
+
+  it("save_all only under the caller's own lease", () => {
+    const refused = gateUnityCommand({ ...base, leaseOwner: false, command: "save_all", args: {} });
+    assert.equal(refused.ok, false);
+    assert.match((refused as { reason: string }).reason, /own editor lease/);
+    const held = gateUnityCommand({ ...base, command: "save_all", args: {} });
+    assert.equal(held.ok, true);
+    assert.equal(held.ok && held.args.confirm, true, "a save is a mutation: confirmed");
+  });
+});
+
+describe("the unity_command gate — paths and confirmation", () => {
+  it("resolves every path-bearing argument under the root and checks a mutation with allowedFile", () => {
+    const inside = gateUnityCommand({ ...base, command: "set_transform", args: { path: "Assets/Lighting/Sun.prefab", x: 1 } });
+    assert.ok(inside.ok);
+    assert.equal(inside.args.path, "Assets/Lighting/Sun.prefab");
+    assert.equal(inside.args.x, 1);
+    assert.equal(inside.args.confirm, true);
+    const outsideSeam = gateUnityCommand({ ...base, command: "set_transform", args: { path: "Assets/Player/Player.prefab" } });
+    assert.equal(outsideSeam.ok, false);
+    assert.match((outsideSeam as { reason: string }).reason, /Assets\/Player\/Player\.prefab is outside worker "lighting"'s seam/, "ownershipReason's own sentence");
+    const outsideRoot = gateUnityCommand({ ...base, command: "get_scene_hierarchy", args: { scene: "../other/Main.unity" } });
+    assert.equal(outsideRoot.ok, false);
+    assert.match((outsideRoot as { reason: string }).reason, /outside the project/);
+    const absolute = gateUnityCommand({ ...base, command: "open_scene", args: { path: "/tmp/wt/Assets/Lighting/Preview.unity" } });
+    assert.ok(absolute.ok);
+    assert.equal(absolute.args.path, "Assets/Lighting/Preview.unity", "an absolute path inside the root is handed on project-relative");
+    // A read of a file outside the seam is allowed: only mutations are held to ownership.
+    const read = gateUnityCommand({ ...base, command: "get_scene_hierarchy", args: { scene: "Assets/Scenes/Main.unity" } });
+    assert.ok(read.ok);
+    assert.equal(read.args.confirm, undefined);
+    for (const key of UNITY_PATH_ARG_KEYS) {
+      assert.equal(gateUnityCommand({ ...base, command: "create_gameobject", args: { [key]: "Assets/Other/x" } }).ok, false, `${key} is a path argument`);
+      assert.equal(gateUnityCommand({ ...base, command: "create_gameobject", args: { [key]: 42 } }).ok, false, `${key} must be a string`);
+    }
+    // Without ownership (the director's session) inside the root is enough.
+    const director = gateUnityCommand({ ...base, role: "director", ownership: null, ownsMain: true, command: "set_transform", args: { path: "Assets/Player/Player.prefab" } });
+    assert.ok(director.ok);
+    // The template rule: a facet's own module, and the .meta clause lands with lane D.
+    const template = gateUnityCommand({ ...base, ownership: { facetId: "lighting", owns: ["src/lighting.js"], ownsMain: false }, command: "set_transform", args: { path: "src/lighting.js" } });
+    assert.ok(template.ok);
+  });
+
+  it("injects confirm on a mutation after the checks, passes dry_run through, leaves reads alone", () => {
+    const mutation = gateUnityCommand({ ...base, command: "create_gameobject", args: { name: "Lamp" } });
+    assert.ok(mutation.ok);
+    assert.deepEqual(mutation.args, { name: "Lamp", confirm: true });
+    const dry = gateUnityCommand({ ...base, command: "create_gameobject", args: { name: "Lamp", dry_run: true } });
+    assert.ok(dry.ok);
+    assert.deepEqual(dry.args, { name: "Lamp", dry_run: true });
+    const dryString = gateUnityCommand({ ...base, command: "create_gameobject", args: { name: "Lamp", dry_run: "true" } });
+    assert.ok(dryString.ok);
+    assert.equal(dryString.args.confirm, undefined, "the bridge passes strings");
+    const read = gateUnityCommand({ ...base, command: "get_console_logs", args: { severity: "error" } });
+    assert.ok(read.ok);
+    assert.deepEqual(read.args, { severity: "error" });
+    for (const prefix of UNITY_READ_ONLY_PREFIXES) assert.equal(isMutatingCommand(`${prefix}x`), false, prefix);
+    assert.equal(isMutatingCommand("studio_state"), false);
+    assert.equal(isMutatingCommand("editor_status"), false);
+    assert.equal(isMutatingCommand("open_scene"), true);
+    assert.equal(isMutatingCommand("recompile"), true);
+    assert.equal(isMutatingCommand("editor_play"), true);
+    assert.equal(isMutatingCommand(""), false);
+  });
+
+  it("refuses an empty or malformed command name; projectRelative normalises", () => {
+    assert.equal(gateUnityCommand({ ...base, command: "", args: {} }).ok, false);
+    assert.equal(gateUnityCommand({ ...base, command: "rm -rf /", args: {} }).ok, false);
+    assert.equal(gateUnityCommand({ ...base, command: "  get_scene_hierarchy ", args: {} }).ok, true, "whitespace is trimmed");
+    assert.equal(projectRelative("./Assets/A.cs", "/tmp/wt"), "Assets/A.cs");
+    assert.equal(projectRelative("Assets/../Assets/A.cs", "/tmp/wt"), "Assets/A.cs");
+    assert.equal(projectRelative("/elsewhere/A.cs", "/tmp/wt"), null);
+    assert.equal(projectRelative("../A.cs", "/tmp/wt"), null);
