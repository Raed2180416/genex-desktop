+  const dcValue = coefficients[0]!;
+  const diff = dcValue - previousDc;
+  const dcCategory = categoryOf(diff);
+  const dcCode = dc[dcCategory]!;
+  writer.write(dcCode[0], dcCode[1]);
+  if (dcCategory) writer.write((diff < 0 ? diff - 1 : diff) & ((1 << dcCategory) - 1), dcCategory);
+  let run = 0;
+  for (let k = 1; k < 64; k++) {
+    const value = coefficients[ZIGZAG[k]!]!;
+    if (value === 0) {
+      run++;
+      continue;
+    }
+    while (run > 15) {
+      const zrl = ac[0xf0]!;
+      writer.write(zrl[0], zrl[1]);
+      run -= 16;
+    }
+    const category = categoryOf(value);
+    const symbol = ac[(run << 4) | category]!;
+    writer.write(symbol[0], symbol[1]);
+    writer.write((value < 0 ? value - 1 : value) & ((1 << category) - 1), category);
+    run = 0;
+  }
+  if (run > 0) {
+    const eob = ac[0x00]!;
+    writer.write(eob[0], eob[1]);
+  }
+  return dcValue;
+}
+
+function marker(id: number, body: Buffer): Buffer {
+  const head = Buffer.alloc(4);
+  head[0] = 0xff;
+  head[1] = id;
+  head.writeUInt16BE(body.length + 2, 2);
+  return Buffer.concat([head, body]);
+}
+
+/** A BGRA bitmap as a baseline JPEG (4:4:4, JFIF, standard Huffman tables) at `quality` 1–100. */
+export function encodeJpeg(bitmap: Bitmap, quality = 80): Buffer {
+  const { width, height, bgra } = bitmap;
+  if (!(width > 0 && height > 0)) throw new Error("an empty bitmap cannot be a JPEG");
+  const luma = quantTable(LUMA_QUANT, quality);
+  const chroma = quantTable(CHROMA_QUANT, quality);
+  const writer = new BitWriter();
+  const yBlock = new Float64Array(64);
+  const cbBlock = new Float64Array(64);
+  const crBlock = new Float64Array(64);
+  let dcY = 0;
+  let dcCb = 0;
+  let dcCr = 0;
+  for (let by = 0; by < height; by += 8) {
+    for (let bx = 0; bx < width; bx += 8) {
+      for (let y = 0; y < 8; y++) {
+        const sy = Math.min(height - 1, by + y);
+        for (let x = 0; x < 8; x++) {
+          const sx = Math.min(width - 1, bx + x);
+          const i = (sy * width + sx) * 4;
+          const b = bgra[i]!;
+          const g = bgra[i + 1]!;
+          const r = bgra[i + 2]!;
+          const k = y * 8 + x;
+          yBlock[k] = 0.299 * r + 0.587 * g + 0.114 * b - 128;
+          cbBlock[k] = -0.168736 * r - 0.331264 * g + 0.5 * b;
+          crBlock[k] = 0.5 * r - 0.418688 * g - 0.081312 * b;
+        }
+      }
+      dcY = encodeBlock(writer, yBlock, luma.natural, DC_LUMA, AC_LUMA, dcY);
+      dcCb = encodeBlock(writer, cbBlock, chroma.natural, DC_CHROMA, AC_CHROMA, dcCb);
+      dcCr = encodeBlock(writer, crBlock, chroma.natural, DC_CHROMA, AC_CHROMA, dcCr);
+    }
+  }
+  const scan = writer.finish();
+  const app0 = Buffer.from([0x4a, 0x46, 0x49, 0x46, 0x00, 1, 1, 0, 0, 1, 0, 1, 0, 0]);
+  const dqt = Buffer.concat([Buffer.from([0x00]), Buffer.from(luma.zigzag), Buffer.from([0x01]), Buffer.from(chroma.zigzag)]);
+  const sof = Buffer.alloc(15);
+  sof[0] = 8;
+  sof.writeUInt16BE(height, 1);
+  sof.writeUInt16BE(width, 3);
+  sof[5] = 3;
+  sof.set([1, 0x11, 0, 2, 0x11, 1, 3, 0x11, 1], 6);
+  const dht = Buffer.concat([
+    Buffer.from([0x00, ...DC_LUMA_BITS, ...DC_LUMA_VALUES]),
+    Buffer.from([0x10, ...AC_LUMA_BITS, ...AC_LUMA_VALUES]),
+    Buffer.from([0x01, ...DC_CHROMA_BITS, ...DC_CHROMA_VALUES]),
+    Buffer.from([0x11, ...AC_CHROMA_BITS, ...AC_CHROMA_VALUES]),
+  ]);
+  const sos = Buffer.from([3, 1, 0x00, 2, 0x11, 3, 0x11, 0, 63, 0]);
+  return Buffer.concat([
+    Buffer.from([0xff, 0xd8]),
+    marker(0xe0, app0),
+    marker(0xdb, dqt),
+    marker(0xc0, sof),
+    marker(0xc4, dht),
+    marker(0xda, sos),
+    scan,
+    Buffer.from([0xff, 0xd9]),
+  ]);
+}
+
+/** A solid colour with a soft diagonal gradient — what the fakes draw, and a self-check for the codecs. */
+export function paintBitmap(width: number, height: number, rgb: [number, number, number]): Bitmap {
+  const bgra = Buffer.alloc(width * height * 4);
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      const shade = 0.75 + 0.25 * ((x / Math.max(1, width - 1) + y / Math.max(1, height - 1)) / 2);
+      const o = (y * width + x) * 4;
+      bgra[o] = Math.round(rgb[2] * shade);
+      bgra[o + 1] = Math.round(rgb[1] * shade);
+      bgra[o + 2] = Math.round(rgb[0] * shade);
+      bgra[o + 3] = 255;
+    }
+  }
+  return { width, height, bgra };
+}
