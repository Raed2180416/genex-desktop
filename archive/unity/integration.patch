+      this.#note(command, result);
+      return { ok: true, result, status: response.status, ms: ms() };
+    }
+  }
+
+  /** What a command changed about the editor's mode, read off the command rather than a poll. */
+  #note(command: string, result: unknown): void {
+    if (command === "editor_play") {
+      this.playing = true;
+      this.paused = false;
+      this.#runtime = null;
+      this.#setState("playing");
+    } else if (command === "editor_stop") {
+      this.playing = false;
+      this.paused = false;
+      this.#runtime = null;
+      this.#setState(this.restarts > 0 ? "restarted" : "settled", "back in Edit Mode");
+    } else if (command === "editor_pause") {
