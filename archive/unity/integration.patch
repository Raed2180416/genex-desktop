+  const cli = status?.cli ?? null;
+  const account = status?.account ?? null;
+  const licence = status?.licence ?? null;
+  const editor = status?.editors[0] ?? null;
+  const kind = licence ? `${licence.kind.charAt(0).toUpperCase()}${licence.kind.slice(1)}` : "";
+  return {
+    cli: { line: cli ? `Unity CLI ${cli.version} found${cli.source === "studio" ? ` (${UNITY_WORDS.studioCopy})` : ""}` : UNITY_WORDS.cliMissing, done: cli !== null },
+    account: {
+      line: account ? `signed in as ${account.name ?? account.email ?? "you"}` : status?.accountChecked === false ? UNITY_WORDS.accountUnknown : UNITY_WORDS.notSignedIn,
+      // Done means the editor has a licence to run on: Hub's activation counts even while the
+      // CLI's own session is signed out; a signed-in CLI with an inactive licence is not done.
+      done: licence?.active === true || (account !== null && !(licence !== null && !licence.active)),
+      // A CLI that reports no licence at all does not block (spike S6), so the line only speaks when it knows.
+      licence: !cli || !licence ? null : licence.active ? `Unity ${kind}, active` : UNITY_WORDS.licenceNone,
+    },
