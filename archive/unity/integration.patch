+const bridgeDir = path.join(repo, "src/unity-bridge");
+
+/** The tree plan §4.7 names — every path must be there. */
+const TEMPLATE_TREE = [
+  "Assets/Scenes/Main.unity",
+  "Assets/Studio/StudioProbes.cs",
+  "Assets/Studio/StudioSpawn.cs",
+  "Assets/Studio/StudioTag.cs",
+  "Assets/Player/PlayerController.cs",
+  // One type from every built-in module and uGUI, so the template stops compiling the day a
+  // module leaves the manifest (the first real night, 2026-09-11, lost its car to a missing one).
+  "Assets/Studio/StudioModules.cs",
+  "Assets/Player/Player.inputactions",
+  "Assets/Settings/URP-Asset.asset",
+  "Assets/Settings/URP-Renderer.asset",
+  // What Unity 6000.6.0f1 wrote on the template's first open (2026-09-11), shipped so a fresh
+  // open leaves the tree clean: URP's global settings and default volume profile.
+  // The Input System settings the editor authored on 2026-09-11: input goes to the game view
