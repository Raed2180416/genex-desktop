+ * found" / "not on this Mac"; "signed in as Ada" / "not signed in", with the licence line under
+ * it; "Unity 6000.0.50f1 (Hub)" / "no Unity 6 editor".
+ */
+export function unityRowWords(status: UnityStatusLike | null): {
+  cli: { line: string; done: boolean };
+  account: { line: string; done: boolean; licence: string | null };
