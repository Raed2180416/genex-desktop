+          await sleep(backoff);
+          backoff = Math.min(2_000, backoff * 2);
+          continue;
+        }
+        const dialog = busyReason === "blocked_by_dialog" ? await this.dialog() : null;
+        const error = dialog ? `Unity is showing a dialog: ${dialog.title} — dismiss it or let the studio restart the editor` : `the editor is ${busyReason.replace(/_/g, " ")} (${Math.round(ms() / 1000)} s)`;
