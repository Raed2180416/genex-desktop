+        backoff = Math.min(2_000, backoff * 2);
+        continue;
+      }
+      const text = await response.text();
+      const body = parseJson(text);
+      if (response.status === 401) {
+        if (!reread && !runtime) {
+          reread = true;
+          const fresh = await this.#readDescriptor();
+          if (fresh && fresh.pid === this.#child?.pid) this.#descriptor = fresh;
+          continue;
+        }
+        if (runtime) this.#runtime = null;
+        return { ok: false, status: 401, error: "the editor refused the studio's token", ms: ms() };
+      }
+      if (response.status === 503) {
+        const busyReason = String(body?.busyReason ?? body?.reason ?? "busy");
