+/**
+ * The front door for a Unity game (plan D3, both entry points): "make me something in Unity" in
+ * the chat the user already has, or the composer's Unity switch. The studio's keychain-free
+ * Unity status decides whether a Unity game can be made; the coordinator hears it as one line;
+ * the two creating tools (new_game, start_autopilot) and the delegated chat's own folder take
+ * the Unity template — and where Unity is not ready, nothing is built and the user is told.
+ */
+import assert from "node:assert/strict";
+import { mkdir, readFile, realpath } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, it } from "node:test";
+import { asksForUnity, coordinatorUnityLine, otherEngineUnityLine, unityAvailability, unityOnMac, unityReadyToMake } from "../../src/harness-seed/loop/unity.mjs";
+import { asksForUnityText } from "../../src/substrate/unity.ts";
+import { fakeUnityCli, fakeUnityProbe } from "../helpers/fake-unity-cli.ts";
+import { fakeUnityEditorBinary } from "../helpers/fake-unity-editor.ts";
+import type { FakeReply } from "../helpers/fake-ollama.ts";
+import { customEvents, startRig, waitForLog, type Rig } from "../helpers/studio-rig.ts";
+
+const rigs: Rig[] = [];
+afterEach(async () => {
+  while (rigs.length) await rigs.pop()!.stop();
+});
+
+/** A rig on which Unity is ready: a fake CLI on the PATH seam naming a fake editor, signed in, licensed. */
+async function unityRig(replies: FakeReply[]): Promise<Rig> {
+  const dir = path.join(os.tmpdir(), `unity-front-door-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`);
+  await mkdir(dir, { recursive: true });
+  const editorBinary = await fakeUnityEditorBinary(path.join(dir, "Unity"));
+  const options = { version: "1.0.0", editors: [{ version: "6000.0.50f1", path: editorBinary }], signedIn: { name: "Fixture", email: "fixture@example.com" }, licence: { kind: "personal", active: true } };
+  const cli = await fakeUnityCli(path.join(dir, "cli"), options);
+  const real = await realpath(cli.binary);
+  const rig = await startRig({ replies }, { unity: { probe: fakeUnityProbe(real, options), pathEnv: path.dirname(real), settleMs: 20_000, pollMs: 50, watchMs: 500, waitMs: 5_000, killGraceMs: 2_000 } } as never);
+  rigs.push(rig);
+  await rig.core.unityStatus(true);
+  assert.equal((await rig.core.unityStatus()).code, "ready");
+  return rig;
+}
+
+/** Everything the fake model was sent, as one string per request — the system prompt is in there. */
+function promptsSent(rig: Rig): string[] {
+  return rig.server.requests.filter((r) => r.path.startsWith("/v1/chat/completions")).map((r) => JSON.stringify(r.body));
+}
+
+async function turnEnded(rig: Rig) {
+  return waitForLog(rig.core, (log) => log.some((e) => e.data.type === "turn_ended"), 30_000, "turn_ended");
+}
+
+function toolResults(events: Array<{ data: { type: string; result?: { content?: string } } }>): string[] {
+  return events.filter((e) => e.data.type === "tool_result").map((e) => String(e.data.result?.content ?? ""));
+}
+
+describe("the front door: a new game in Unity", () => {
+  it("the words: the sentence or the switch asks for Unity; the studio's status says whether it can be made", () => {
+    assert.equal(asksForUnity("make me something in Unity"), true);
+    assert.equal(asksForUnity("a marsh with a sun"), false);
+    assert.equal(asksForUnity("a Unity game, not three.js"), false, "naming three.js keeps three.js");
+    assert.equal(asksForUnity("a marsh", "unity"), true, "the switch wins");
+    assert.equal(asksForUnity("make it in Unity", "three"), false, "the switch wins the other way too");
+    for (const text of ["Create a drift racing game in Unity", "a marsh", "a Unity game, not three.js", "UNITY please"]) assert.equal(asksForUnityText(text), asksForUnity(text), `the studio and the seed agree on "${text}"`);
+    const ready = { enabled: true, code: "ready", editors: [{ version: "6000.6.0f1" }] };
+    assert.equal(unityReadyToMake(ready), true);
+    assert.equal(unityReadyToMake({ ...ready, editors: [] }), false);
+    assert.equal(unityReadyToMake({ ...ready, enabled: false }), false);
+    assert.equal(unityReadyToMake(null), false);
+    assert.match(coordinatorUnityLine(ready), /^UNITY: available \(6000\.6\.0f1\)\. When the user asks for a Unity game, make it in Unity: new_game with engine "unity"/);
+    assert.match(coordinatorUnityLine(ready, "unity"), /^UNITY: the user asked for this game in Unity \(the composer's switch or their own words\)\. Make it in Unity 6000\.6\.0f1/);
+    assert.match(coordinatorUnityLine({ enabled: true, code: "no_cli", detail: "the Unity command line is not on this Mac" }), /^UNITY: the Unity command line is not on this Mac\. Games are three\.js; if the user asks for Unity, say it is not set up/);
+    assert.match(coordinatorUnityLine({ enabled: false, code: "off" }, "unity"), /asked for this game in Unity .*, but Unity is switched off on the Unity page\. Say so/);
+    assert.match(coordinatorUnityLine(null), /^UNITY: not set up on this Mac\./);
+    // A folder that is not a Unity project: a run never changes engines, and where Unity waits.
+    assert.equal(unityOnMac(ready), "6000.6.0f1");
+    assert.equal(unityOnMac({ ...ready, code: "no_cli" }), null);
+    assert.match(otherEngineUnityLine("racing", "6000.6.0f1"), /^UNITY: not here — "racing" is not a Unity project, and a folder never changes engines \(a run on it cannot switch\)\. Unity 6000\.6\.0f1 is on this Mac: to build in Unity, the user starts a new game .* never that Unity was not detected\.$/);
+    assert.match(otherEngineUnityLine("racing", null), /Unity is not set up on this Mac \(the Unity page, model menu → Unity\)\./);
+    assert.equal(otherEngineUnityLine("racing", false), "", "Unity switched off: not a word");
+    assert.equal(unityAvailability({ ...ready, enabled: false }), false);
+    assert.equal(unityAvailability(ready), "6000.6.0f1");
+    assert.equal(unityAvailability({ enabled: true, code: "no_cli" }), null);
+  });
+
+  it("chat on a three.js folder: 'are you building with Unity?' is answered from the studio's facts, never from a null", async () => {
+    const rig = await unityRig([{ text: "No — this folder is three.js; start a new game with the Unity switch for that." }]);
+    await rig.core.games.scaffold("racing", { title: "Racing" });
+    const threadId = await rig.core.createGameThread("racing");
+    await rig.core.sendUserMessage("sorry, u are building with unity? lets build with it", { thread: threadId });
+    await turnEnded(rig);
+    assert.match(promptsSent(rig)[0]!, /UNITY: not here — \\"racing\\" is not a Unity project, and a folder never changes engines .* Unity 6000\.0\.50f1 is on this Mac: to build in Unity, the user starts a new game/);
+    assert.equal((await rig.core.games.list()).find((g) => g.name === "racing")?.shape?.kind !== "unity-project", true, "the folder stayed what it was");
+  });
+
+  it("chat: 'make me something in Unity' makes the Unity template, stamped with the installed editor, in the chat it was asked in", async () => {
+    const rig = await unityRig([
+      { toolCalls: [{ id: "c1", name: "new_game", arguments: { name: "marsh", title: "Marsh", engine: "unity" } }] },
+      { text: "Made the marsh in Unity." },
+    ]);
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("make me a marsh in Unity", { thread: threadId });
+    const log = await turnEnded(rig);
+
+    const game = (await rig.core.games.list()).find((g) => g.name === "marsh");
+    assert.ok(game, "the folder exists");
+    assert.equal(game.shape?.kind, "unity-project");
+    assert.match(await readFile(path.join(game.dir, "ProjectSettings", "ProjectVersion.txt"), "utf8"), /m_EditorVersion: 6000\.0\.50f1/, "stamped with the installed editor, never the pin alone");
+    assert.match(toolResults(log as never)[0]!, /^Created marsh in Unity 6000\.0\.50f1 at .*the studio's Unity template/);
+    assert.equal(((await rig.core.store.getRecord(threadId)).metadata as { project?: string }).project, "marsh", "the chat is the game's now");
+    // The coordinator heard, in its system prompt, that the words asked for Unity and how to make it.
+    assert.match(promptsSent(rig)[0]!, /UNITY: the user asked for this game in Unity \(the composer's switch or their own words\)\. Make it in Unity 6000\.0\.50f1: new_game with engine \\"unity\\"/);
+  });
+
+  it("chat: the composer's switch is heard as an order, and the tool follows it without an engine argument", async () => {
+    const rig = await unityRig([
+      { toolCalls: [{ id: "c1", name: "new_game", arguments: { name: "bog", title: "Bog" } }] },
+      { text: "Made the bog." },
+    ]);
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("a bog at dusk", { thread: threadId, gameEngine: "unity" });
+    await turnEnded(rig);
+    assert.equal((await rig.core.games.list()).find((g) => g.name === "bog")?.shape?.kind, "unity-project", "the switch picked the template");
+    assert.match(promptsSent(rig)[0]!, /UNITY: the user asked for this game in Unity .*\. Make it in Unity 6000\.0\.50f1/);
+  });
+
+  it("chat: the words 'in Unity' in the first message set the choice for the whole chat, so the interview's later answers keep it", async () => {
+    const rig = await unityRig([
+      { text: "What should the drift feel like?" },
+      { toolCalls: [{ id: "c1", name: "new_game", arguments: { name: "drift", title: "Drift" } }] },
+      { text: "Made the drift game in Unity." },
+    ]);
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("Create a drift racing game in Unity", { thread: threadId });
+    await turnEnded(rig);
+    assert.equal(((await rig.core.store.getRecord(threadId)).metadata as { gameEngine?: string }).gameEngine, "unity", "remembered on the chat");
+    assert.match(promptsSent(rig)[0]!, /UNITY: the user asked for this game in Unity/);
+    await rig.core.sendUserMessage("like Initial D", { thread: threadId });
+    await waitForLog(rig.core, (log) => log.filter((e) => e.data.type === "turn_ended").length === 2, 30_000, "second turn");
+    assert.equal((await rig.core.games.list()).find((g) => g.name === "drift")?.shape?.kind, "unity-project", "the second message, with no Unity word, still made a Unity project");
+  });
+
+  it("chat: without Unity on this Mac nothing is created, the tool says why, and the coordinator was told beforehand", async () => {
+    const rig = await startRig({
+      replies: [
+        { toolCalls: [{ id: "c1", name: "new_game", arguments: { name: "marsh", engine: "unity" } }] },
+        { text: "Unity is not set up here." },
+      ],
+    });
+    rigs.push(rig);
+    assert.equal((await rig.core.unityStatus()).code, "no_cli", "a rig detects in isolation: no Unity");
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("make me a marsh in Unity", { thread: threadId, gameEngine: "unity" });
+    const log = await turnEnded(rig);
+    assert.equal((await rig.core.games.list()).some((g) => g.name === "marsh"), false, "no folder");
+    assert.match(toolResults(log as never)[0]!, /^Unity is the Unity command line is not on this Mac: a Unity game cannot be made until it is set up on the Unity page/);
+    assert.match(promptsSent(rig)[0]!, /UNITY: the user asked for this game in Unity .*, but Unity is the Unity command line is not on this Mac\. Say so in one sentence and make nothing/);
+  });
+
+  it("overnight: the interview's launch makes the Unity template for a chat with no folder, and the night records the editor", async () => {
+    const rig = await unityRig([
+      { toolCalls: [{ id: "c2", name: "start_autopilot", arguments: { goal: "a marsh with a sun", direction: "quiet marsh", project: "marshnight" } }], text: "Starting the night." },
+    ]);
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("a marsh with a sun", { thread: threadId, autopilot: { hours: 1 }, gameEngine: "unity" });
+    // A local model's night is the unattended loop; its first Unity validation is the proof the
+    // night knows what folder it is in (a facet night would say so on run_started.unity too).
+    const log = await waitForLog(rig.core, (es) => customEvents(es, "unity_validation").length >= 1, 90_000, "the night's first Unity validation");
+    const started = customEvents(log, "run_started")[0] as { runId: string; project: string };
+    assert.equal(started.project, "marshnight");
+    assert.equal((customEvents(log, "unity_validation")[0] as { editorVersion?: string }).editorVersion, "6000.0.50f1", "the night validates in the installed editor");
+    assert.equal((await rig.core.games.list()).find((g) => g.name === "marshnight")?.shape?.kind, "unity-project");
+    await rig.core.host.dispatch({ type: "run_stop", runId: started.runId }, 10_000).catch(() => {});
+  });
+
+  it("overnight: the interviewer's own word 'engine: unity' does the same, and without Unity the launch is refused in the chat", async () => {
+    const rig = await startRig({
+      replies: [{ toolCalls: [{ id: "c2", name: "start_autopilot", arguments: { goal: "a marsh with a sun", direction: "quiet marsh", project: "marshnight", engine: "unity" } }], text: "Starting the night." }],
+    });
+    rigs.push(rig);
+    const threadId = await rig.core.createGameThread();
+    await rig.core.sendUserMessage("a marsh with a sun in Unity", { thread: threadId, autopilot: { hours: 1 } });
+    const log = await waitForLog(rig.core, (es) => es.some((e) => JSON.stringify(e.data).includes("set it up on the Unity page")), 30_000, "the refusal in the chat");
+    assert.equal(customEvents(log, "run_started").length, 0, "no night started");
+    assert.equal((await rig.core.games.list()).some((g) => g.name === "marshnight"), false, "no folder either");
+  });
+});
