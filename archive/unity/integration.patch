+  async evaluate(_expression: string): Promise<unknown> {
+    return { ...UNITY_UNAVAILABLE };
+  }
+
+  async studioState(): Promise<unknown> {
+    const state = await this.#exec("studio_state", {}, 10_000);
+    if (!state.ok) return { __missing: true, ...(state.error ? { reason: state.error } : {}) };
+    const r = record(state.result);
+    if (r && typeof r.frame === "number") this.#lastFrame = r.frame;
